#!/usr/bin/env php
<?php
/**
 * Loghound — interactive setup wizard (SPEC §8, §9).
 *
 * Walks an operator from a fresh checkout to a working config in one pass:
 *
 *   1. Check the prerequisites — PHP version, the extensions the application actually uses,
 *      the directories it writes, open_basedir, the log files it means to read — and print
 *      the exact command for anything that is wrong. These are the same rows the browser
 *      installer's system-check page shows, from the same Setup\Requirements, and a failing
 *      one stops the wizard there rather than three steps later as a stack trace.
 *   2. Detect webserver configs and log files, show the detected field mapping with
 *      real parsed sample lines and a confidence percentage, and REQUIRE confirmation.
 *      Nothing is ever ingested with a silently guessed format.
 *   3. Settle the two indexes on Opensolr: email + API key, then either JOIN a pair the
 *      account already holds or create a new one — whichever, after saying how many indexes
 *      the plan has room for. Nothing is created that there is not room for.
 *   4. Generate the beacon HMAC secret and the IP hashing salt with random_bytes().
 *   5. Set up panel authentication (password stored as a password_hash, never plaintext).
 *   6. Write config/loghound.php at mode 0640 through Config::save().
 *
 * IT STOPS WHERE IT FAILS. A storage step that cannot finish ends the run at step 3 with the
 * one thing to go and fix, having saved the answers already given. It does not collect a
 * password and a panel URL first and then refuse to write anything, which is what it used to
 * do with a mistyped API key.
 *
 * IT DOES NOT ASK HOW TO STORE A VISITOR'S ADDRESS OR HOW LONG TO KEEP HITS. Those two
 * settings keep the defaults in Config::defaults() — the full address, 90 days — and are
 * changed on the panel's Settings page. LOGHOUND_IP_MODE and LOGHOUND_RETENTION_DAYS are
 * still honoured, so an unattended install can set them; there is no prompt behind either.
 *
 * IDEMPOTENT AND RE-RUNNABLE. Every prompt offers the current value as its default, an
 * existing secret is kept unless you ask for a new one, and an index that already exists
 * is verified rather than recreated. Running it a second time to change one setting is a
 * supported workflow, not a recovery procedure.
 *
 * THE API KEY IS NEVER PRINTED, NEVER ECHOED WHILE TYPED, AND NEVER LOGGED.
 *
 * THIS IS ONE OF TWO FRONT ENDS. The other is the browser installer (src/Setup/Installer),
 * and the two must not drift: every decision about what setup MEANS — which files are
 * candidates, how a format is graded, how indexes are provisioned, what a valid password
 * is, what the next steps are — lives in src/Setup/ and is called from both. What is left
 * here is prompting and printing.
 *
 * Usage
 *   loghound-setup                    the full wizard
 *   loghound-setup --detect-only      run detection, print the result, change nothing
 *   loghound-setup --beacon-doc       print the beacon reference as plain text and stop
 *   loghound-setup --base-url=URL     the address the beacon reference builds its snippet from
 *   loghound-setup --non-interactive  answer every prompt from the environment
 *   loghound-setup --config=PATH      write somewhere other than config/loghound.php
 *   loghound-setup --no-color
 *
 * `--beacon-doc` exists because install.sh is a shell script and cannot read a PHP array. Its
 * closing report calls this instead of carrying a copy of the beacon reference, which is how
 * the snippet came to say `?v=1` in one place and a real version in another. It writes the
 * reference to stdout, prompts for nothing and changes nothing, so it is also the fastest way
 * to reread the option list on a box with no browser open.
 *
 * ENVIRONMENT OVERRIDES. Every prompt can be pre-answered by an environment variable,
 * which is what lets install.sh --non-interactive run the whole thing from Ansible or CI.
 * A variable is honoured whether or not the wizard is interactive, so you can pre-seed
 * one awkward answer and still be asked the rest.
 *
 *   LOGHOUND_NONINTERACTIVE=1      same as --non-interactive
 *   LOGHOUND_LOG_PATH              access log path, when detection finds nothing
 *   LOGHOUND_CONFIRM_SOURCES       yes|no — accept the detected sources
 *   LOGHOUND_ALLOW_LOG_ROOTS       yes|no — widen allowed_log_roots when needed
 *   LOGHOUND_OPENSOLR_EMAIL        Opensolr account email
 *   LOGHOUND_OPENSOLR_API_KEY      Opensolr API key (never echoed, never logged)
 *   LOGHOUND_OPENSOLR_REGION       Opensolr region, for indexes this run CREATES
 *   LOGHOUND_OPENSOLR_REUSE        new|<install id> — join a pair of Loghound indexes the
 *                                  account already holds rather than creating two. Defaults
 *                                  to new, because an unattended re-run must never adopt
 *                                  another site's indexes just because it found some.
 *   LOGHOUND_OPENSOLR_UPGRADE_SCHEMA
 *                                  yes|no — when reusing, add the fields this version writes
 *                                  to indexes an older Loghound made. Defaults to no, which
 *                                  checks the shape and stops on a mismatch instead.
 *   LOGHOUND_RECONFIGURE_STORAGE   yes|no — re-run provisioning on an install that already
 *                                  has both indexes; defaults to no
 *   LOGHOUND_IP_MODE               full|truncate|hash — no prompt asks this; set it here or
 *                                  change it in Settings. Default: full
 *   LOGHOUND_RETENTION_DAYS        integer, 0 = never delete — no prompt asks this either.
 *                                  Default: 90
 *   LOGHOUND_RESET_PANEL_AUTH      yes|no — replace existing panel credentials
 *   LOGHOUND_PANEL_USER            panel username
 *   LOGHOUND_PANEL_PASSWORD        panel password (never echoed; hashed immediately)
 *   LOGHOUND_AUTH_MODE             basic|session — how you sign in to the panel
 *   LOGHOUND_BASE_URL              public URL of the panel, for the beacon snippet
 *   LOGHOUND_ROTATE_BEACON_SECRET  yes|no
 *   LOGHOUND_FORCE_WRITE           yes|no — write even a config that fails validation
 *
 * ONE PAIR OF INDEXES CAN SERVE MANY SITES. Every record Loghound writes carries the virtual
 * host it came from, so several installations reporting into one pair stay separable in the
 * panel by its Virtual host dimension — and on a plan with a small index limit, reuse is how
 * the third site gets set up at all. Reusing JOINS: nothing in the indexes is cleared,
 * reshaped or overwritten, and a schema older than this version writes stops the run unless
 * the operator agreed to the upgrade.
 *
 * THE TWO INDEX NAMES ARE GENERATED, NEVER ASKED FOR, and there is no variable that can
 * supply them. An Opensolr index name is unique across the whole platform and permanent once
 * created, so a name an operator picks is a name that will eventually collide with somebody
 * else's; Config::coreName() builds one from a random per-installation id instead.
 *
 * THERE IS NO "POINT IT AT MY OWN SOLR" ANSWER. Loghound does not merely read and write its
 * two indexes, it owns them: it creates them, uploads the configsets under solr/hits/conf and
 * solr/sessions/conf, reloads the cores and verifies them. None of that is possible on a Solr
 * it does not administer, so offering the option promised something the product could not
 * deliver. An Opensolr account is a hard requirement.
 *
 * Non-interactive mode answers every prompt from a LOGHOUND_* environment variable or from
 * the offered default. install.sh --non-interactive uses it so the whole install can run
 * from Ansible or a CI job with no terminal attached, and it is switched on automatically
 * when stdin is not a terminal — a wizard that blocks forever on a closed stdin is the worst
 * possible failure mode inside an automated deploy. `--interactive` forces prompting even
 * when stdin does not look like a terminal.
 *
 * `--detect-only` shows exactly what the wizard would ask about and then stops. It is useful
 * for checking a box before committing to a setup run, and for debugging a format that will
 * not match without having to answer six prompts first.
 *
 * Confirmation of the detected sources is mandatory, per SPEC §8: "Never silently ingest
 * with a guessed format."
 *
 * @package Loghound
 * @license MIT
 */

declare(strict_types=1);

namespace Loghound\Bin;

use Loghound\Beacon\Doc;
use Loghound\Config;
use Loghound\Setup\Detector;
use Loghound\Setup\Job;
use Loghound\Setup\Pairs;
use Loghound\Setup\Requirements;
use Loghound\Setup\Reset;
use Loghound\Setup\Steps;
use Loghound\Setup\Storage;

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

$ROOT = dirname(__DIR__);
require_once $ROOT . '/src/autoload.php';

$configPath = $ROOT . '/config/loghound.php';
$detectOnly = false;
$doReset    = false;
$beaconDoc  = false;
$beaconBase = '';
$useColor   = function_exists('posix_isatty') && @posix_isatty(STDOUT) && getenv('NO_COLOR') === false;

$nonInteractive = getenv('LOGHOUND_NONINTERACTIVE') === '1'
    || !(function_exists('posix_isatty') && @posix_isatty(STDIN));

foreach (array_slice($argv, 1) as $a) {
    if (str_starts_with($a, '--config=')) {
        $configPath = substr($a, 9);
    } elseif ($a === '--detect-only') {
        $detectOnly = true;
    } elseif ($a === '--beacon-doc') {
        $beaconDoc = true;
    } elseif (str_starts_with($a, '--base-url=')) {
        $beaconBase = substr($a, 11);
    } elseif ($a === '--reset') {
        $doReset = true;
    } elseif ($a === '--no-color') {
        $useColor = false;
    } elseif ($a === '--non-interactive') {
        $nonInteractive = true;
    } elseif ($a === '--interactive') {
        $nonInteractive = false;
    } elseif ($a === '--help' || $a === '-h') {
        usage();
        exit(0);
    } else {
        fwrite(STDERR, "loghound-setup: unknown option '$a'\n");
        exit(2);
    }
}

$UI = new Ui($useColor, $nonInteractive);

$cfg = Config::load($configPath);
$isFirstRun = !is_file($configPath);

if ($beaconDoc) {
    echo Doc::renderText($cfg, $beaconBase !== '' ? $beaconBase : (string) $cfg->get('base_url', '')), "\n";
    exit(0);
}

$UI->banner('Loghound setup');
if (!$isFirstRun) {
    $UI->info('Existing configuration found at ' . $configPath . '. Every prompt below');
    $UI->info('defaults to the current value — press Enter to keep it.');
    $UI->nl();
}

if ($doReset && !performReset($cfg, $UI)) {
    exit(1);
}

$UI->step(1, 'Checking this server has what Loghound needs');

if (!checkRequirements($cfg, $UI, $ROOT) && !$detectOnly) {
    exit(1);
}

$UI->nl();
$UI->step(2, 'Finding your access logs');

$report = Detector::runSync($cfg, static function (string $line) use ($UI): void {
    $UI->info('    ' . $line);
});
$detected = (array) ($report['sources'] ?? []);

if ($detectOnly) {
    foreach ($detected as $d) {
        $UI->nl();
        presentSource((array) $d, $UI);
    }
    $UI->nl();
    $UI->info('--detect-only: ' . count($detected) . ' source(s) found, nothing was written.');
    exit($detected === [] ? 1 : 0);
}

if ($detected === []) {
    $UI->warn('No readable access log could be detected.');
    $UI->info('You can point Loghound at a file by hand.');
    $manual = $UI->ask('Path to an access log (blank to skip)', '', 'LOGHOUND_LOG_PATH');
    if ($manual !== '') {
        $added = addManualSource($cfg, $UI, $manual);
        if ($added !== null) {
            $detected = [$added];
        }
    }
}

$chosen = [];
$widen  = [];
foreach ($detected as $d) {
    $d = (array) $d;
    $UI->nl();
    presentSource($d, $UI);

    if (!$UI->confirm('Ingest this file with this format?', true, 'LOGHOUND_CONFIRM_SOURCES')) {
        $UI->info('Skipped ' . (string) $d['path']);
        continue;
    }

    if (!empty($d['outside_roots'])) {
        $dir = dirname((string) $d['path']);
        $UI->warn($dir . ' is outside allowed_log_roots.');
        if (!$UI->confirm('Allow Loghound to read log files under ' . $dir . '?', true, 'LOGHOUND_ALLOW_LOG_ROOTS')) {
            $UI->info('Skipped ' . (string) $d['path']);
            continue;
        }
        $widen[] = $dir;
    }

    $chosen[] = $d;
}

if ($chosen === []) {
    $UI->warn('No log sources confirmed. Loghound will have nothing to ingest.');
    if (!$UI->confirm('Carry on anyway?', false, 'LOGHOUND_CONFIRM_SOURCES')) {
        exit(1);
    }
}

foreach (Steps::applySources($cfg, $chosen, $widen) as $problem) {
    $UI->err($problem);
}

$UI->nl();
$UI->step(3, 'Your two indexes on Opensolr');

if (!configureOpensolr($cfg, $UI, $ROOT)) {
    $UI->nl();
    if (saveProgress($cfg, $configPath)) {
        $UI->ok('Your answers so far are saved in ' . $configPath . '.');
        $UI->info('Nothing is ingested and no index is created until storage is sorted out.');
    }
    $UI->info('Pick up where you left off with exactly this command:');
    $UI->info('  ' . PHP_BINARY . ' ' . $ROOT . '/bin/loghound-setup --config=' . $configPath);
    exit(1);
}

$UI->nl();
$UI->step(4, 'Secrets');

foreach (Steps::ensureSecrets($cfg) as $made) {
    $UI->ok('Generated a new ' . $made . '.');
}

if (strlen((string) $cfg->get('beacon.secret', '')) >= 32) {
    $UI->ok('Beacon HMAC secret is set.');
    if ($UI->confirm('Rotate it? (every issued beacon token becomes invalid)', false, 'LOGHOUND_ROTATE_BEACON_SECRET')) {
        $cfg->set('beacon.secret', bin2hex(random_bytes(32)));
        $UI->ok('Beacon secret rotated.');
    }
}

applyPrivacyEnvironment($cfg, $UI);

$UI->nl();
$UI->step(5, 'Panel access');

$UI->info('The panel shows every visitor, path and IP on your site. It is never');
$UI->info('served without authentication — an open analytics dashboard is a breach.');

$authMode = (string) $cfg->get('auth.mode', 'none');
$haveHash = (string) $cfg->get('auth.password_hash', '') !== '';

if ($haveHash && $authMode !== 'none') {
    $UI->ok('Panel user "' . (string) $cfg->get('auth.user') . '" is already configured.');
    $changeAuth = $UI->confirm('Set a new username/password?', false, 'LOGHOUND_RESET_PANEL_AUTH');
} else {
    $changeAuth = true;
}

if ($changeAuth) {
    setPanelAccount($cfg, $UI);
}

$baseUrl = trim($UI->ask(
    'Public URL of this panel (used in the beacon snippet, blank to skip)',
    (string) $cfg->get('base_url', ''),
    'LOGHOUND_BASE_URL'
));
foreach (Steps::applyBaseUrl($cfg, $baseUrl) as $problem) {
    $UI->warn($problem);
}

$UI->nl();
$UI->step(6, 'Writing the configuration');

$errors = $cfg->validate();
if ($errors !== []) {
    $UI->warn('The configuration is not yet valid:');
    foreach ($errors as $e) {
        $UI->warn('  - ' . $e);
    }
    if (!$UI->confirm('Write it anyway? (the daemons will refuse to start)', false, 'LOGHOUND_FORCE_WRITE')) {
        $UI->info('Nothing was written.');
        exit(1);
    }
}

$dir = dirname($configPath);
if (!is_dir($dir) && !@mkdir($dir, 0750, true) && !is_dir($dir)) {
    $UI->err('Cannot create ' . $dir);
    exit(1);
}

try {
    $cfg->save();
} catch (\Throwable $e) {
    $UI->err('Could not write the config: ' . $e->getMessage());
    exit(1);
}

$UI->ok('Wrote ' . $configPath . ' (mode 0640).');
$UI->nl();

$UI->banner('Next steps');

$n = 0;
foreach (Steps::nextSteps($cfg, $ROOT) as $group) {
    $n++;
    $UI->info($n . '. ' . $group['title'] . ':');
    if ((string) $group['problem'] !== '') {
        $UI->raw(wordwrap('     ' . $group['problem'], 76, "\n     "));
        continue;
    }
    foreach ($group['lines'] as $line) {
        $UI->raw('     ' . $line);
    }
}

$UI->nl();
$UI->raw(Doc::renderText($cfg, (string) $cfg->get('base_url', '')));
$UI->nl();
$UI->info('See docs/BEACON.md for the long form, and docs/DETECTION.md for what each rule');
$UI->info('fires on. This reference is also on the panel under Settings → Beacon, and');
$UI->info('`loghound-setup --beacon-doc` prints it again at any time.');
$UI->nl();

exit(0);

/**
 * Put this installation back to the beginning of setup, then carry on into it.
 *
 * THE SHELL HALF OF THE PANEL'S REINSTALL BUTTON, and deliberately the same work: both call
 * Setup\Reset::perform() and both print Setup\Reset::consequences(), so an operator who reads
 * one and acts on the other is not surprised. What differs is only the proof of who is asking —
 * the panel wants a signed-in session and a current second factor, and a terminal on the machine
 * is already the stronger of the two.
 *
 * It asks, even non-interactively, where "asks" means the confirmation defaults to NO. An
 * unattended run that trips over this flag must not wipe a working installation because nobody
 * was there to say no; LOGHOUND_CONFIRM_RESET=yes is the deliberate answer.
 *
 * @return bool False when nothing was reset and the run should stop.
 */
function performReset(Config $cfg, Ui $UI): bool
{
    $UI->banner('Start the installation over');
    $UI->info('This resets this machine and walks you back through setup. It does not delete');
    $UI->info('your data.');
    $UI->nl();

    foreach (Reset::consequences() as $row) {
        $UI->raw('  ' . $UI->bold($row['what']));
        $UI->raw(wordwrap('      ' . $row['happens'], 76, "\n      "));
        $UI->nl();
    }

    if (!$UI->confirm('Reset this installation now?', false, 'LOGHOUND_CONFIRM_RESET')) {
        $UI->info('Nothing was reset.');
        return false;
    }

    $result = Reset::perform($cfg);
    if (!$result['ok']) {
        $UI->err('The configuration could not be written, so nothing was reset: ' . $result['error']);
        return false;
    }

    $UI->ok('Reset. Setup starts below; your indexes and their contents are untouched.');
    if ($result['removed'] !== []) {
        $UI->info('Removed from var/: ' . implode(', ', $result['removed']) . '.');
    }
    $UI->nl();

    return true;
}

/**
 * Print the whole of what this command accepts, options and environment both.
 *
 * install.sh's own help sends people here for "the full list" of environment variables, so
 * this has to BE the full list. It used to print one usage line, which made that pointer the
 * same failure as a command that cannot run: the operator followed the instruction and got
 * nothing, and had to go and read the source instead.
 */
function usage(): void
{
    fwrite(STDOUT, <<<'TEXT'

loghound-setup — configure Loghound, from a terminal.

  loghound-setup [options]

Options
  --detect-only         find the access logs, print what would be asked, change nothing
  --beacon-doc          print the beacon reference — the snippet, every option it reads, what
                        this installation stores, and the two CSP directives — then stop
  --base-url=URL        the address --beacon-doc builds its snippet from, when the
                        configuration has no base_url yet
  --reset               start the installation over: forget the log sources, the index names
                        and the sign-in, then run setup. Your Opensolr indexes and everything
                        in them are NOT touched, and neither are your log files. This is the
                        same thing the panel's Reinstall button does. To remove Loghound
                        entirely instead, use install/uninstall.sh.
  --non-interactive     answer every prompt from the environment or the offered default
  --interactive         prompt even when stdin does not look like a terminal
  --config=PATH         write somewhere other than config/loghound.php
  --no-color            plain output (NO_COLOR is honoured too)
  -h, --help

Environment overrides
  Every prompt can be pre-answered, whether or not the wizard is interactive, so one
  awkward answer can be seeded and the rest still asked.

  LOGHOUND_NONINTERACTIVE=1          same as --non-interactive
  LOGHOUND_CONFIRM_RESET             yes|no — answer the --reset confirmation. Default: no,
                                     so an unattended run cannot wipe a working installation
                                     by tripping over the flag.

  Log sources
  LOGHOUND_LOG_PATH                  access log path, when detection finds nothing
  LOGHOUND_CONFIRM_SOURCES           yes|no — accept the detected sources
  LOGHOUND_ALLOW_LOG_ROOTS           yes|no — allow a log directory outside allowed_log_roots

  Your Opensolr account
  LOGHOUND_OPENSOLR_EMAIL            account email
  LOGHOUND_OPENSOLR_API_KEY          API key (never echoed, never logged, never printed back)
  LOGHOUND_OPENSOLR_REGION           region for NEW indexes
  LOGHOUND_OPENSOLR_REUSE            new|<install id> — join a pair of Loghound indexes the
                                     account already holds instead of creating two. Default:
                                     new. One pair can serve several sites; they are told
                                     apart by the hostname on every record.
  LOGHOUND_OPENSOLR_UPGRADE_SCHEMA   yes|no — when reusing, add the fields this version
                                     writes if the indexes were made by an older Loghound.
                                     Default: no, which checks and stops instead.
  LOGHOUND_RECONFIGURE_STORAGE       yes|no — re-run storage on an install that already has
                                     both indexes. Default: no

  Privacy — no prompt asks either; they are changed in Settings
  LOGHOUND_IP_MODE                   full|truncate|hash. Default: full
  LOGHOUND_RETENTION_DAYS            integer, 0 = never delete. Default: 90

  Signing in
  LOGHOUND_RESET_PANEL_AUTH          yes|no — replace existing panel credentials
  LOGHOUND_PANEL_USER                panel username
  LOGHOUND_PANEL_PASSWORD            panel password (never echoed; hashed immediately)
  LOGHOUND_AUTH_MODE                 basic|session
  LOGHOUND_BASE_URL                  public URL of the panel, for the beacon snippet
  LOGHOUND_ROTATE_BEACON_SECRET      yes|no — invalidates every issued beacon token
  LOGHOUND_FORCE_WRITE               yes|no — write even a config that fails validation

The two index names are generated and cannot be supplied: an Opensolr index name is unique
across the whole platform and permanent once created.

TEXT);
}

/**
 * Take a log file path the operator typed, asking for the one permission it may need.
 *
 * THIS IS THE ESCAPE HATCH THE BROWSER INSTALLER PROMISES. A path outside
 * `allowed_log_roots` is refused there and always will be — that list is what stops the
 * log-path setting from becoming an arbitrary-file-read, and a form post is not proof of
 * anything. Its refusal points at this wizard, and until now this wizard called the same
 * refusal and printed the same sentence: the only instruction on the screen sent the operator
 * in a circle.
 *
 * What it can honestly do is ASK, here, at a terminal on the machine. That is the same consent
 * it already collects for a DETECTED file that sits outside the list, so the two paths are now
 * the same question with the same default and the same variable behind it.
 *
 * The directory is widened before the file is examined, because the examination itself has to
 * read the file. Nothing is widened without a yes, and nothing above the file's own directory
 * is ever widened.
 *
 * @return array<string,mixed>|null The source entry, or null when it could not be taken.
 */
function addManualSource(Config $cfg, Ui $UI, string $path): ?array
{
    $roots = (array) $cfg->get('allowed_log_roots', []);

    if (@is_file($path) && \Loghound\Security::safePath($path, $roots) === null) {
        $dir = dirname($path);
        $UI->warn($dir . ' is not one of the directories Loghound may read ('
            . implode(', ', $roots) . ').');

        if (!$UI->confirm('Allow Loghound to read log files under ' . $dir . '?', true, 'LOGHOUND_ALLOW_LOG_ROOTS')) {
            $UI->info('Left as it was. ' . $path . ' will not be read.');
            return null;
        }

        $problem = Steps::allowLogRoot($cfg, $dir);
        if ($problem !== null) {
            $UI->err($problem);
            return null;
        }
        $UI->ok('Added ' . $dir . ' to allowed_log_roots.');
    }

    $added = Detector::manualSource($cfg, $path, 'apache_combined', '');
    if ($added['ok']) {
        return $added['source'];
    }

    $UI->err($added['error']);
    return null;
}

/**
 * Write the part-finished configuration, so an abandoned run loses nothing.
 *
 * Called only when the wizard is giving up part way through. It is deliberately not the same
 * thing as finishing: the configuration it writes has no index names, so Config::validate()
 * still refuses it, the daemons still decline to start, and Installer::isNeeded() still hands
 * the browser the installer at the step that failed. All it preserves is the work the operator
 * has already done — the log sources they confirmed, the account details they typed.
 *
 * A directory that cannot be written is reported and swallowed. The operator is already being
 * told about a failure; a second one about the place the first was going to be recorded is
 * worth one line, not a stack trace.
 */
function saveProgress(Config $cfg, string $configPath): bool
{
    $dir = dirname($configPath);
    if (!is_dir($dir) && !@mkdir($dir, 0750, true) && !is_dir($dir)) {
        return false;
    }

    try {
        $cfg->save();
    } catch (\Throwable $e) {
        return false;
    }
    return true;
}

/**
 * Check this server has what Loghound needs, and say what to run for anything it does not.
 *
 * THE TWO FRONT ENDS HAVE TO AGREE ON THIS, AND THEY USED NOT TO. The browser installer
 * opens on a system-check page — PHP version, every extension the application actually uses,
 * the two directories it writes, open_basedir, the webserver configuration, the log files it
 * intends to read — and refuses to continue while anything is failing. This wizard opened
 * straight into log detection and checked nothing at all, which mattered most precisely where
 * it was reached from: the browser installer names this command as the way out of an
 * open_basedir that hides the logs, and the command it names then walked the operator into
 * whatever was wrong without mentioning it. A missing sqlite3 surfaced as a stack trace three
 * steps later.
 *
 * So both front ends now render the same rows from the same Setup\Requirements, and a `fail`
 * stops this wizard exactly as it blocks that page. `warn` prints and continues, which is the
 * same rule and the same severity — a webserver configuration nobody can read makes detection
 * less certain, it does not make the install wrong.
 *
 * Fix lines are printed verbatim and one per line, because they are commands: every one is
 * built by Requirements against THIS machine's paths and THIS process's user, so it can be
 * pasted as it stands. Under --detect-only nothing is blocked, since that mode changes
 * nothing and its whole purpose is to report what a box looks like.
 *
 * @return bool False when something that must be fixed first is wrong.
 */
function checkRequirements(Config $cfg, Ui $UI, string $root): bool
{
    $rows = (new Requirements($root, $cfg))->all();

    $problems = 0;
    foreach ($rows as $row) {
        $state = (string) $row['state'];
        $line  = str_pad((string) $row['label'], 34) . ' ' . (string) $row['detail'];

        if ($state === 'pass') {
            $UI->ok($line);
            continue;
        }

        $state === 'fail' ? $UI->err($line) : $UI->warn($line);
        if ($state === 'fail') {
            $problems++;
        }

        foreach ((array) $row['fix'] as $fix) {
            $UI->raw('      ' . (string) $fix);
        }
    }

    if ($problems === 0) {
        return true;
    }

    $UI->nl();
    $UI->err(
        $problems . ($problems === 1 ? ' item has' : ' items have')
        . ' to be fixed before Loghound can be set up. Nothing has been changed.'
    );
    $UI->info('Run the commands printed under each one, then start this wizard again.');

    return false;
}

/**
 * Print one detected source: where it came from, the field mapping, real parsed lines,
 * and how confident we are. This is the screen SPEC §8 requires before anything is
 * ingested.
 *
 * Values come out of a log file and are therefore attacker-controlled; Detector has
 * already stripped control characters so they cannot reach the terminal as escapes.
 *
 * The confidence figure is shown even when it is bad. A 41% confidence is the most useful
 * thing on this screen, and hiding it would make the confirmation meaningless.
 *
 * @param array<string,mixed> $d One entry of the detection report.
 */
function presentSource(array $d, Ui $UI): void
{
    $UI->rule();
    $UI->raw('  ' . $UI->bold((string) ($d['path'] ?? '')));
    $UI->raw('  source:  ' . (string) ($d['source'] ?? 'unknown'));
    $UI->raw('  format:  ' . (string) ($d['format_name'] ?? ''));

    if ((string) ($d['format_string'] ?? '') !== '') {
        $UI->raw('  string:  ' . mb_strimwidth((string) $d['format_string'], 0, 100, '...'));
    }
    if (!empty($d['vhost'])) {
        $UI->raw('  vhost:   ' . (string) $d['vhost']);
    }
    if (!empty($d['outside_roots'])) {
        $UI->raw('  ' . $UI->yellow('outside allowed_log_roots — you will be asked to permit it'));
    }

    $c = (float) ($d['confidence'] ?? 0);
    $txt = sprintf(
        '%.1f%% of %d sampled lines parse cleanly',
        $c,
        (int) ($d['lines_tested'] ?? 0)
    );
    $UI->raw('  match:   ' . ($c >= 95 ? $UI->green($txt) : ($c >= 70 ? $UI->yellow($txt) : $UI->red($txt))));

    foreach ((array) ($d['mapping'] ?? []) as $m) {
        $UI->raw(sprintf(
            '           %-22s -> %-32s %s',
            (string) $m['token'],
            (string) $m['field'],
            mb_strimwidth((string) $m['example'], 0, 40, '...')
        ));
    }

    foreach ((array) ($d['missing'] ?? []) as $m) {
        $UI->raw('  ' . $UI->yellow('not logged:') . ' ' . (string) $m['token'] . ' — ' . (string) $m['why']);
    }

    $samples = (array) ($d['samples'] ?? []);
    if ($samples !== []) {
        $UI->raw('');
        $UI->raw('  Sample lines as Loghound reads them:');
        foreach (array_slice($samples, 0, 5) as $i => $sample) {
            $UI->raw('    [' . ($i + 1) . ']');
            foreach ((array) ($sample['parsed'] ?? []) as $k => $v) {
                $UI->raw(sprintf('      %-26s %s', (string) $k, mb_strimwidth((string) $v, 0, 90, '...')));
            }
        }
    } else {
        $UI->raw('  ' . $UI->yellow('No sample lines could be parsed — check this one carefully.'));
    }

    foreach ((array) ($d['alternatives'] ?? []) as $alt) {
        $UI->raw('  also considered: ' . (string) $alt['name'] . ' (' . (string) $alt['confidence'] . '%)');
    }

    $UI->rule();
}

/**
 * Apply the two privacy settings when, and only when, the environment supplies them.
 *
 * There is no prompt here and no step heading: an operator running the wizard by hand is
 * not asked how to store an address or how long to keep hits, and gets the defaults from
 * Config::defaults(). LOGHOUND_IP_MODE and LOGHOUND_RETENTION_DAYS stay because an
 * unattended install from Ansible or CI is the one case where a non-default answer has to
 * arrive with no human present.
 *
 * Either variable works on its own; the one that is not supplied keeps whatever the
 * configuration already holds, so pre-seeding one does not silently reset the other.
 *
 * An unusable value is reported and nothing is stored, rather than being rounded into
 * something that looked close enough.
 */
function applyPrivacyEnvironment(Config $cfg, Ui $UI): void
{
    $mode = getenv('LOGHOUND_IP_MODE');
    $days = getenv('LOGHOUND_RETENTION_DAYS');

    if ($mode === false && $days === false) {
        return;
    }

    $problems = Steps::applyPrivacy(
        $cfg,
        $mode === false ? (string) $cfg->get('privacy.ip_mode', 'full') : $mode,
        $days === false ? (int) $cfg->get('privacy.retention_days', 90) : $days
    );

    foreach ($problems as $problem) {
        $UI->err($problem);
    }

    if ($problems === []) {
        $UI->ok('Privacy settings taken from the environment: addresses stored as '
            . (string) $cfg->get('privacy.ip_mode') . ', hits deleted after '
            . (int) $cfg->get('privacy.retention_days') . ' days.');
    }
}

/**
 * Run one setup job to completion, printing each step as it lands.
 *
 * The browser installer runs these same steps a budget at a time and polls for progress;
 * here there is no gateway to time out, so the whole thing runs in one go. Either way the
 * work, the order and the error messages are identical.
 *
 * @param array<string,mixed> $params
 */
function runJob(Config $cfg, Ui $UI, string $root, string $kind, array $params): bool
{
    try {
        $job = Job::create($root . '/var/setup', $kind, $params);
    } catch (\Throwable $e) {
        $UI->err('Could not start: ' . $e->getMessage());
        return false;
    }

    $reported = false;

    $ok = $job->runAll($cfg, $root, static function (string $key, string $label, string $state, string $detail) use ($UI, &$reported): void {
        if ($state === 'done') {
            $UI->ok('  ' . $label . ($detail !== '' ? ' — ' . $detail : ''));
        } elseif ($state === 'error') {
            $UI->err('  ' . $label . ':');
            $UI->raw(wordwrap('      ' . $detail, 76, "\n      "));
            $reported = true;
        } else {
            $UI->info('  ' . $label . ($detail !== '' ? ' — ' . $detail : ''));
        }
    });

    if (!$ok && !$reported && $job->error() !== '') {
        $UI->err('  ' . $job->error());
    }
    return $ok;
}

/**
 * Is this installation already pointing at two provisioned indexes?
 *
 * The same three keys Setup\Steps::progress() calls the storage step complete on, so the
 * wizard and the browser installer agree on what "already done" means.
 */
function storageIsProvisioned(Config $cfg): bool
{
    return (string) $cfg->get('solr.base_url', '') !== ''
        && (string) $cfg->get('solr.hits_core', '') !== ''
        && (string) $cfg->get('solr.sessions_core', '') !== '';
}

/**
 * Provision the two indexes on Opensolr: credentials, region, creation, configset push, verify.
 *
 * The API key is read without echo, stored in the 0640 config and NEVER printed back,
 * not even partially masked — a masked key in a terminal scrollback is still a key in a
 * terminal scrollback.
 *
 * The index names are generated rather than asked for. An Opensolr index name is unique
 * across the WHOLE PLATFORM and permanent once created, so a name an operator picks is a
 * name that will collide with somebody; Config::coreName() builds one from a random
 * per-installation id and a collision is retried with a fresh id.
 *
 * IT RETURNS FALSE RATHER THAN CARRYING ON, and the caller ends the run there. A refused API
 * key used to be printed and then ignored: the wizard announced "Creating your indexes",
 * started a job that failed on the very same check, and walked the operator through a sign-in
 * method, a password typed twice and a panel URL before refusing to write anything at the end.
 * Nothing after this point can work without credentials the platform accepts, so this is where
 * it stops, with the one thing to go and fix — and what has already been decided is saved, so
 * the log sources just confirmed are not thrown away with the run.
 *
 * AN ALREADY-PROVISIONED INSTALL IS LEFT ALONE UNLESS THE OPERATOR SAYS OTHERWISE. Re-running
 * this wizard to change one privacy setting must not walk back through provisioning, and with
 * the bring-your-own-Solr answer gone there is no longer an option that means "my storage is
 * already sorted, move on" — so the question is asked directly, and its default is no. That
 * matters most to an unattended re-run: install.sh --non-interactive from Ansible or CI takes
 * the default, so it keeps the working indexes instead of demanding an API key it was not
 * given. LOGHOUND_RECONFIGURE_STORAGE=yes forces the step to run.
 */
function configureOpensolr(Config $cfg, Ui $UI, string $root): bool
{
    if (storageIsProvisioned($cfg)) {
        $UI->ok('Hits index:     ' . (string) $cfg->get('solr.hits_core'));
        $UI->ok('Sessions index: ' . (string) $cfg->get('solr.sessions_core'));
        if (!$UI->confirm('Re-run provisioning against Opensolr?', false, 'LOGHOUND_RECONFIGURE_STORAGE')) {
            $UI->info('Keeping the indexes this installation already has.');
            return true;
        }
    }

    $UI->info('You need an Opensolr account to get started. It is free forever to start,');
    $UI->info('with no credit card and no expiry date, and retention scales with the plan:');
    $UI->info('Loghound trims its oldest data before the account reaches its disk limit, so');
    $UI->info('the free tier keeps running and simply holds less history.');
    $UI->info('');
    $UI->info('  Create a free account   https://opensolr.com/register');
    $UI->info('  Sign in                 https://opensolr.com/users/login');
    $UI->info('  What the plans hold     https://opensolr.com/solr-hosting');
    $UI->info('');
    $UI->info('The API key is under Account in the Opensolr control panel.');
    $UI->info('');

    while (true) {
        $email = trim($UI->ask(
            'Opensolr account email',
            (string) $cfg->get('opensolr.email', ''),
            'LOGHOUND_OPENSOLR_EMAIL'
        ));

        $haveKey = (string) $cfg->get('opensolr.api_key', '') !== '';
        $key = $UI->askSecret(
            $haveKey
                ? 'Opensolr API key (not echoed, blank keeps the stored key)'
                : 'Opensolr API key (not echoed)',
            'LOGHOUND_OPENSOLR_API_KEY'
        );

        $errors = Storage::saveCredentials($cfg, $email, $key);
        $key = str_repeat("\0", 64);
        unset($key);

        if ($errors === []) {
            break;
        }
        foreach ($errors as $problem) {
            $UI->err($problem);
        }
        if ($UI->isNonInteractive()) {
            return false;
        }
    }

    try {
        $regions = Storage::listRegions($cfg);
    } catch (\Throwable $e) {
        $UI->err($e->getMessage());
        $UI->nl();
        $UI->info('Nothing has been created and nothing has been written. Fix the account details');
        $UI->info('and run this wizard again:');
        $UI->info('  Your API key is under Account   ' . Storage::URL_LOGIN);
        $UI->info('  No account yet?                 ' . Storage::URL_REGISTER);

        return false;
    }

    $cfg->set('opensolr.region', (string) Storage::settleRegion($cfg, $regions, false));

    $UI->ok('Opensolr accepted the credentials.');

    $account = Storage::account($cfg);
    if (!$account['ok']) {
        $UI->err($account['error']);
        $UI->nl();
        $UI->info('Nothing has been created or written. Try again once that is resolved.');

        return false;
    }

    $ownership = Pairs::settleOwnership($cfg, $account);
    Storage::persist($cfg);

    reportAccount($account, $UI);

    if ($ownership === 'missing') {
        $UI->nl();
        $UI->warn(Pairs::pendingHeadline());
        $UI->raw(wordwrap('    ' . Pairs::pendingDetail($cfg), 76, "\n    "));
    }

    return chooseIndexes($cfg, $UI, $root, $account, $regions);
}

/**
 * Say what the account holds and whether the plan has room, in the browser installer's words.
 *
 * The capacity sentence is Pairs::capacity()'s, unaltered, so an operator who has read one
 * front end reads the same numbers in the other. An unmatched half is named individually
 * rather than counted, because it is billable and the operator has to be able to go and look
 * at that exact index.
 *
 * @param array<string,mixed> $account
 */
function reportAccount(array $account, Ui $UI): void
{
    $UI->info($account['capacity']['sentence']);

    foreach ((array) $account['halves'] as $half) {
        $UI->warn((string) $half['name'] . ' is on this account without its matching '
            . (string) $half['missing'] . '.');
        $UI->raw(wordwrap('    ' . Pairs::halfNotice((array) $half), 76, "\n    "));
    }
}

/**
 * STEP TWO on the shell: the pairs this account holds, plus the option to make a new one.
 *
 * ONE PROMPT, ONE CHOICE, the same options in the same order as the browser installer and the
 * Settings card, worded by Pairs::decide(). A terminal cannot draw a radio list, so it prints
 * the rows and asks for one of their keys; that is the only difference there is meant to be.
 *
 * ONE PAIR CAN SERVE MANY SITES, which is why joining is offered at all: every document
 * Loghound writes carries the virtual host it came from, so several installations reporting into
 * one pair stay separable in the panel by its Virtual host dimension. An operator running
 * Loghound on six machines wants two indexes and six hostnames, not twelve indexes — and on a
 * plan whose index limit is small, joining is the only way the sixth machine gets set up at all.
 *
 * AN UNATTENDED RUN NEVER ADOPTS BY ACCIDENT. The default is a new pair, so a re-run from Ansible
 * or CI that happens to find another site's indexes does not quietly start writing into them;
 * LOGHOUND_OPENSOLR_REUSE has to name what it wants. When a new pair is NOT available the prompt
 * has no safe default at all, so rather than let choice() fall through to the first pair this
 * refuses and says why — an unattended install that adopts somebody else's indexes is worse than
 * one that stops.
 *
 * @param array<string,mixed> $account
 * @param array<int,mixed>    $regions
 * @return bool True when storage is now configured.
 */
function chooseIndexes(Config $cfg, Ui $UI, string $root, array $account, array $regions): bool
{
    $step = Pairs::decide($cfg, $account);

    $UI->nl();
    $UI->info($step['heading'] . ':');

    if ($step['dead_end'] !== '') {
        $UI->err($step['dead_end']);
        $UI->info($step['ways_heading']);
        foreach ($step['ways'] as $way) {
            $UI->raw('      - ' . $way['text'] . ($way['url'] !== '' ? ' ' . $way['url'] : ''));
        }
        $UI->nl();
        $UI->info('Nothing has been created. Run this wizard again once there is room.');

        return false;
    }

    $UI->raw(wordwrap('    ' . $step['intro'], 76, "\n    "));
    $UI->nl();

    $choices = [];
    foreach ($step['pairs'] as $pair) {
        $UI->raw('      ' . $pair['install_id'] . '   ' . $pair['hits'] . ' + ' . $pair['sessions']
            . ($pair['current'] ? '   (already in use here)' : ''));
        $choices[] = $pair['install_id'];
    }

    if ($step['can_new']) {
        $UI->raw('      ' . Pairs::CHOICE_NEW . str_repeat(' ', 9) . $step['new_label']);
        $choices[] = Pairs::CHOICE_NEW;
    }

    $UI->nl();
    if ($step['pairs'] !== []) {
        $UI->raw(wordwrap('    ' . $step['consequence'], 76, "\n    "));
    }
    if ($step['can_new']) {
        $UI->raw(wordwrap('    ' . $step['new_detail'], 76, "\n    "));
    } elseif ($step['new_blocked'] !== '') {
        $UI->warn($step['new_blocked']);
    }
    $UI->nl();

    if (!$step['can_new'] && $UI->isNonInteractive() && !$UI->answered('LOGHOUND_OPENSOLR_REUSE')) {
        $UI->err('This run has nobody to ask, and the only options left are indexes that belong to '
            . 'somebody else.');
        $UI->info('Set LOGHOUND_OPENSOLR_REUSE to one of the ids above to join that pair on purpose,');
        $UI->info('or free a slot so a new pair can be created. Nothing has been created.');

        return false;
    }

    $answer = $UI->choice(
        'Which indexes should this installation use',
        $choices,
        $step['can_new'] ? Pairs::CHOICE_NEW : '',
        'LOGHOUND_OPENSOLR_REUSE'
    );

    if ($answer === Pairs::CHOICE_NEW) {
        return provisionNewPair($cfg, $UI, $root, $regions);
    }

    $upgrade = $UI->confirm(
        'If those indexes were made by an older Loghound, add the fields this version writes?',
        false,
        'LOGHOUND_OPENSOLR_UPGRADE_SCHEMA'
    );

    $UI->nl();

    return runJob($cfg, $UI, $root, Job::KIND_REUSE, [
        'install_id'     => $answer,
        'upgrade_schema' => $upgrade,
    ]);
}

/**
 * The "make a new pair" arm of step two: pick a region, then run the provisioning job.
 *
 * The region is asked here rather than in step one because the list belongs to the account and
 * is not knowable until the credentials have been checked — the browser installer puts its
 * region menu inside the same option for the same reason.
 *
 * The capacity gate is not repeated here: it is step 2 of the job, ahead of the first create,
 * and Pairs::decide() has already withheld this option when the plan is known to be full.
 *
 * @param array<int,mixed> $regions
 */
function provisionNewPair(Config $cfg, Ui $UI, string $root, array $regions): bool
{
    $stored = (string) $cfg->get('opensolr.region', '');
    $region = $UI->choice(
        'Region',
        array_map('strval', $regions),
        in_array($stored, $regions, true) ? $stored : (string) ($regions[0] ?? ''),
        'LOGHOUND_OPENSOLR_REGION'
    );

    $UI->nl();
    $UI->info('Creating your indexes. The names are generated because an Opensolr index');
    $UI->info('name has to be unique across the whole platform.');

    if (!runJob($cfg, $UI, $root, Job::KIND_OPENSOLR, ['region' => $region])) {
        return false;
    }

    $UI->nl();
    $UI->info('Backups, downloads and restores for these indexes are available in your');
    $UI->info('Opensolr control panel. You never need to touch a configset by hand.');

    return true;
}

/**
 * Ask for the panel username, the password, and how the operator wants to sign in.
 *
 * The sign-in mode is asked HERE rather than left to default, because this wizard is the
 * only setup path some installations ever run: without the question a CLI operator was
 * pinned to Basic by applyAdmin()'s default and could only reach the sign-in page by
 * editing config/loghound.php by hand.
 *
 * The default stays 'basic' — the existing value when there is one, Basic otherwise — so
 * a non-interactive run answers exactly as it did before and the CLI and the browser
 * installer still produce the same configuration from the same answers.
 *
 * The choices and their wording come from Steps::authModes(), which is Security::authModes(),
 * which is the same list the browser installer renders and the same one applyAdmin() and
 * applyAuthMode() validate against.
 *
 * The plaintext never leaves this function: Steps::applyAdmin hashes it immediately, and
 * the local copy is overwritten before returning.
 */
function setPanelAccount(Config $cfg, Ui $UI): void
{
    $UI->nl();
    $UI->info('How do you want to sign in to the panel?');
    foreach (Steps::authModes() as $key => $mode) {
        $UI->raw('  ' . str_pad((string) $key, 10) . $mode['label'] . ' — ' . $mode['text']);
        $UI->raw('  ' . str_repeat(' ', 10) . $mode['cost']);
    }

    $current = (string) $cfg->get('auth.mode', 'basic');
    $authMode = $UI->choice(
        'Sign-in method',
        array_keys(Steps::authModes()),
        array_key_exists($current, Steps::authModes()) ? $current : 'basic',
        'LOGHOUND_AUTH_MODE'
    );

    while (true) {
        $user = trim($UI->ask('Panel username', (string) $cfg->get('auth.user', 'admin'), 'LOGHOUND_PANEL_USER'));
        $pass = $UI->askSecret('Panel password (not echoed)', 'LOGHOUND_PANEL_PASSWORD');

        $confirm = '';
        if (!$UI->isNonInteractive() && getenv('LOGHOUND_PANEL_PASSWORD') === false) {
            $confirm = $UI->askSecret('Repeat the password');
        }

        $errors = Steps::applyAdmin($cfg, $user, $pass, $confirm, $authMode);
        $pass = str_repeat("\0", 64);
        $confirm = str_repeat("\0", 64);
        unset($pass, $confirm);

        if ($errors === []) {
            $UI->ok('Panel credentials stored as a password hash.');
            return;
        }
        foreach ($errors as $problem) {
            $UI->warn($problem);
        }
        if ($UI->isNonInteractive()) {
            return;
        }
    }
}

/**
 * Minimal prompting and colouring for the wizard.
 *
 * No dependency, no ncurses: this has to run on a bare box over SSH, and it has to be
 * readable when the operator has piped the output into a file.
 */
final class Ui
{
    private bool $color;

    /**
     * When true, no prompt ever blocks: an answer comes from the environment or from
     * the offered default. This is what lets install.sh run end-to-end from Ansible or
     * CI without a terminal.
     */
    private bool $nonInteractive;

    public function __construct(bool $color, bool $nonInteractive = false)
    {
        $this->color = $color;
        $this->nonInteractive = $nonInteractive;
    }

    /** Whether prompts are being answered from the environment rather than a human. */
    public function isNonInteractive(): bool
    {
        return $this->nonInteractive;
    }

    /**
     * Has this prompt been answered in the environment?
     *
     * Needed where an unattended run must not be allowed to fall through to the first option.
     * choice() picks options[0] rather than hanging a CI job on an unusable default, which is
     * right for a menu of equivalent answers and wrong for one where the first entry would
     * silently adopt another site's indexes. A caller can ask this and refuse instead.
     */
    public function answered(string $env): bool
    {
        return $this->env($env) !== null;
    }

    /**
     * Look up an environment override for a prompt.
     *
     * Returns null when the variable is unset, so an intentional empty string (for
     * example "no HTTP basic auth on my Solr") is distinguishable from "not specified".
     */
    private function env(string $name): ?string
    {
        if ($name === '') {
            return null;
        }
        $v = getenv($name);
        return $v === false ? null : $v;
    }

    /** Colour helper, a no-op when colour is disabled. */
    private function c(string $s, string $code): string
    {
        return $this->color ? "\033[" . $code . 'm' . $s . "\033[0m" : $s;
    }

    /** Bold text. */
    public function bold(string $s): string
    {
        return $this->c($s, '1');
    }

    /** Green text. */
    public function green(string $s): string
    {
        return $this->c($s, '32');
    }

    /** Yellow text. */
    public function yellow(string $s): string
    {
        return $this->c($s, '33');
    }

    /** Red text. */
    public function red(string $s): string
    {
        return $this->c($s, '31');
    }

    /** A boxed heading. */
    public function banner(string $s): void
    {
        $this->nl();
        fwrite(STDOUT, $this->bold($s) . "\n");
        fwrite(STDOUT, str_repeat('=', max(20, strlen($s))) . "\n\n");
    }

    /** A numbered step heading. */
    public function step(int $n, string $s): void
    {
        fwrite(STDOUT, $this->bold("[$n] $s") . "\n");
    }

    /** A horizontal rule for the source-confirmation block. */
    public function rule(): void
    {
        fwrite(STDOUT, str_repeat('-', 76) . "\n");
    }

    /** A blank line. */
    public function nl(): void
    {
        fwrite(STDOUT, "\n");
    }

    /** Unformatted output. */
    public function raw(string $s): void
    {
        fwrite(STDOUT, $s . "\n");
    }

    /** Informational line. */
    public function info(string $s): void
    {
        fwrite(STDOUT, $s . "\n");
    }

    /** Success line. */
    public function ok(string $s): void
    {
        fwrite(STDOUT, $this->green('ok') . '  ' . $s . "\n");
    }

    /** Warning line. */
    public function warn(string $s): void
    {
        fwrite(STDOUT, $this->yellow('!!') . '  ' . $s . "\n");
    }

    /** Error line, on stderr so it survives a redirect of stdout. */
    public function err(string $s): void
    {
        fwrite(STDERR, $this->red('xx') . '  ' . $s . "\n");
    }

    /**
     * Prompt for a line of input, offering a default.
     *
     * With no stdin at all — a piped install, a closed terminal — the default is taken
     * rather than spinning forever.
     *
     * @param string $env Environment variable that answers this prompt when set. Always
     *                    consulted, interactive or not, so an operator can pre-seed one
     *                    answer and still be asked the rest.
     */
    public function ask(string $question, string $default = '', string $env = ''): string
    {
        $override = $this->env($env);
        if ($override !== null) {
            fwrite(STDOUT, $question . ': ' . $override . ' (from $' . $env . ")\n");
            return $override;
        }
        if ($this->nonInteractive) {
            fwrite(STDOUT, $question . ': ' . $default . " (default; non-interactive)\n");
            return $default;
        }

        $suffix = $default !== '' ? ' [' . $default . ']' : '';
        fwrite(STDOUT, $question . $suffix . ': ');
        $line = fgets(STDIN);
        if ($line === false) {
            fwrite(STDOUT, "\n");
            return $default;
        }
        $line = trim($line);
        return $line === '' ? $default : $line;
    }

    /**
     * Prompt for a value that must not appear on screen or in the scrollback.
     *
     * Turns off terminal echo with stty for the duration. If stty is unavailable (no
     * TTY at all) the prompt says so explicitly rather than quietly echoing a secret.
     *
     * An environment override never appears on screen either, which is the whole point of
     * this method: LOGHOUND_OPENSOLR_API_KEY must not be echoed back by the wizard any more
     * than a typed key would be.
     *
     * No user input reaches the stty command line — it is a fixed string either way — so
     * there is nothing there to escape.
     */
    public function askSecret(string $question, string $env = ''): string
    {
        $override = $this->env($env);
        if ($override !== null) {
            fwrite(STDOUT, $question . ': (taken from $' . $env . ", not shown)\n");
            return $override;
        }
        if ($this->nonInteractive) {
            fwrite(STDOUT, $question . ': (not set; $' . $env . " is empty)\n");
            return '';
        }

        $isTty = function_exists('posix_isatty') && @posix_isatty(STDIN);

        if (!$isTty) {
            fwrite(STDOUT, $question . ' (WARNING: no terminal, input will be visible): ');
            $line = fgets(STDIN);
            return $line === false ? '' : trim($line);
        }

        fwrite(STDOUT, $question . ': ');
        @shell_exec('stty -echo 2>/dev/null');
        $line = fgets(STDIN);
        @shell_exec('stty echo 2>/dev/null');
        fwrite(STDOUT, "\n");

        return $line === false ? '' : trim($line);
    }

    /**
     * Yes/no prompt.
     */
    public function confirm(string $question, bool $default, string $env = ''): bool
    {
        $override = $this->env($env);
        if ($override !== null) {
            $val = in_array(strtolower(trim($override)), ['1', 'y', 'yes', 'true', 'on'], true);
            fwrite(STDOUT, $question . ': ' . ($val ? 'yes' : 'no') . ' (from $' . $env . ")\n");
            return $val;
        }
        if ($this->nonInteractive) {
            fwrite(STDOUT, $question . ': ' . ($default ? 'yes' : 'no') . " (default; non-interactive)\n");
            return $default;
        }

        $hint = $default ? '[Y/n]' : '[y/N]';
        while (true) {
            fwrite(STDOUT, $question . ' ' . $hint . ': ');
            $line = fgets(STDIN);
            if ($line === false) {
                fwrite(STDOUT, "\n");
                return $default;
            }
            $line = strtolower(trim($line));
            if ($line === '') {
                return $default;
            }
            if ($line === 'y' || $line === 'yes') {
                return true;
            }
            if ($line === 'n' || $line === 'no') {
                return false;
            }
        }
    }

    /**
     * Prompt until the answer is one of $options.
     *
     * In non-interactive mode an unusable default would loop forever, so it falls back to the
     * first option rather than hanging a CI job.
     *
     * @param string[] $options
     */
    public function choice(string $question, array $options, string $default, string $env = ''): string
    {
        if ($this->nonInteractive && $this->env($env) === null && !in_array($default, $options, true)) {
            $default = (string) ($options[0] ?? '');
        }
        while (true) {
            $answer = $this->ask($question . ' (' . implode('|', $options) . ')', $default, $env);
            if (in_array($answer, $options, true)) {
                return $answer;
            }
            $this->warn('Choose one of: ' . implode(', ', $options));
            if ($this->nonInteractive) {
                return $default;
            }
        }
    }
}
