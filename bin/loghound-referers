#!/usr/bin/env php
<?php
/**
 * Loghound — give already indexed sessions their real source instead of this site.
 *
 * Sessions indexed before RefererOrigin existed can carry the visited site's own address as
 * their referer. This rewrites each of them with the latest external referer of the same
 * address on the same host at or before the session start, or marks the visit direct.
 *
 * Each document is written back whole, not as an atomic update. Every sessions field that is
 * not a copyField target is stored or has docValues, so the field list read from this release's
 * schema.xml returns the complete document, and copyField targets are rebuilt by Solr.
 *
 * USAGE
 *   loghound-referers           count the sessions that would change, change nothing
 *   loghound-referers --apply   rewrite them
 *
 * Sessions still open in the tailer are republished by the scorer from their aggregate, so run
 * it once more after the idle timeout has passed since the tailer was restarted.
 *
 * EXIT CODES: 0 done, 1 unusable configuration or bad flags, 2 Solr failed.
 *
 * @package Loghound
 * @license MIT
 */

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

require __DIR__ . '/../src/autoload.php';

use Loghound\Config;
use Loghound\Parser;
use Loghound\RefererOrigin;
use Loghound\Security;
use Loghound\Solr;

$root       = dirname(__DIR__);
$configPath = getenv('LOGHOUND_CONFIG') ?: $root . '/config/loghound.php';

$apply = false;
foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--apply') {
        $apply = true;
        continue;
    }
    if ($arg === '--help' || $arg === '-h') {
        fwrite(STDOUT, "Usage: loghound-referers [--apply]\n");
        exit(0);
    }
    fwrite(STDERR, 'loghound-referers: unknown option ' . $arg . "\n");
    exit(1);
}

$cfg = Config::load($configPath);
$errors = $cfg->validate();
if ($errors !== []) {
    fwrite(STDERR, "Loghound: configuration is not usable:\n  - " . implode("\n  - ", $errors) . "\n");
    exit(1);
}

$solr = new Solr((array) $cfg->get('solr', []));
$hitsCore = (string) $cfg->get('solr.hits_core', '');
$sessionsCore = (string) $cfg->get('solr.sessions_core', '');
if ($hitsCore === '' || $sessionsCore === '') {
    fwrite(STDERR, "Loghound: no indexes configured. Run bin/loghound-setup first.\n");
    exit(1);
}

$fields = lh_referers_fields($root . '/solr/sessions/conf/schema.xml');
if ($fields === null) {
    fwrite(STDERR, "Loghound: the sessions schema would not return complete documents; nothing was changed.\n");
    exit(1);
}

$origin = new RefererOrigin();
$origin->useSolr($solr, $hitsCore);

$filter = ['referer_type_s:internal'];

try {
    $total = (int) ($solr->query($sessionsCore, ['q' => '*:*', 'fq' => $filter, 'rows' => 0])['response']['numFound'] ?? 0);
} catch (\Throwable $e) {
    fwrite(STDERR, 'Loghound: ' . $e->getMessage() . "\n");
    exit(2);
}

fwrite(STDOUT, 'Sessions whose referer is this site: ' . $total . "\n");
if (!$apply || $total === 0) {
    exit(0);
}

$external = 0;
$direct = 0;

while (true) {
    try {
        $docs = $solr->query($sessionsCore, [
            'q'    => '*:*',
            'fq'   => $filter,
            'sort' => 'ts_start asc',
            'rows' => 200,
            'fl'   => implode(',', $fields),
        ])['response']['docs'] ?? [];
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Loghound: ' . $e->getMessage() . "\n");
        exit(2);
    }
    if ($docs === []) {
        break;
    }

    $batch = [];
    foreach ($docs as $doc) {
        $ts = (string) ($doc['ts_start'] ?? '');
        $tsMs = Parser::epochMs($ts);
        if ($tsMs <= 0 && ($unix = strtotime($ts)) !== false) {
            $tsMs = $unix * 1000;
        }
        if ((string) ($doc['id'] ?? '') === '' || $tsMs <= 0) {
            continue;
        }

        $source = $origin->lookup((string) ($doc['ip_s'] ?? ''), (string) ($doc['host_s'] ?? ''), $tsMs);
        if ($source === null && $origin->failed()) {
            fwrite(STDERR, 'Loghound: the hits lookup failed; nothing more is rewritten. ' . $solr->lastError() . "\n");
            exit(2);
        }

        unset($doc['_version_']);
        $batch[] = RefererOrigin::apply($doc, $source);
        $source === null ? $direct++ : $external++;
    }

    if ($batch === []) {
        break;
    }

    try {
        $solr->addDocs($sessionsCore, $batch);
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Loghound: ' . $e->getMessage() . "\n");
        exit(2);
    }

    fwrite(STDOUT, '  rewritten ' . ($external + $direct) . ' of ' . $total . "\n");
    sleep(2);
}

fwrite(STDOUT, 'Done. External source found: ' . $external . ', direct: ' . $direct . "\n");
exit(0);

/**
 * Every sessions field that comes back in a query, or null when one would be lost on rewrite.
 *
 * copyField targets are skipped because Solr rebuilds them, `_version_` and `_root_` because
 * Solr manages them. Any other field that is neither stored nor docValues makes a whole-document
 * rewrite lossy, and the script refuses.
 *
 * @return array<int,string>|null
 */
function lh_referers_fields(string $schemaPath): ?array
{
    $xml = is_file($schemaPath) ? simplexml_load_file($schemaPath, null, LIBXML_NONET) : false;
    if ($xml === false) {
        return null;
    }

    $targets = [];
    foreach ($xml->copyField as $copy) {
        $targets[(string) $copy['dest']] = true;
    }

    $fields = [];
    foreach ($xml->field as $field) {
        $name = (string) $field['name'];
        if (isset($targets[$name]) || $name === '_version_' || $name === '_root_') {
            continue;
        }
        if (!Security::isSafeFieldName($name)) {
            return null;
        }
        if ((string) $field['stored'] === 'false' && (string) $field['docValues'] !== 'true') {
            return null;
        }
        $fields[] = $name;
    }

    return $fields === [] ? null : $fields;
}
