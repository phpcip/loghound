#!/usr/bin/env php
<?php
/**
 * Loghound — retention enforcement (SPEC §1, Privacy).
 *
 * "Configurable retention with a real deletion job, not just docs saying you should."
 * This is that job. Run daily by loghound-retention.timer.
 *
 * ---------------------------------------------------------------------------------------
 * THREE PASSES, IN THIS ORDER, EACH INDEPENDENT
 * ---------------------------------------------------------------------------------------
 *
 * 1. **Time-based retention.** Everything in `hits` older than privacy.retention_days, and
 *    every SESSION document in `sessions` older than the same cutoff. This is a privacy
 *    decision: how long you are willing to keep a record of a visitor. Setting it to 0
 *    disables it entirely, which is a supported configuration — some operators are required
 *    to keep everything — and the other two passes still run.
 *
 * 2. **Size-based rolling retention.** The index is brought back under its Opensolr plan's
 *    disk quota by deleting its oldest data. The ingest daemon does this before it writes,
 *    which is what keeps the index inside the quota in normal operation; running it here as
 *    well covers the installation whose tailer has been stopped for a week, and gives an
 *    operator a `--dry-run` that shows exactly what the rolling window would remove.
 *
 *    Retention is therefore TWO limits and whichever bites first wins. They are not
 *    alternatives and neither replaces the other: one is about visitors, the other about
 *    capacity.
 *
 * 3. **Local state.** The SQLite store under var/ accumulates enrichment cache rows, closed
 *    sessions, merged beacon payloads and rate-limit buckets. Unbounded local state is the
 *    same class of problem as an unbounded index — it simply fills a different disk — and
 *    State exposes purge methods that, until now, nothing called.
 *
 * What is preserved: the daily rollup documents, when privacy.rollup_forever is true (the
 * default). They are aggregate counts with nothing that identifies a visitor, so keeping
 * them is compatible with a short retention policy — and it is the difference between a
 * 90-day tool and one that can show you last year. Both the time-based and the size-based
 * pass restrict themselves to `doc_type_s:session` on the sessions core for that reason.
 *
 * Exit codes: 0 success (including "nothing to do"), 1 configuration error, 2 runtime failure.
 *
 * Usage:
 *   loghound-retention            delete
 *   loghound-retention --dry-run  report what would be deleted, delete nothing
 *
 * The script refuses to run under a web SAPI: a delete-by-query job reachable over HTTP is
 * an unauthenticated way to destroy the index, so it refuses regardless of where somebody
 * put this file.
 *
 * The retention has a floor of one day. A retention of "0.5 days" arriving as a rounding
 * accident would delete the data the dashboard is currently showing, and there is no undo.
 *
 * The cutoff is computed here, in PHP, and formatted as an explicit ISO instant rather than
 * handed to Solr as "NOW-90DAYS". Two reasons: the same instant is used for both cores so
 * they cannot drift apart mid-run, and an absolute timestamp is what gets printed in the dry
 * run — an operator about to delete data should see a date, not an expression.
 *
 * Both delete queries are built with Solr::rangeFilter(), which validates the bound, and both
 * are checked again by Solr::deleteByQuery()'s assertSafeFilter(). Neither takes any input
 * from outside this file: retention_days comes from a config file only root and the loghound
 * user can write, and it is cast to int before it is used as arithmetic.
 *
 * Sessions are deleted first. If the run dies between the two deletes, the surviving state is
 * "hits without their session document", which the dashboard tolerates because it queries
 * sessions, rather than "session documents pointing at hits that no longer exist", which
 * makes every drill-down a dead end.
 *
 * A note on disk, because operators are surprised by this every time: deleting documents in
 * Lucene marks them deleted, and the bytes come back only when a merge rewrites the segments
 * that contained them, which happens on the index's own schedule. Both cores set
 * deletesPctAllowed in solrconfig.xml so that reclaim happens steadily instead of all at
 * once, and nothing here forces an optimize — a forced merge on a large index rewrites the
 * whole thing, needs double the disk while it runs, and would stall ingestion for minutes. If
 * you genuinely need the space back now, do it from the Opensolr control panel during a quiet
 * period. It is also why the size-based pass does not delete, re-read the size and delete
 * again: the size it would read back is the size before the merge.
 *
 * @package Loghound
 * @license MIT
 */

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

require __DIR__ . '/../src/autoload.php';

use Loghound\Config;
use Loghound\Quota;
use Loghound\Solr;

$root       = dirname(__DIR__);
$configPath = getenv('LOGHOUND_CONFIG') ?: $root . '/config/loghound.php';
$dryRun     = in_array('--dry-run', $argv, true);

$cfg = Config::load($configPath);
$errors = $cfg->validate();
if ($errors !== []) {
    fwrite(STDERR, "Loghound: configuration is not usable:\n  - " . implode("\n  - ", $errors) . "\n");
    exit(1);
}

$days = (int) $cfg->get('privacy.retention_days', 0);
if ($days < 0) {
    fwrite(STDERR, "Loghound: privacy.retention_days must be 0 (disabled) or a positive number of days.\n");
    exit(1);
}

$hitsCore      = (string) $cfg->get('solr.hits_core');
$sessionCore   = (string) $cfg->get('solr.sessions_core');
$rollupForever = (bool) $cfg->get('privacy.rollup_forever', true);

try {
    $solr = new Solr((array) $cfg->get('solr', []));
} catch (\Throwable $e) {
    fwrite(STDERR, 'Loghound: ' . $e->getMessage() . "\n");
    exit(1);
}

$installId = (string) $cfg->get('solr.install_id', '');
$installId = preg_match('/^[a-f0-9]{4,32}$/D', $installId) === 1 ? $installId : '';

$failed = false;

/* ---------------------------------------------------------------------------------------
 * Pass 1 — time-based retention
 * ------------------------------------------------------------------------------------ */

if ($days <= 0) {
    fwrite(STDOUT, "Nothing is deleted for being old: no age limit is set, so hits are kept "
        . "indefinitely as far as age is concerned. Whether they survive is then decided by the "
        . "size rule below, which deletes the oldest data when an index approaches its plan's "
        . "disk quota.\n");
} else {
    $cutoffIso = gmdate('Y-m-d\TH:i:s\Z', time() - ($days * 86400));

    /*
     * The clause that keeps this pass inside the documents THIS installation wrote, when the
     * pair of indexes is shared with another one.
     *
     * Asked only when something is actually about to be DELETED. A dry run and a disabled pass
     * touch nothing, and making them consult Solr would turn "report what would happen" into a
     * pass that can fail for a reason unrelated to what it was asked to report.
     *
     * Empty means no scoping at all, which is exactly the behaviour this script has always had
     * and is right for the overwhelmingly common single-installation case: documents written
     * before `install_s` existed carry no value for it, so a run that always scoped would stop
     * deleting an installation's own history the day it upgraded and the retention promise in
     * docs/PRIVACY.md would quietly stop being kept.
     *
     * FALSE means the pair is shared and this installation cannot name its own documents, so
     * there is no safe delete to make. The pass is skipped and the run fails loudly — a cron
     * that exits 0 having silently not applied a retention policy is the failure this project
     * exists to stop shipping.
     */
    $installScope = $dryRun ? '' : installScope($solr, $sessionCore, $hitsCore, $installId);

    $hitsQuery = $installScope === '' || $installScope === false
        ? Solr::rangeFilter('ts', null, $cutoffIso)
        : $installScope . ' +' . Solr::rangeFilter('ts', null, $cutoffIso);

    $sessionQuery = $rollupForever
        ? '+' . Solr::termFilter('doc_type_s', 'session') . ' +' . Solr::rangeFilter('ts_start', null, $cutoffIso)
        : Solr::rangeFilter('ts_start', null, $cutoffIso);

    if (is_string($installScope) && $installScope !== '') {
        $sessionQuery = $rollupForever
            ? $installScope . ' ' . $sessionQuery
            : $installScope . ' +' . Solr::rangeFilter('ts_start', null, $cutoffIso);
    }

    if ($installScope === false) {
        fwrite(
            STDERR,
            "Loghound: this pair of indexes is shared with another installation and this one has no\n"
            . "usable solr.install_id, so its documents cannot be told apart. Time-based retention did\n"
            . "NOT run: deleting by age here would delete another installation's data. Set\n"
            . "solr.install_id in config/loghound.php and run again.\n"
        );
        $failed = true;
    } elseif ($dryRun) {
        try {
            $hitsCount = (int) ($solr->query($hitsCore, [
                'q' => '*:*', 'fq' => [$hitsQuery], 'rows' => 0,
            ])['response']['numFound'] ?? 0);

            $sessCount = (int) ($solr->query($sessionCore, [
                'q' => '*:*', 'fq' => [$sessionQuery], 'rows' => 0,
            ])['response']['numFound'] ?? 0);
        } catch (\Throwable $e) {
            fwrite(STDERR, 'Loghound: dry run failed: ' . $e->getMessage() . "\n");
            exit(2);
        }

        fwrite(STDOUT, "Retention dry run\n");
        fwrite(STDOUT, "  cutoff             : " . $cutoffIso . " (" . $days . " days)\n");
        fwrite(STDOUT, "  hits query         : " . $hitsQuery . "\n");
        fwrite(STDOUT, "  hits to delete     : " . $hitsCount . "\n");
        fwrite(STDOUT, "  sessions query     : " . $sessionQuery . "\n");
        fwrite(STDOUT, "  sessions to delete : " . $sessCount . "\n");
        fwrite(STDOUT, "  daily rollups      : " . ($rollupForever ? "PRESERVED" : "deleted with everything else") . "\n");
    } else {
        try {
            $solr->deleteByQuery($sessionCore, $sessionQuery);
            fwrite(STDOUT, "Deleted sessions older than " . $cutoffIso . "\n");
        } catch (\Throwable $e) {
            fwrite(STDERR, 'Loghound: session retention failed: ' . $e->getMessage() . "\n");
            $failed = true;
        }

        try {
            $solr->deleteByQuery($hitsCore, $hitsQuery);
            fwrite(STDOUT, "Deleted hits older than " . $cutoffIso . "\n");
        } catch (\Throwable $e) {
            fwrite(STDERR, 'Loghound: hit retention failed: ' . $e->getMessage() . "\n");
            $failed = true;
        }
    }
}

/* ---------------------------------------------------------------------------------------
 * Pass 2 — size-based rolling retention
 * ------------------------------------------------------------------------------------ */

$failed = trimToPlan($cfg, $solr, $hitsCore, $sessionCore, $rollupForever, $dryRun, $installId) || $failed;

/* ---------------------------------------------------------------------------------------
 * Pass 3 — local SQLite state
 * ------------------------------------------------------------------------------------ */

purgeLocalState($cfg, $dryRun);

exit($failed ? 2 : 0);

/**
 * Is this pair of indexes being written by more than one Loghound installation?
 *
 * A pair may be shared: a new installation can be pointed at an existing
 * `loghound_<hex>_hits`/`_sessions` pair instead of creating its own, so that one dashboard
 * covers several sites on several machines, told apart by `host_s`. Retention then becomes
 * dangerous in a way it never was with one writer — a 90-day policy here would delete a
 * neighbour's 365 days — so this is asked before anything is deleted.
 *
 * ANSWERED FROM EVIDENCE, NOT CONFIGURATION, like every other "is this actually the case"
 * question in the product. A flag in the config file would say what somebody intended when
 * they installed; a facet on `install_s` says who has actually written a document. One terms
 * facet per core per run, and this script runs daily.
 *
 * FAILS CLOSED, and the direction matters. An unreachable Solr or an unreadable facet answers
 * TRUE — assume shared — so a run that cannot establish it is alone deletes nothing rather
 * than deleting everything. The cost of that is a day of retention not applied, which the next
 * run makes up; the cost of the other direction is another installation's data, which nothing
 * makes up.
 *
 * A value of `install_s` other than ours, on either core, is enough. Documents with no
 * `install_s` at all are NOT evidence of a second writer: the field is newer than the product,
 * so every document written before it exists is ours by construction — a pair could not be
 * shared before sharing existed.
 */
function sharedPair(Solr $solr, string $sessionCore, string $hitsCore, string $installId): bool
{
    static $answer = null;
    if ($answer !== null) {
        return $answer;
    }
    $answer = sharedPairProbe($solr, $sessionCore, $hitsCore, $installId);

    return $answer;
}

/**
 * The filter clause that scopes a delete to this installation, or the reason there is none.
 *
 * Three answers, and the caller has to distinguish all three:
 *
 *   ''     the pair is not shared. Delete unscoped, exactly as this script always has.
 *   '+…'   the pair is shared and this installation can name its documents. Scope every delete.
 *   false  the pair is shared and this installation CANNOT name its documents, because it has
 *          no usable `solr.install_id`. There is no safe delete; the caller must skip and fail.
 *
 * @return string|false
 */
function installScope(Solr $solr, string $sessionCore, string $hitsCore, string $installId)
{
    if (!sharedPair($solr, $sessionCore, $hitsCore, $installId)) {
        return '';
    }
    if ($installId === '') {
        return false;
    }

    return '+' . Solr::termFilter('install_s', $installId);
}

/**
 * Ask Solr, once, whether any installation other than this one has written to the pair.
 *
 * Split from sharedPair() only so that the memoisation there has nothing else in it: the
 * question is asked from both retention passes and it is one facet per core, not two.
 */
function sharedPairProbe(Solr $solr, string $sessionCore, string $hitsCore, string $installId): bool
{
    foreach ([$sessionCore, $hitsCore] as $core) {
        if ($core === '') {
            continue;
        }
        try {
            $res = $solr->jsonFacet(
                $core,
                ['q' => '*:*', 'rows' => 0],
                ['installs' => ['type' => 'terms', 'field' => 'install_s', 'limit' => 10, 'mincount' => 1]]
            );
        } catch (\Throwable $e) {
            fwrite(STDERR, 'Loghound: cannot tell whether ' . $core . ' is shared (' . $e->getMessage()
                . '); assuming it is.' . "\n");
            return true;
        }

        $buckets = $res['facets']['installs']['buckets'] ?? null;
        if (!is_array($buckets)) {
            fwrite(STDERR, 'Loghound: cannot tell whether ' . $core . ' is shared; assuming it is.' . "\n");
            return true;
        }

        foreach ($buckets as $bucket) {
            $val = (string) ($bucket['val'] ?? '');
            if ($val !== '' && $val !== $installId) {
                return true;
            }
        }
    }

    return false;
}

/**
 * Bring both cores back inside their Opensolr plan's disk quota.
 *
 * Reports rather than acts under --dry-run, and prints the cutoff and the document count of
 * every step, because "this would delete 4.2 million hits from before 03/01/2026" is the
 * only form in which an operator can agree to a rolling window.
 *
 * Each core is trimmed against its OWN quota and its OWN timestamp field, passed as a pair.
 * The sessions core additionally carries `doc_type_s:session`, so a size trim can no more
 * delete a daily rollup than the time-based pass above can.
 *
 * WHEN THE PAIR IS SHARED, both targets also carry `install_s`, so a size trim deletes only
 * documents this installation wrote. That is a real restriction on what the trim can achieve —
 * an installation contributing a tenth of the index cannot free the other nine tenths, so a
 * pair that is over its plan because of a NEIGHBOUR's traffic will stay over it, and the step
 * reports "that cutoff covers every document in the index" rather than quietly deleting
 * somebody else's data to make room for ours. Failing to trim is recoverable; deleting another
 * installation's history is not.
 *
 * A failure on one core does not stop the other: they have separate quotas on the platform
 * and one being blocked is a reason to trim the other, not a reason to give up.
 *
 * @return bool True when something failed.
 */
function trimToPlan(
    Config $cfg,
    Solr $solr,
    string $hitsCore,
    string $sessionCore,
    bool $rollupForever,
    bool $dryRun,
    string $installId = ''
): bool {
    try {
        $quota = new Quota($cfg);
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Loghound: plan usage is unavailable: ' . $e->getMessage() . "\n");
        return false;
    }

    if (!$quota->enabled()) {
        fwrite(STDOUT, "Nothing is deleted for size either: the rolling window is switched off "
            . "(quota.enabled = false), so an index can grow until it reaches its Opensolr plan "
            . "quota — at which point the platform blocks it, reads included.\n");
        return false;
    }

    $scope = $dryRun ? '' : installScope($solr, $hitsCore, $sessionCore, $installId);

    if ($scope === false) {
        fwrite(
            STDERR,
            "Loghound: this pair of indexes is shared with another installation and this one has no\n"
            . "usable solr.install_id. Size-based retention did NOT run: trimming here would delete\n"
            . "another installation's data to make room for ours.\n"
        );
        return true;
    }

    $scope = ltrim((string) $scope, '+');

    $hitsExtra = $scope === '' ? null : $scope;

    $sessionExtra = $rollupForever ? Solr::termFilter('doc_type_s', 'session') : null;
    if ($scope !== '') {
        $sessionExtra = $sessionExtra === null ? $scope : $sessionExtra . ' +' . $scope;
    }

    $targets = [
        [$hitsCore, 'ts', $hitsExtra],
        [$sessionCore, 'ts_start', $sessionExtra],
    ];

    $failed = false;

    foreach ($targets as [$core, $field, $extraFq]) {
        if ($core === '') {
            continue;
        }

        $probe = $quota->probe($solr, $core);
        if ($probe['state'] === 'blocked') {
            fwrite(STDERR, 'Loghound: ' . $core . ': ' . $probe['message'] . "\n");
            $failed = true;
            continue;
        }

        $result = $quota->trim($solr, $core, $field, [
            'dry_run'  => $dryRun,
            'extra_fq' => $extraFq,
            'logger'   => static function (string $m): void {
                fwrite(STDOUT, '  ' . $m . "\n");
            },
        ]);

        fwrite(STDOUT, sprintf(
            "Plan window for %s: %s — %s\n",
            $core,
            $result['state'],
            $result['message']
        ));

        foreach ($result['steps'] ?? [] as $step) {
            fwrite(STDOUT, sprintf(
                "  step %s%s%s\n",
                (string) $step['state'],
                isset($step['cutoff']) ? ' cutoff=' . $step['cutoff'] : '',
                isset($step['docs'])
                    ? ' docs=' . $step['docs']
                    : (isset($step['why']) ? ' (' . $step['why'] . ')' : '')
            ));
        }

        if (($result['state'] ?? '') === 'failed') {
            $failed = true;
        }
    }

    $quota->flush();
    return $failed;
}

/**
 * Purge the local SQLite state that grows without a bound of its own.
 *
 * Four stores, each with a different reason to be bounded:
 *
 *   - the geo/ASN/rDNS caches keep an entry per address and per netblock, including negative
 *     entries for addresses that resolved to nothing; on a scanned server that is unbounded
 *     and most of it has expired long ago;
 *   - closed sessions stay in `sessions_open` after the scorer has written them to Solr, so
 *     a late beacon can still be matched to one — a day is far longer than that window;
 *   - merged beacon payloads are the same story, and they hold client-supplied text;
 *   - rate-limit buckets accumulate one row per address that ever hit the collector.
 *
 * None of this is an error path: State's purge methods exist and are correct, they simply
 * had no caller anywhere in the project. Failure is reported and swallowed — a locked or
 * read-only state database is not a reason to fail a run whose real work is done.
 *
 * The store is located relative to the CONFIG rather than to this script, which is what
 * \Loghound\Quota and \Loghound\Setup\Detector both do. Deriving it from the script's own
 * directory would mean that a run pointed at another installation's config purged this
 * installation's state.
 */
function purgeLocalState(Config $cfg, bool $dryRun): void
{
    $path = dirname($cfg->path(), 2) . '/var/state.db';
    if (!is_file($path)) {
        return;
    }
    if (!class_exists('\\Loghound\\State')) {
        return;
    }
    if ($dryRun) {
        fwrite(STDOUT, "Local state: would purge expired caches, closed sessions, merged beacons and rate limits.\n");
        return;
    }

    try {
        $state = new \Loghound\State($path);

        $cacheDays = max(
            (int) $cfg->get('enrich.geo_ttl_days', 30),
            (int) $cfg->get('enrich.asn_ttl_days', 30),
            (int) $cfg->get('enrich.rdns_ttl_days', 7)
        );

        $expired  = $state->cachePurgeExpired();
        $sessions = $state->purgeClosedSessions(86400);
        $beacons  = $state->purgeBeacons(86400);
        $limits   = $state->purgeRateLimits(3600);

        $state->close();

        fwrite(STDOUT, sprintf(
            "Local state: %d expired cache row(s) (TTL up to %d days), %d closed session(s), "
            . "%d merged beacon(s), %d rate-limit bucket(s).\n",
            $expired,
            $cacheDays,
            $sessions,
            $beacons,
            $limits
        ));
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Loghound: local state purge failed: ' . $e->getMessage() . "\n");
    }
}
