#!/usr/bin/env php
<?php
/**
 * Loghound — periodic scorer (SPEC §5, second half).
 *
 * Run every 60 seconds by loghound-score.timer. One pass does, in order:
 *
 *   1. Close sessions that have been idle past the timeout, and collect the OPEN sessions
 *      whose aggregate has advanced since they were last published.
 *   2. Merge staged beacon rows into those sessions.
 *   3. Compute fp_ips_24h_i for every distinct fingerprint in the batch, in as few Solr
 *      queries as possible.
 *   4. Run the ruleset — open sessions under the provisional gate.
 *   5. Upsert the session documents.
 *   6. Recompute the daily rollup, over settled sessions only, for every day the CLOSED
 *      half of the batch touched.
 *
 * ---------------------------------------------------------------------------------
 * WHY OPEN SESSIONS ARE PUBLISHED AT ALL
 * ---------------------------------------------------------------------------------
 * Because otherwise the product looks broken for half an hour after it is installed, and that
 * is not a charting problem — it is the defect that makes everything else look missing. A
 * session is only scored when it CLOSES, and it closes after ingest.session_idle_sec of silence
 * (1800 by default). Every panel view except Performance reads the sessions core. So on a fresh
 * install with ingestion working perfectly, the hits core fills up, the sessions core stays
 * empty, and every single view reports zero — while the operator browses their own site to
 * check that it works.
 *
 * So each open session also gets a document, at its own id, marked provisional_b (SPEC §4.2),
 * rewritten whenever it has new hits, and REPLACED by the final document when the session
 * closes. Three things make that safe rather than merely fast, and each is documented where it
 * happens: the id is the session id so a close overwrites instead of duplicating
 * (buildSessionDoc); the verdict is deliberately weakened so a provisional session can never
 * claim to be human (Score\Rules::DEFERRED_CODES and PROVISIONAL_FLOOR); and the daily rollups
 * exclude provisional documents so a historical total can never absorb a partial one
 * (computeRollup). The cost is bounded by PROVISIONAL_BATCH and by dirty tracking in
 * State::listDirtyOpenSessions().
 *
 * Staged beacon rows are merged onto a provisional document but NOT marked merged — they are
 * consumed only when the session closes. Marking them on a provisional run would hand the
 * execution plane to a document that is about to be overwritten and lose it permanently, since
 * there is no second copy of it anywhere. Beacon::mergeIntoSession() recomputes from the row
 * set every time and holds no state, so merging the same rows twice is exact.
 *
 * Everything except steps 3 and 5–6 is local: the session aggregate was accumulated in
 * SQLite while the session was open, so the scorer does not re-read the hits core to find
 * out what happened. See src/Sessionizer.php for why that is the only design that scales.
 *
 * Exit codes: 0 success, 1 configuration error, 2 runtime failure.
 *
 * The script refuses to run under a web SAPI at all: a daemon script reachable over HTTP
 * would be an unauthenticated way to trigger Solr writes. Nothing should ever place bin/
 * inside a document root, but it refuses anyway.
 *
 * ---------------------------------------------------------------------------------
 * DEPENDENCIES, AND HOW TOLERANTLY EACH IS TREATED
 * ---------------------------------------------------------------------------------
 * A missing Beacon degrades the run to the log plane only, which is a legitimate
 * deployment — SPEC §8's detection ladder works without the beacon, and a beacon that
 * cannot initialise must not stop the log plane from being scored. A missing State is
 * fatal, because without the open-session table there is nothing to score. State measures
 * idleness in epoch milliseconds.
 *
 * ---------------------------------------------------------------------------------
 * STEP 2 — MERGING THE BEACON
 * ---------------------------------------------------------------------------------
 * Beacon::mergeIntoSession() takes the SESSION DOCUMENT, in Solr field names, plus the
 * staged rows, and returns the document with the execution-plane fields merged in. So the
 * document is built first and the verdict fields are added after scoring. The merge needs
 * tz_s on the document to compute tz_match_b, which is why the identity fields have to be
 * there before it rather than after. Rows are matched on session id first, falling back to
 * the client key for a beacon that arrived before the tailer had issued an id (SPEC §6.4).
 * A merge failure loses the execution plane for one session; it must not lose the session,
 * because the log plane still has something to say about it.
 *
 * Two flags gate rules that would otherwise measure the SERVER's configuration and blame
 * the client, and both are computed from evidence rather than from configuration.
 *
 * `beacon_deployed` asks whether the execution plane is actually live on this site. It
 * gates no_js_on_html, which is worth 70 points and would otherwise fire on EVERY visitor
 * of a site that never installed the beacon. The beacon must be enabled AND at least one
 * session in this batch must have reported: config says what the operator intended,
 * evidence says what is true, and only the second is safe to score on. The failure mode is
 * deliberately conservative — on a quiet minute containing only bot sessions, nothing
 * reports, the flag is false and the rule does not fire. We under-detect rather than
 * mislabel a human, which is always the right direction here.
 *
 * `site_sends_304` asks whether the site supports conditional requests at all, and gates
 * no_304_on_repeat the same way. A 304 requires the SERVER to send an ETag or
 * Last-Modified; without one the browser cannot make a conditional request and a full 200
 * is its only option. On a site that serves static files with no validators, the naive rule
 * fires on four of the five real human sessions in
 * tests/fixtures/apache_combined_human.log, which came from exactly such a site. So the
 * flag requires at least one session in the batch to have received a 304, proving
 * conditional requests work here; when nothing in the batch did, the rule stays silent
 * rather than accusing everyone.
 *
 * ---------------------------------------------------------------------------------
 * STEP 3 — FINGERPRINT CLUSTERING (fp_ips_24h_i)
 * ---------------------------------------------------------------------------------
 * SPEC §5 step 3 asks for "one JSON Facet query per distinct fingerprint in the batch".
 * This does better: ONE query per time bucket, faceting on all the fingerprints in that
 * bucket at once. A run closing 5,000 sessions issues a handful of queries instead of
 * thousands, and the answer is identical — a terms facet on fp_hash_s with unique(ip_s)
 * under it returns the per-fingerprint counts in a single response. Fingerprints are
 * chunked well below termsFilter's cap of 512 values, so the generated filter also stays
 * comfortably inside maxBooleanClauses.
 *
 * The window: SPEC says ±12h around the session. Sessions are bucketed by the hour they
 * ended and the whole bucket shares one window of [bucketStart-12h, bucketStart+13h], at
 * most one hour wider than the exact per-session window. In normal operation every session
 * in a run lands in the same bucket, so the approximation is invisible; on a backlog replay
 * it can only ever include slightly MORE neighbouring traffic, never less, and the effect
 * on a >=5 threshold is negligible. Documented rather than hidden.
 *
 * A SHARED PAIR OF INDEXES WIDENS THIS COUNT, AND THAT IS THE CHOICE, NOT AN OVERSIGHT. When
 * several installations write into one pair, the facet below spans every site in it, so a
 * fingerprint seen from three addresses on one site and three on another counts as six rather
 * than as two separate threes. That is what `fp_cluster_proxy_fleet` is for: a rotating fleet
 * working through an operator's sites in turn is precisely the pattern that is invisible from
 * inside any one of them, and scoping the count per host or per installation would hide the
 * only case where cross-site correlation adds anything. It does mean the rule is more likely
 * to fire on a shared pair than on a private one — a NAT gateway shared by visitors to several
 * of the operator's sites reaches five addresses sooner — which is why it is worth 45 points
 * and designed to be corroborated rather than decisive alone.
 *
 * unique() is an approximation above about 100 values by default, which is fine here: the
 * rule asks "is this at least 5", and the approximation is exact well below that. If Solr
 * is unreachable, every fingerprint in the chunk stays UNKNOWN (null), which makes
 * fp_cluster_proxy_fleet decline to fire rather than assume a count of 1 —
 * under-detecting during an outage is correct, inventing a number is not.
 *
 * ---------------------------------------------------------------------------------
 * STEPS 4 AND 5 — SCORE AND UPSERT
 * ---------------------------------------------------------------------------------
 * Fingerprint counts are read with array_key_exists rather than ??, because a fingerprint
 * we looked up and could not resolve is present with a null value and that null must
 * survive as "unknown". The document doubles as the beacon-signal source:
 * Beacon::mergeIntoSession() writes the execution-plane fields onto it under their Solr
 * names, which are exactly the names Signals::fromSession() reads. A LogicException from
 * the ruleset means it produced an unexplainable verdict, which SPEC §1 calls a bug, so the
 * session is skipped rather than written with a verdict nobody can defend, and the failure
 * is made loud.
 *
 * Upserts are chunked so that one oversized POST cannot be rejected wholesale by a proxy in
 * front of Solr, and so a partial failure loses one chunk rather than the whole run. Staged
 * beacon rows are marked merged only AFTER the documents are safely in Solr: marking them
 * first would mean an indexing failure silently discarded the beacon data for those
 * sessions, and there is no second copy of it anywhere.
 *
 * ---------------------------------------------------------------------------------
 * STEP 6 — THE DAILY ROLLUP
 * ---------------------------------------------------------------------------------
 * SEVERAL INSTALLATIONS MAY WRITE THE SAME ROLLUP, and the recompute below is what makes that
 * safe rather than merely tolerable. When a pair of indexes is shared, every installation's
 * facet query covers every session document in the index — its own and the others' — so they
 * all compute the SAME numbers for a day and write the same document at the same deterministic
 * id. The last writer wins with a value identical to the one it replaced. An atomic increment,
 * which is the design this one deliberately rejects, would instead have each installation add
 * its own sessions to a shared counter and the day would be inflated by the number of writers.
 *
 * The rollup therefore carries NO `install_s`. It is a statement about the index, not about an
 * installation, and stamping a writer onto a document that several writers produce identically
 * would make the field flap between runs while meaning nothing.
 *
 * Recomputed from the sessions core rather than incremented. An atomic `inc` would be one
 * cheap call, and it would be WRONG: send() retries a request whose response was lost, and
 * a retried increment double-counts. Recomputing the whole day with one facet query is
 * idempotent, exact and self-healing — a run that crashed halfway is repaired by the next
 * one instead of leaving a permanently inflated counter. The previous day is recomputed too
 * when the run happens early in a UTC day, because the final minutes of a day are still
 * inside the 5-second soft-commit window when that day's last run executes. A failed rollup
 * is a reporting gap, not a data loss: the sessions behind it are already indexed and the
 * next run rebuilds the same day from scratch.
 *
 * @package Loghound
 * @license MIT
 */

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

require __DIR__ . '/../src/autoload.php';

/**
 * Maximum provisional documents one run publishes.
 *
 * This is the cost bound on the whole feature. Combined with the dirty tracking in
 * State::listDirtyOpenSessions() — a session is republished only after it has logged a new hit —
 * it means the provisional half of a run costs at most one extra 500-document POST and a couple
 * of extra fingerprint facet chunks, whatever the open-session population happens to be.
 *
 * Five hundred, matching the closed-session batch, so the worst case for a run is symmetric and
 * one number describes both halves. A site producing more than 500 newly-active sessions per
 * minute will see its provisional documents lag; those sessions still get their final document
 * the moment they close, which is the number that has to be right.
 */
const PROVISIONAL_BATCH = 500;

/**
 * The filter that restricts a query to sessions that have ENDED.
 *
 * Expressed as a NEGATION rather than `provisional_b:false`, and that is load-bearing: the field
 * is written only as true and is absent on every settled document, including every session
 * indexed before it existed. `provisional_b:false` would match nothing and quietly empty the
 * rollups. Panel\Query carries the same constant for the dashboard side of the contract.
 */
const SETTLED_SESSIONS = '-provisional_b:true';

use Loghound\Config;
use Loghound\Score\Rules;
use Loghound\Score\Signals;
use Loghound\Sessionizer;
use Loghound\Solr;

$root       = dirname(__DIR__);
$configPath = getenv('LOGHOUND_CONFIG') ?: $root . '/config/loghound.php';
$verbose    = in_array('-v', $argv, true) || in_array('--verbose', $argv, true);

/**
 * Write a line to stderr.
 *
 * stderr rather than stdout so systemd's journal keeps it separate from anything a future
 * --json mode might print, and so a cron wrapper can redirect the two differently.
 */
$log = static function (string $msg) use ($verbose): void {
    if ($verbose) {
        fwrite(STDERR, '[' . gmdate('Y-m-d H:i:s') . '] ' . $msg . "\n");
    }
};

$cfg = Config::load($configPath);
$errors = $cfg->validate();
if ($errors !== []) {
    fwrite(STDERR, "Loghound: configuration is not usable:\n  - " . implode("\n  - ", $errors) . "\n");
    exit(1);
}

$all         = $cfg->all();
$hitsCore    = (string) $cfg->get('solr.hits_core');
$sessionCore = (string) $cfg->get('solr.sessions_core');

/**
 * This installation's own id, stamped onto every session document it writes.
 *
 * A pair of indexes may be shared by several installations on different machines, some
 * contributing a log plane and some only a beacon. `install_s` is what makes a destructive
 * operation scopeable to the documents this installation actually wrote, and it is the only
 * thing in the data model that distinguishes writers. It is NOT a filter the panel applies:
 * the whole point of a shared pair is that one dashboard shows every site in it, told apart
 * by `host_s`.
 *
 * Validated to the same shape Config::coreName() demands, so a hand-edited configuration
 * cannot put an arbitrary string into a field that delete queries are built from.
 */
$installId = (string) $cfg->get('solr.install_id', '');
$installId = preg_match('/^[a-f0-9]{4,32}$/D', $installId) === 1 ? $installId : '';

try {
    $solr = new Solr((array) $cfg->get('solr', []));
    $rules = new Rules((array) $cfg->get('scoring', []));
} catch (\Throwable $e) {
    fwrite(STDERR, 'Loghound: ' . $e->getMessage() . "\n");
    exit(1);
}

$statePath = $root . '/var/state.db';

if (!class_exists('\\Loghound\\State')) {
    fwrite(STDERR, "Loghound: src/State.php is not available; cannot read open sessions.\n");
    exit(2);
}

try {
    $state = new \Loghound\State($statePath);
} catch (\Throwable $e) {
    fwrite(STDERR, 'Loghound: cannot open state database: ' . $e->getMessage() . "\n");
    exit(2);
}

$beaconMerger = null;
if ((bool) $cfg->get('beacon.enabled') && class_exists('\\Loghound\\Beacon')) {
    try {
        $beaconMerger = new \Loghound\Beacon($cfg);
    } catch (\Throwable $e) {
        $log('beacon merge unavailable: ' . $e->getMessage());
    }
}

$sessionizer = new Sessionizer($state, $all);
$now = time();

try {
    $closed = $sessionizer->closeIdle($now * 1000);
} catch (\Throwable $e) {
    fwrite(STDERR, 'Loghound: closing idle sessions failed: ' . $e->getMessage() . "\n");
    exit(2);
}

try {
    $open = $sessionizer->listOpen(PROVISIONAL_BATCH);
} catch (\Throwable $e) {
    $log('listing open sessions failed: ' . $e->getMessage());
    $open = [];
}

if ($closed === [] && $open === []) {
    $log('nothing to score');
    exit(0);
}
$log('closed ' . count($closed) . ' session(s), ' . count($open) . ' still open');

/** @var array<string,bool> session id => true when the session is still open. */
$isProvisional = [];
foreach ($open as $session) {
    $isProvisional[(string) $session['session_id']] = true;
}

/** @var array<int,array<string,mixed>> Both batches, in one list, scored in one pass. */
$batch = array_merge($closed, $open);

$docs      = [];
$mergedIds = [];

/**
 * Beacon-minted session ids whose staged rows turned out to belong to a log-backed session
 * after all, and which may therefore have a standalone document of their own to remove.
 *
 * Narrowed twice, because a delete-by-query per beaconed session per run would be real cost for
 * an answer that is almost always "nothing there". Only rows the collector recorded a HOSTNAME
 * on can ever have become a standalone document, and only a session that has CLOSED is looking
 * at its rows for the last time — so the set is at most one entry per settled session on an
 * allowlisted host, which is the same order as the upsert it rides in front of.
 *
 * @var array<string,bool>
 */
$superseded = [];

foreach ($batch as $session) {
    $sid = (string) $session['session_id'];
    $provisional = isset($isProvisional[$sid]);

    $doc = buildSessionDoc($session, $provisional);

    if ($beaconMerger !== null) {
        try {
            $rows = $state->beaconsFor($sid, (string) ($session['client_key'] ?? ''));
            if (!$provisional || $rows !== []) {
                $doc = $beaconMerger->mergeIntoSession($doc, $rows);
            }
            if (!$provisional) {
                foreach ($rows as $row) {
                    if (isset($row['id'])) {
                        $mergedIds[] = (int) $row['id'];
                    }
                }
                foreach ($rows as $row) {
                    $staged  = (string) ($row['session_id'] ?? '');
                    $payload = isset($row['payload']) && is_array($row['payload']) ? $row['payload'] : [];
                    if ($staged !== $sid
                        && (string) ($payload['host'] ?? '') !== ''
                        && preg_match(\Loghound\Beacon::PROVISIONAL_ID, $staged) === 1) {
                        $superseded[$staged] = true;
                    }
                }
            }
        } catch (\Throwable $e) {
            $log('beacon merge failed for ' . $sid . ': ' . $e->getMessage());
        }
    }

    $doc['planes_s'] = !empty($doc['beacon_b']) ? 'log_beacon' : 'log_only';

    $docs[$sid] = $doc;
}

/*
 * ---------------------------------------------------------------------------------
 * STEP 2b — STANDALONE SESSIONS
 * ---------------------------------------------------------------------------------
 * A beacon on a host this installation has no access log for. There is no log line
 * coming, so nothing will ever claim these rows by client key, and merge-only would
 * mean the site is measured and never appears. They are published as sessions of their
 * own, at the id the collector minted, marked `planes_s:beacon_only`.
 *
 * THE THREE GATES, and a group has to pass all of them:
 *
 *   1. The collector recorded a hostname on the rows at all. It does that only when the
 *      hostname the page reported agreed with the Origin the browser set AND appeared on
 *      `beacon.allowed_hosts` (public/collect.php, lh_site()). A group with no hostname is
 *      an ordinary merge-only beacon and is left alone to be claimed or purged.
 *   2. No log source covers that hostname — hostHasLogSource(), derived from evidence.
 *   3. The beacon merger is available and the feature has somewhere to write.
 *
 * PROVISIONAL FIRST, SETTLED WHEN QUIET, exactly like an open log session and for the same
 * reason: a site whose sessions appeared only half an hour after the visit would look
 * broken to the person who just installed the snippet. A group whose newest row is younger
 * than the idle timeout is published provisional and its rows are left UNMERGED, so the
 * next run recomputes the whole group rather than accumulating; once it has gone quiet the
 * document is rewritten in final form at the same id and the rows are consumed.
 *
 * SUPERSESSION — the case that could duplicate. A host that is standalone today may gain a
 * log source tomorrow: the operator adds the vhost, or moves the site onto this machine.
 * From that moment both planes describe the same visit. Three things make that produce one
 * session rather than two. Gate 2 flips as soon as hits appear, so nothing new is promoted.
 * The staged rows of a visit in flight are claimed by the log session through the client
 * key, which is the mechanism that has always existed for a beacon that arrived before its
 * log line. And any PROVISIONAL standalone document already published for those rows is
 * deleted by id before this run indexes anything — `$superseded`, collected in the merge
 * loop above. History is untouched: a session that really was beacon-only when it happened
 * stays beacon-only, because a reconfiguration today is not evidence about last week.
 */
$standaloneCandidates = [];
if ($beaconMerger !== null && $beaconMerger->allowedHosts() !== []) {
    $covered = coveredHosts($solr, $hitsCore);
    if ($covered === null) {
        $log('standalone: host coverage unknown, publishing nothing this run');
    }

    $idleSeconds = \Loghound\Security::clampInt($cfg->get('ingest.session_idle_sec'), 60, 86400, 1800);

    /* BUILT ONCE FOR THE WHOLE RUN, not once per session: both enrichers cache through State,
       so an address seen twice costs one lookup, and the batch is bounded by
       PROVISIONAL_BATCH. Constructed exactly as Pipeline::initEnrichers() does, so the two
       planes derive geography the same way rather than by two similar-looking routes. */
    $enrichCfg = (array) $cfg->get('enrich', []);
    $standaloneGeo = null;
    $standaloneAsn = null;
    $standaloneRdns = (bool) $cfg->get('enrich.rdns_enabled', true);

    if (class_exists('\\Loghound\\Enrich\\Geo')) {
        try {
            $standaloneGeo = new \Loghound\Enrich\Geo(
                $enrichCfg,
                $state,
                (array) $cfg->get('opensolr', [])
            );
        } catch (\Throwable $e) {
            $log('standalone: geo enrichment unavailable: ' . $e->getMessage());
        }
    }
    if (class_exists('\\Loghound\\Enrich\\Asn')) {
        try {
            $standaloneAsn = new \Loghound\Enrich\Asn($enrichCfg, $state);
        } catch (\Throwable $e) {
            $log('standalone: ASN enrichment unavailable: ' . $e->getMessage());
        }
    }

    try {
        $groups = $state->unmergedBeaconGroups(PROVISIONAL_BATCH);
    } catch (\Throwable $e) {
        $log('standalone: listing beacon groups failed: ' . $e->getMessage());
        $groups = [];
    }

    foreach ($groups as $group) {
        $sid = (string) $group['session_id'];
        if (isset($docs[$sid]) || isset($superseded[$sid])) {
            continue;
        }
        if (preg_match(\Loghound\Beacon::PROVISIONAL_ID, $sid) !== 1) {
            continue;
        }

        try {
            $rows = $state->beaconsFor($sid, null);
        } catch (\Throwable $e) {
            $log('standalone: reading rows for ' . $sid . ' failed: ' . $e->getMessage());
            continue;
        }
        if ($rows === []) {
            continue;
        }

        $host = '';
        foreach ($rows as $row) {
            $payload = isset($row['payload']) && is_array($row['payload']) ? $row['payload'] : [];
            $host = \Loghound\Beacon::normaliseHost($payload['host'] ?? '');
            if ($host !== '') {
                break;
            }
        }
        if ($host === '' || hostHasLogSource($host, $covered)) {
            continue;
        }

        $clientKey = (string) $group['client_key'];
        $provisional = ((int) $group['last_ts']) > ($now - $idleSeconds);

        try {
            $doc = buildStandaloneDoc($rows, $clientKey, $host, $sid, $standaloneGeo, $standaloneAsn, $standaloneRdns);
            $doc = $beaconMerger->mergeIntoSession($doc, $rows);
        } catch (\Throwable $e) {
            $log('standalone: building ' . $sid . ' failed: ' . $e->getMessage());
            continue;
        }

        $doc['planes_s'] = 'beacon_only';
        if ($provisional) {
            $doc['provisional_b'] = true;
        } else {
            foreach ($rows as $row) {
                if (isset($row['id'])) {
                    $mergedIds[] = (int) $row['id'];
                }
            }
        }

        $docs[$sid] = $doc;
        if ($provisional) {
            $isProvisional[$sid] = true;
        }

        $standaloneCandidates[] = [
            'session_id'   => $sid,
            'client_key'   => $clientKey,
            'ts_start'     => (int) $group['first_ts'],
            'ts_end'       => (int) $group['last_ts'],
            'first'        => $doc,
            '_beacon_only' => true,
        ];
    }

    if ($standaloneCandidates !== []) {
        $batch = array_merge($batch, $standaloneCandidates);
        $log('standalone: ' . count($standaloneCandidates) . ' beacon-only session(s)');
    }
}

$beaconDeployed = false;
if ((bool) $cfg->get('beacon.enabled')) {
    foreach ($closed as $session) {
        if (!empty($docs[(string) $session['session_id']]['beacon_b'])) {
            $beaconDeployed = true;
            break;
        }
    }
}

$siteSends304 = false;
foreach ($closed as $session) {
    if (!empty($session['got_304'])) {
        $siteSends304 = true;
        break;
    }
}

/** @var array<string,int|null> fp_hash => distinct IP count, or null when unknown. */
$fpCounts = [];

/** @var array<int,array<string,bool>> hour bucket => set of fingerprints */
$buckets = [];
foreach ($batch as $session) {
    $fp = (string) (($session['first']['fp_hash_s'] ?? '') ?: '');
    if ($fp === '') {
        continue;
    }
    $bucket = (int) (floor(((int) $session['ts_end']) / 3600) * 3600);
    $buckets[$bucket][$fp] = true;
}

foreach ($buckets as $bucketStart => $fpSet) {
    $hashes = array_keys($fpSet);

    foreach (array_chunk($hashes, 200) as $chunk) {
        $from = gmdate('Y-m-d\TH:i:s\Z', $bucketStart - 12 * 3600);
        $to   = gmdate('Y-m-d\TH:i:s\Z', $bucketStart + 13 * 3600);

        try {
            $res = $solr->jsonFacet(
                $hitsCore,
                [
                    'q'  => '*:*',
                    'fq' => [
                        Solr::termsFilter('fp_hash_s', $chunk),
                        Solr::rangeFilter('ts', $from, $to),
                    ],
                ],
                [
                    'by_fp' => [
                        'type'     => 'terms',
                        'field'    => 'fp_hash_s',
                        'limit'    => count($chunk),
                        'mincount' => 1,
                        'facet'    => [
                            'ips' => 'unique(ip_s)',
                        ],
                    ],
                ]
            );

            foreach (($res['facets']['by_fp']['buckets'] ?? []) as $b) {
                $fpCounts[(string) $b['val']] = (int) ($b['ips'] ?? 0);
            }
        } catch (\Throwable $e) {
            $log('fingerprint facet failed: ' . $e->getMessage());
            foreach ($chunk as $fp) {
                $fpCounts[$fp] = null;
            }
        }
    }
}

$ready = [];
$days  = [];

/** @var array<int,array<string,mixed>> Open sessions whose document made it into the batch. */
$publishedOpen = [];

foreach ($batch as $session) {
    $sid = (string) $session['session_id'];
    $fp  = (string) ($session['first']['fp_hash_s'] ?? '');
    $provisional = isset($isProvisional[$sid]);
    $doc = $docs[$sid] ?? buildSessionDoc($session, $provisional);

    $fpIps = array_key_exists($fp, $fpCounts) ? $fpCounts[$fp] : null;
    if ($fpIps !== null) {
        $doc['fp_ips_24h_i'] = $fpIps;
    }

    $signals = Signals::fromSession($session, $doc, $fpIps);

    try {
        $verdict = $rules->score($signals, [
            'beacon_deployed' => $beaconDeployed,
            'site_sends_304'  => $siteSends304,
            'provisional'     => $provisional,
            'no_transport'    => !empty($session['_beacon_only']),
        ]);
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Loghound: scoring failed for session ' . $sid . ': ' . $e->getMessage() . "\n");
        continue;
    }

    $doc['bot_score_f']    = (float) $verdict['score'];
    $doc['bot_verdict_s']  = (string) $verdict['verdict'];
    $doc['bot_reasons_ss'] = array_values($verdict['reasons']);
    $doc['bot_class_s']    = (string) $verdict['class'];
    $doc['rule_version_i'] = (int) $verdict['rule_version'];

    if ($installId !== '') {
        $doc['install_s'] = $installId;
    }

    /*
     * THE LAST GATE BEFORE SOLR, AND IT IS NOT A DUPLICATE OF THE ONE AT INGEST.
     *
     * The tailer refuses a loopback or RFC1918 request as it is read, so nothing new is
     * captured. But state captured BEFORE that refusal existed is still in SQLite — sessions
     * already open in `sessions_open`, beacon rows already staged — and every one of them is
     * published when the session closes or the rows merge. On this installation that was a
     * 2,040-hit session of local `/drupal/callback` traffic sitting open, which would have
     * reappeared as a private-address session the moment it went idle, hours after the
     * exclusion was supposedly complete.
     *
     * A refusal at the door is therefore not sufficient on its own: a queue drains after the
     * door is shut. This closes it at the point of publication, which is the only place that
     * sees every route in — log sessions, beacon merges and standalone beacon-only documents
     * alike — so no future path can reintroduce what the panel promises is not there.
     */
    if (\Loghound\Security::isPrivateAddress((string) ($doc['ip_net_s'] ?? ($doc['ip_s'] ?? '')))) {
        continue;
    }

    $ready[] = $doc;

    if ($provisional) {
        if (empty($session['_beacon_only'])) {
            $publishedOpen[] = $session;
        }
    } else {
        $days[gmdate('Y-m-d', (int) $session['ts_start'])] = true;
    }
}

$docs = $ready;

/*
 * Remove any standalone document whose visit turned out to have a log line behind it.
 *
 * BEFORE the upsert, not after: a run that indexed the log-backed session and then failed
 * would leave both documents in the index, and the duplicate is the thing this exists to
 * prevent. Deleting first means a failure leaves the OLD state — the standalone document
 * gone, the log-backed one arriving on the next run — which is a gap, not a double count.
 *
 * The ids are matched against Beacon::PROVISIONAL_ID before they are built into a filter, so
 * the literal is forty-one characters of `b` and lowercase hex and can carry nothing else.
 * Chunked so one filter stays far inside Solr::assertSafeFilter()'s length ceiling.
 */
if ($superseded !== []) {
    foreach (array_chunk(array_keys($superseded), 100) as $chunk) {
        $safe = array_values(array_filter(
            $chunk,
            static fn (string $id): bool => preg_match(\Loghound\Beacon::PROVISIONAL_ID, $id) === 1
        ));
        if ($safe === []) {
            continue;
        }
        try {
            $solr->deleteByQuery($sessionCore, 'id:(' . implode(' ', $safe) . ')');
            $log('superseded ' . count($safe) . ' standalone document(s) now covered by a log source');
        } catch (\Throwable $e) {
            $log('superseding standalone documents failed: ' . $e->getMessage());
        }
    }
}

if ($docs !== []) {
    try {
        foreach (array_chunk($docs, 500) as $chunk) {
            $solr->addDocs($sessionCore, $chunk, true);
        }
        $log('indexed ' . count($docs) . ' session document(s)');

        if ($mergedIds !== [] && method_exists($state, 'markBeaconsMerged')) {
            $state->markBeaconsMerged($mergedIds);
        }
        if ($publishedOpen !== []) {
            $sessionizer->markProvisional($publishedOpen);
        }
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Loghound: indexing sessions failed: ' . $e->getMessage() . "\n");
        exit(2);
    }
}

if ($closed !== [] && (int) gmdate('H', $now) < 2) {
    $days[gmdate('Y-m-d', $now - 86400)] = true;
}

foreach (array_keys($days) as $day) {
    try {
        $rollup = computeRollup($solr, $sessionCore, $day);
        $solr->addDocs($sessionCore, [$rollup], true);
        $log('rollup rebuilt for ' . $day);
    } catch (\Throwable $e) {
        $log('rollup for ' . $day . ' failed: ' . $e->getMessage());
    }
}

exit(0);


/**
 * Turn a session aggregate into the BASE Solr document.
 *
 * Base means: everything the log plane knows, and nothing else. The execution-plane fields
 * are added afterwards by Beacon::mergeIntoSession(), and the verdict fields after that by
 * the scoring loop. Keeping the three stages separate is what lets the beacon merge see a
 * document that already carries tz_s (which it needs to compute tz_match_b).
 *
 * The one rule that matters here: a field is written ONLY when it is known. SPEC §1 forbids
 * fabricating a metric, and the beacon timing fields in particular must be ABSENT rather
 * than zero when no beacon arrived — a zero would be averaged in as a measurement and would
 * drag every engagement number toward the floor.
 *
 * A handful of fields are present for every session, because they really are derived from
 * the log alone. beacon_b is one of them: it starts false and stays false unless a beacon
 * actually arrived, so a false here means "we looked and nothing came", which is exactly
 * what the no_js_on_html cross-check needs — and it is why the three timing fields stay
 * absent alongside it. The path list is already capped at 50 by Sessionizer, with
 * uniq_paths_i carrying the true count. Identity, network and client fields are lifted from
 * the first hit, and only those that actually exist: an enrichment that failed leaves its
 * field off the document. Internal parser metadata, `_logged` and friends, never goes to
 * Solr.
 *
 * THE ID IS THE SESSION ID, whether the session has ended or not, and that is the whole
 * mechanism behind provisional documents: a session published while open and republished when
 * it closes is one document at one id, so the final version REPLACES the partial one. Solr's
 * /update with a duplicate uniqueKey is a delete-and-add, not a merge, so the final document
 * is complete and carries nothing left over from the provisional one — which is why
 * provisional_b is written only as true and simply disappears on close. A session counted twice
 * would be worse than a session counted late, and this is the line that prevents it.
 *
 * @param array<string,mixed> $session     Aggregate from Sessionizer::closeIdle() or listOpen().
 * @param bool                $provisional True when the session is still open, so every count
 *                                         on the document is partial (SPEC §4.2).
 * @return array<string,mixed>
 */
function buildSessionDoc(array $session, bool $provisional = false): array
{
    $doc = [
        'id'         => (string) $session['session_id'],
        'doc_type_s' => 'session',

        'ts_start' => gmdate('Y-m-d\TH:i:s\Z', (int) $session['ts_start']),
        'ts_end'   => gmdate('Y-m-d\TH:i:s\Z', (int) $session['ts_end']),

        'hits_i'       => (int) $session['hits'],
        'pages_i'      => (int) $session['pages'],
        'assets_i'     => (int) $session['assets'],
        'uniq_paths_i' => (int) $session['uniq_paths'],
        'bytes_l'      => (int) $session['bytes'],

        'status_2xx_i' => (int) $session['st2'],
        'status_3xx_i' => (int) $session['st3'],
        'status_4xx_i' => (int) $session['st4'],
        'status_5xx_i' => (int) $session['st5'],
        'got_304_b'    => (bool) $session['got_304'],

        'log_span_ms_l'   => (int) $session['log_span_ms'],
        'gap_p50_ms_l'    => (int) $session['gap_p50_ms'],
        'gap_stddev_ms_l' => (int) $session['gap_stddev_ms'],
        'asset_ratio_f'   => (float) $session['asset_ratio'],

        'beacon_b' => false,
    ];

    if ($provisional) {
        $doc['provisional_b'] = true;
    }

    if (($session['entry_path'] ?? null) !== null) {
        $doc['entry_path_s'] = (string) $session['entry_path'];
    }
    if (($session['exit_path'] ?? null) !== null) {
        $doc['exit_path_s'] = (string) $session['exit_path'];
    }
    if (!empty($session['paths'])) {
        $doc['paths_ss'] = array_values($session['paths']);
    }

    /*
     * A SESSION THAT ASKED FOR SOMETHING MUST NAME WHAT IT ASKED FOR.
     *
     * The sessionizer records a landing PAGE, and only inside its `kind === 'html'` branch — so
     * a visitor that fetched nothing but /robots.txt, /sitemap.xml or a single image arrived
     * with entry_path AND exit_path both null, and every visit table printed a dash for the
     * page. On this installation that was 197 of 2,049 sessions: not an edge case, and the dash
     * reads as "we lost it" when the truth is "they never requested a page".
     *
     * The fallback is the first path the session actually touched, which paths_ss already holds
     * for exactly this reason. It is applied ONLY when there is no html landing page, so the
     * meaning of entry_path_s where a real page exists is untouched and the Pages and
     * Engagement views keep counting what they always counted; what changes is that a
     * robots.txt-only crawler now says `/robots.txt` instead of nothing.
     *
     * Sessions whose only hit was an asset still have no path at all — the sessionizer does not
     * track asset paths (isVisitedPath) — and those honestly have nothing to name.
     */
    if (!isset($doc['entry_path_s']) && !empty($doc['paths_ss'])) {
        $doc['entry_path_s'] = (string) $doc['paths_ss'][0];
    }

    /* AND IF EVEN THAT IS EMPTY, the session touched nothing the path list tracks — an
       asset-only visit, which is the last case that could still print a dash. The sessionizer
       now keeps the first path of ANY kind for exactly this, so the column can always name
       what was asked for. */
    if (!isset($doc['entry_path_s']) && ($session['first_path'] ?? null) !== null) {
        $doc['entry_path_s'] = (string) $session['first_path'];
    }
    if (!empty($session['terms'])) {
        $doc['search_terms_ss'] = array_values($session['terms']);
    }

    /* THE ATTACK SUMMARY, under the three-state rule that governs every optional field here.
       `hit_rules_i` is written whenever ANY hit in the session carried one, so the session says
       it was evaluated; `hit_flags_ss` is written only when something actually fired. A session
       assembled by a tailer that predates the detector carries neither, and Panel\Attacks counts
       it as unevaluated rather than as clean — which is the difference between "no attacks that
       week" and "the detector was not deployed that week". */
    if (($session['atk_rules'] ?? null) !== null) {
        $doc['hit_rules_i'] = (int) $session['atk_rules'];
    }
    if (!empty($session['atk_flags'])) {
        $doc['hit_flags_ss'] = array_values($session['atk_flags']);
    }

    foreach ((array) ($session['first'] ?? []) as $field => $value) {
        if (str_starts_with((string) $field, '_')) {
            continue;
        }
        $doc[$field] = $value;
    }

    return $doc;
}

/**
 * Build the BASE document for a STANDALONE session — a visit measured by the beacon alone.
 *
 * The counterpart of buildSessionDoc() for a host whose access log is not one of this
 * installation's sources. There is no aggregate, no log line and no transport plane: the only
 * evidence is the staged beacon rows, plus the facts the collector read off each of those
 * connections. Everything the execution plane knows is folded on afterwards by
 * Beacon::mergeIntoSession(), exactly as it is for a log-backed session, so there is one
 * definition of what the beacon contributes rather than two that can drift.
 *
 * WHAT IS DELIBERATELY NOT ON THIS DOCUMENT, and this is the important half of the function.
 * No `hits_i`, `pages_i`, `assets_i`, `bytes_l`, status counters, `got_304_b`, `asset_ratio_f`,
 * `log_span_ms_l` or gap statistics. Not zero — ABSENT. A zero in any of those is a
 * measurement, and a measurement nobody made is a fabrication: `asset_ratio_f: 0.0` would read
 * as "this client fetched only markup", which is a bot signal, on a visitor whose asset
 * fetching was never observable from here. SPEC §1 forbids exactly this. The scoring side is
 * defended separately, by Rules::TRANSPORT_CODES, because silence on the document and silence
 * in the ruleset are two different guarantees and this product needs both.
 *
 * `planes_s` is `beacon_only`, which is what every count that mixes populations splits on.
 *
 * WHAT IT DOES CARRY. The hostname the page reported, cross-checked against the browser's
 * Origin and against the operator's allowlist before the collector ever staged it — so the
 * session sits in the Virtual host dimension beside the hosts that come from log lines. The
 * address, under the configured privacy mode, exactly like a log hit. The network prefix,
 * recovered from the client key rather than recomputed, because the collector derived it from
 * the TRUE address before the privacy transform and the client key is where that already
 * lives. And the User-Agent, which the collector read off the connection and which
 * Enrich\Ua turns into browser, OS and device — a purely local parse with no lookup, so it
 * costs the run nothing.
 *
 * The times are the arrival times of the first and last staged row. They are the honest
 * answer: what the server knows is when the beacons reached it.
 *
 * @param array<int,array<string,mixed>> $rows      Staged rows, oldest first.
 * @param string                         $clientKey The group's client key, `ip_net|ua_hash`.
 * @param string                         $host      The hostname, already validated by the collector.
 * @return array<string,mixed>
 */
function buildStandaloneDoc(
    array $rows,
    string $clientKey,
    string $host,
    string $sessionId,
    ?object $geo = null,
    ?object $asn = null,
    bool $rdns = false
): array {
    $first = [];
    $last  = [];
    foreach ($rows as $row) {
        $payload = isset($row['payload']) && is_array($row['payload']) ? $row['payload'] : $row;
        if ($first === []) {
            $first = $payload;
        }
        $last = $payload;
    }

    $firstTs = (int) ($rows[0]['received_at'] ?? time());
    $lastTs  = (int) ($rows[count($rows) - 1]['received_at'] ?? $firstTs);

    $doc = [
        'id'         => $sessionId,
        'doc_type_s' => 'session',
        'ts_start'   => gmdate('Y-m-d\TH:i:s\Z', $firstTs),
        'ts_end'     => gmdate('Y-m-d\TH:i:s\Z', max($firstTs, $lastTs)),
        'host_s'     => $host,
        'planes_s'   => 'beacon_only',
        'beacon_b'   => false,
    ];

    $ip = (string) ($first['ip'] ?? '');
    if ($ip !== '') {
        $doc['ip_s'] = $ip;

        /* ENRICHED HERE TOO, OR A BEACON-ONLY SITE HAS NO GEOGRAPHY AT ALL. The log pipeline
           enriches every hit in Pipeline::process(); this path never did, so a site measured by
           the beacon alone was published with an address and nothing derived from it — absent
           from the map, from the countries table, from every network dimension, and showing a
           bare dash where every other session shows a flag. The address was there the whole
           time; only the lookup was missing.

           Failures are silent and leave the field absent, exactly as on the log path: geography
           is an enrichment, and a session is still a session without it. */
        foreach ([[$geo, 'lookup'], [$asn, 'lookup'], [$rdns ? $asn : null, 'rdns']] as [$source, $method]) {
            if ($source === null) {
                continue;
            }
            try {
                $fields = $source->{$method}($ip);
            } catch (\Throwable $e) {
                continue;
            }
            if (!is_array($fields)) {
                continue;
            }
            foreach ($fields as $field => $value) {
                if ($value !== null && $value !== '' && !isset($doc[$field])) {
                    $doc[$field] = $value;
                }
            }
        }
    }

    $net = strstr($clientKey, '|', true);
    if (is_string($net) && $net !== '' && $net !== '-') {
        $doc['ip_net_s'] = $net;
        $doc['ip_ver_i'] = str_contains($net, ':') ? 6 : 4;
    }

    $ua = (string) ($last['ua'] ?? ($first['ua'] ?? ''));
    if ($ua !== '' && class_exists('\\Loghound\\Enrich\\Ua')) {
        $doc['ua_s'] = $ua;
        foreach (\Loghound\Enrich\Ua::parse($ua)->fields() as $field => $value) {
            if ($value !== null && $value !== '') {
                $doc[$field] = $value;
            }
        }
    }
    if (!isset($doc['ua_hash_s']) && isset($first['ua_hash']) && is_string($first['ua_hash'])) {
        $doc['ua_hash_s'] = $first['ua_hash'];
    }

    $paths = [];
    foreach ($rows as $row) {
        $payload = isset($row['payload']) && is_array($row['payload']) ? $row['payload'] : $row;
        $path = (string) ($payload['path'] ?? '');
        if ($path !== '' && !isset($paths[$path]) && count($paths) < 50) {
            $paths[$path] = true;
        }
    }
    if ($paths !== []) {
        $doc['paths_ss']     = array_keys($paths);
        $doc['uniq_paths_i'] = count($paths);
        $doc['entry_path_s'] = (string) array_key_first($paths);
        $doc['exit_path_s']  = (string) ($last['path'] ?? array_key_first($paths));
    }

    return $doc;
}

/**
 * Is this hostname already covered by a log source in this installation?
 *
 * THE MODE DECISION, and it is derived rather than configured. `beacon.allowed_hosts` says
 * which hosts may report at all; this says which of those already have a transport plane here.
 * A host in both is MERGE mode — today's behaviour exactly, the log is the authority on facts
 * and the beacon on time, and the staged rows are claimed by client key the moment the tailer
 * opens a session. A host only in the allowlist is STANDALONE mode. Asking the operator to
 * declare the mode as well would be asking them to restate, in a second place, something the
 * system can observe, and the two would drift the first time a site moved.
 *
 * EVIDENCE, NOT CONFIGURATION, for the same reason `beacon_deployed` and `site_sends_304` are:
 * configuration says what somebody intended and evidence says what is true, and only the
 * second is safe to act on. A source may name its vhost explicitly, or take it from `%v` in a
 * format that serves fifty of them, so the configured `sources` list simply does not know the
 * answer. One terms facet on `host_s` over the recent hits does.
 *
 * The window is seven days, which is long enough that a quiet weekend on a low-traffic vhost
 * does not make it look uncovered, and short enough that a site REMOVED from the log sources a
 * month ago is correctly treated as standalone again.
 *
 * FAILS CLOSED. If Solr cannot be reached the answer is "covered", so nothing is published as
 * standalone during an outage. The cost of that is a delay: the beacons stay staged, unmerged,
 * and the next healthy run publishes them. The cost of the other direction would be a
 * duplicate session for every visit during the outage, published as single-plane and with its
 * log-backed twin arriving later — and there is no undo for that.
 *
 * Answered once per run for the whole batch, because it is one query whatever the number of
 * candidates.
 *
 * @param array<string,bool>|null $covered Resolved host set, or null when Solr failed.
 */
function hostHasLogSource(string $host, ?array $covered): bool
{
    if ($covered === null) {
        return true;
    }
    return isset($covered[$host]);
}

/**
 * The set of virtual hosts this installation has actually ingested log lines for.
 *
 * One terms facet, capped. The cap is generous rather than unbounded: a machine with more
 * virtual hosts than this has a different problem, and an unbounded terms facet on a string
 * field is a way to ask Solr for every distinct value it has ever seen.
 *
 * @return array<string,bool>|null Null when the query failed, which callers read as "assume
 *                                 covered" — see hostHasLogSource().
 */
function coveredHosts(Solr $solr, string $hitsCore): ?array
{
    try {
        $res = $solr->jsonFacet(
            $hitsCore,
            [
                'q'  => '*:*',
                'fq' => ['ts:[NOW-7DAYS TO NOW]'],
                'rows' => 0,
            ],
            ['hosts' => ['type' => 'terms', 'field' => 'host_s', 'limit' => 500, 'mincount' => 1]]
        );
    } catch (\Throwable $e) {
        return null;
    }

    $buckets = $res['facets']['hosts']['buckets'] ?? null;
    if (!is_array($buckets)) {
        return null;
    }

    $out = [];
    foreach ($buckets as $bucket) {
        $val = \Loghound\Beacon::normaliseHost($bucket['val'] ?? '');
        if ($val !== '') {
            $out[$val] = true;
        }
    }
    return $out;
}

/**
 * Rebuild the daily rollup document for one UTC day.
 *
 * Every number here is an aggregate. Nothing in a rollup identifies a visitor, which is
 * what makes privacy.rollup_forever compatible with a 90-day retention policy: the
 * sessions behind it can be deleted while the shape of the traffic survives.
 *
 * SETTLED SESSIONS ONLY — SETTLED_SESSIONS is on the query and is not optional. An open
 * session has doc_type_s:session and a ts_start inside the day, so without that clause its
 * PARTIAL hit, page and byte counts and its FLOORED verdict would be folded into the day's
 * totals. Recomputing rather than incrementing means the same session is never counted twice
 * (it is one document at one id, open or closed), but it does not save the numbers from being
 * wrong while it is open: r_unknown_i would carry every live visitor and r_human_i would be
 * short by the same amount, on every rebuild, and the rollup is the one set of numbers in the
 * product that is meant to outlive the sessions behind it. The cost of the clause is that
 * TODAY's rollup lags by up to the idle timeout — which is what a settled daily aggregate IS.
 * The live picture comes from the session documents themselves.
 *
 * Nothing else is needed to keep the day correct: when a session that started on day D finally
 * closes, D goes back into the run's day set and the whole day is rebuilt from scratch, so the
 * session is counted exactly once, at its final values, on the day it started.
 *
 * r_beacon_sessions_i is written alongside the timing sums on purpose. A sum of engaged
 * milliseconds without the population it covers is uninterpretable, and presenting one
 * without the other is the exact mistake SPEC §10 forbids ("an unlabelled number is a lie").
 * For the same reason the timing sums are scoped to the population that actually has
 * timings.
 *
 * The id is deterministic, so a rebuild overwrites rather than duplicating, and ts_start is
 * set so that a rollup can be range-filtered with the same field as a session — which keeps
 * the dashboard's date handling to one code path.
 *
 * @return array<string,mixed>
 */
function computeRollup(Solr $solr, string $core, string $day): array
{
    $from = $day . 'T00:00:00Z';
    $to   = $day . 'T23:59:59.999Z';

    $res = $solr->jsonFacet(
        $core,
        [
            'q'  => '*:*',
            'fq' => [
                Solr::termFilter('doc_type_s', 'session'),
                SETTLED_SESSIONS,
                Solr::rangeFilter('ts_start', $from, $to),
            ],
        ],
        [
            'verdicts' => ['type' => 'terms', 'field' => 'bot_verdict_s', 'limit' => 10],
            'classes'  => ['type' => 'terms', 'field' => 'bot_class_s',   'limit' => 20],
            'hits'     => 'sum(hits_i)',
            'pages'    => 'sum(pages_i)',
            'bytes'    => 'sum(bytes_l)',
            'span'     => 'sum(log_span_ms_l)',
            'withbeacon' => [
                'type'  => 'query',
                'q'     => 'beacon_b:true',
                'facet' => [
                    'wall'    => 'sum(wall_ms_l)',
                    'visible' => 'sum(visible_ms_l)',
                    'engaged' => 'sum(engaged_ms_l)',
                ],
            ],
        ]
    );

    $facets = $res['facets'] ?? [];

    /** @var array<string,int> $verdicts */
    $verdicts = [];
    foreach (($facets['verdicts']['buckets'] ?? []) as $b) {
        $verdicts[(string) $b['val']] = (int) $b['count'];
    }
    /** @var array<string,int> $classes */
    $classes = [];
    foreach (($facets['classes']['buckets'] ?? []) as $b) {
        $classes[(string) $b['val']] = (int) $b['count'];
    }

    return [
        'id'         => 'rollup_daily:' . $day,
        'doc_type_s' => 'rollup_daily',
        'day_s'      => $day,
        'ts_start'   => $from,
        'ts_end'     => $to,

        'r_sessions_i' => (int) ($facets['count'] ?? 0),
        'r_hits_i'     => (int) ($facets['hits'] ?? 0),
        'r_pages_i'    => (int) ($facets['pages'] ?? 0),
        'r_bytes_l'    => (int) ($facets['bytes'] ?? 0),

        'r_human_i'        => $verdicts['human'] ?? 0,
        'r_likely_human_i' => $verdicts['likely_human'] ?? 0,
        'r_unknown_i'      => $verdicts['unknown'] ?? 0,
        'r_likely_bot_i'   => $verdicts['likely_bot'] ?? 0,
        'r_bot_i'          => $verdicts['bot'] ?? 0,

        'r_declared_crawler_i' => $classes['declared_crawler'] ?? 0,
        'r_ai_crawler_i'       => $classes['ai_crawler'] ?? 0,
        'r_headless_i'         => $classes['headless'] ?? 0,
        'r_scripted_i'         => $classes['scripted'] ?? 0,
        'r_proxy_fleet_i'      => $classes['proxy_fleet'] ?? 0,
        'r_spoofed_ua_i'       => $classes['spoofed_ua'] ?? 0,
        'r_monitor_i'          => $classes['monitor'] ?? 0,

        'r_beacon_sessions_i' => (int) ($facets['withbeacon']['count'] ?? 0),
        'r_wall_ms_sum_l'     => (int) ($facets['withbeacon']['wall'] ?? 0),
        'r_visible_ms_sum_l'  => (int) ($facets['withbeacon']['visible'] ?? 0),
        'r_engaged_ms_sum_l'  => (int) ($facets['withbeacon']['engaged'] ?? 0),
        'r_log_span_ms_sum_l' => (int) ($facets['span'] ?? 0),
    ];
}
