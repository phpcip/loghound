#!/usr/bin/env php
<?php
/**
 * Loghound — periodic scorer (SPEC §5, second half).
 *
 * Run every 60 seconds by loghound-score.timer. One pass does, in order:
 *
 *   1. Close sessions that have been idle past the timeout, and collect the OPEN sessions
 *      whose aggregate has advanced since they were last published.
 *   2. Merge staged beacon rows into those sessions.
 *   3. Compute fp_ips_24h_i for every distinct fingerprint in the batch, in as few Solr
 *      queries as possible.
 *   4. Run the ruleset — open sessions under the provisional gate.
 *   5. Upsert the session documents.
 *   6. Recompute the daily rollup, over settled sessions only, for every day the CLOSED
 *      half of the batch touched.
 *
 * ---------------------------------------------------------------------------------
 * WHY OPEN SESSIONS ARE PUBLISHED AT ALL
 * ---------------------------------------------------------------------------------
 * Because otherwise the product looks broken for half an hour after it is installed, and that
 * is not a charting problem — it is the defect that makes everything else look missing. A
 * session is only scored when it CLOSES, and it closes after ingest.session_idle_sec of silence
 * (1800 by default). Every panel view except Performance reads the sessions core. So on a fresh
 * install with ingestion working perfectly, the hits core fills up, the sessions core stays
 * empty, and every single view reports zero — while the operator browses their own site to
 * check that it works.
 *
 * So each open session also gets a document, at its own id, marked provisional_b (SPEC §4.2),
 * rewritten whenever it has new hits, and REPLACED by the final document when the session
 * closes. Three things make that safe rather than merely fast, and each is documented where it
 * happens: the id is the session id so a close overwrites instead of duplicating
 * (buildSessionDoc); the verdict is deliberately weakened so a provisional session can never
 * claim to be human (Score\Rules::DEFERRED_CODES and PROVISIONAL_FLOOR); and the daily rollups
 * exclude provisional documents so a historical total can never absorb a partial one
 * (computeRollup). The cost is bounded by PROVISIONAL_BATCH and by dirty tracking in
 * State::listDirtyOpenSessions().
 *
 * Staged beacon rows are merged onto a provisional document but NOT marked merged — they are
 * consumed only when the session closes. Marking them on a provisional run would hand the
 * execution plane to a document that is about to be overwritten and lose it permanently, since
 * there is no second copy of it anywhere. Beacon::mergeIntoSession() recomputes from the row
 * set every time and holds no state, so merging the same rows twice is exact.
 *
 * Everything except steps 3 and 5–6 is local: the session aggregate was accumulated in
 * SQLite while the session was open, so the scorer does not re-read the hits core to find
 * out what happened. See src/Sessionizer.php for why that is the only design that scales.
 *
 * Exit codes: 0 success, 1 configuration error, 2 runtime failure.
 *
 * The script refuses to run under a web SAPI at all: a daemon script reachable over HTTP
 * would be an unauthenticated way to trigger Solr writes. Nothing should ever place bin/
 * inside a document root, but it refuses anyway.
 *
 * ---------------------------------------------------------------------------------
 * DEPENDENCIES, AND HOW TOLERANTLY EACH IS TREATED
 * ---------------------------------------------------------------------------------
 * A missing Beacon degrades the run to the log plane only, which is a legitimate
 * deployment — SPEC §8's detection ladder works without the beacon, and a beacon that
 * cannot initialise must not stop the log plane from being scored. A missing State is
 * fatal, because without the open-session table there is nothing to score. State measures
 * idleness in epoch milliseconds.
 *
 * ---------------------------------------------------------------------------------
 * STEP 2 — MERGING THE BEACON
 * ---------------------------------------------------------------------------------
 * Beacon::mergeIntoSession() takes the SESSION DOCUMENT, in Solr field names, plus the
 * staged rows, and returns the document with the execution-plane fields merged in. So the
 * document is built first and the verdict fields are added after scoring. The merge needs
 * tz_s on the document to compute tz_match_b, which is why the identity fields have to be
 * there before it rather than after. Rows are matched on session id first, falling back to
 * the client key for a beacon that arrived before the tailer had issued an id (SPEC §6.4).
 * A merge failure loses the execution plane for one session; it must not lose the session,
 * because the log plane still has something to say about it.
 *
 * Two flags gate rules that would otherwise measure the SERVER's configuration and blame
 * the client, and both are computed from evidence rather than from configuration.
 *
 * `beacon_deployed` asks whether the execution plane is actually live on this site. It
 * gates no_js_on_html, which is worth 70 points and would otherwise fire on EVERY visitor
 * of a site that never installed the beacon. The beacon must be enabled AND at least one
 * session in this batch must have reported: config says what the operator intended,
 * evidence says what is true, and only the second is safe to score on. The failure mode is
 * deliberately conservative — on a quiet minute containing only bot sessions, nothing
 * reports, the flag is false and the rule does not fire. We under-detect rather than
 * mislabel a human, which is always the right direction here.
 *
 * `site_sends_304` asks whether the site supports conditional requests at all, and gates
 * no_304_on_repeat the same way. A 304 requires the SERVER to send an ETag or
 * Last-Modified; without one the browser cannot make a conditional request and a full 200
 * is its only option. On a site that serves static files with no validators, the naive rule
 * fires on four of the five real human sessions in
 * tests/fixtures/apache_combined_human.log, which came from exactly such a site. So the
 * flag requires at least one session in the batch to have received a 304, proving
 * conditional requests work here; when nothing in the batch did, the rule stays silent
 * rather than accusing everyone.
 *
 * ---------------------------------------------------------------------------------
 * STEP 3 — FINGERPRINT CLUSTERING (fp_ips_24h_i)
 * ---------------------------------------------------------------------------------
 * SPEC §5 step 3 asks for "one JSON Facet query per distinct fingerprint in the batch".
 * This does better: ONE query per time bucket, faceting on all the fingerprints in that
 * bucket at once. A run closing 5,000 sessions issues a handful of queries instead of
 * thousands, and the answer is identical — a terms facet on fp_hash_s with unique(ip_s)
 * under it returns the per-fingerprint counts in a single response. Fingerprints are
 * chunked well below termsFilter's cap of 512 values, so the generated filter also stays
 * comfortably inside maxBooleanClauses.
 *
 * The window: SPEC says ±12h around the session. Sessions are bucketed by the hour they
 * ended and the whole bucket shares one window of [bucketStart-12h, bucketStart+13h], at
 * most one hour wider than the exact per-session window. In normal operation every session
 * in a run lands in the same bucket, so the approximation is invisible; on a backlog replay
 * it can only ever include slightly MORE neighbouring traffic, never less, and the effect
 * on a >=5 threshold is negligible. Documented rather than hidden.
 *
 * unique() is an approximation above about 100 values by default, which is fine here: the
 * rule asks "is this at least 5", and the approximation is exact well below that. If Solr
 * is unreachable, every fingerprint in the chunk stays UNKNOWN (null), which makes
 * fp_cluster_proxy_fleet decline to fire rather than assume a count of 1 —
 * under-detecting during an outage is correct, inventing a number is not.
 *
 * ---------------------------------------------------------------------------------
 * STEPS 4 AND 5 — SCORE AND UPSERT
 * ---------------------------------------------------------------------------------
 * Fingerprint counts are read with array_key_exists rather than ??, because a fingerprint
 * we looked up and could not resolve is present with a null value and that null must
 * survive as "unknown". The document doubles as the beacon-signal source:
 * Beacon::mergeIntoSession() writes the execution-plane fields onto it under their Solr
 * names, which are exactly the names Signals::fromSession() reads. A LogicException from
 * the ruleset means it produced an unexplainable verdict, which SPEC §1 calls a bug, so the
 * session is skipped rather than written with a verdict nobody can defend, and the failure
 * is made loud.
 *
 * Upserts are chunked so that one oversized POST cannot be rejected wholesale by a proxy in
 * front of Solr, and so a partial failure loses one chunk rather than the whole run. Staged
 * beacon rows are marked merged only AFTER the documents are safely in Solr: marking them
 * first would mean an indexing failure silently discarded the beacon data for those
 * sessions, and there is no second copy of it anywhere.
 *
 * ---------------------------------------------------------------------------------
 * STEP 6 — THE DAILY ROLLUP
 * ---------------------------------------------------------------------------------
 * Recomputed from the sessions core rather than incremented. An atomic `inc` would be one
 * cheap call, and it would be WRONG: send() retries a request whose response was lost, and
 * a retried increment double-counts. Recomputing the whole day with one facet query is
 * idempotent, exact and self-healing — a run that crashed halfway is repaired by the next
 * one instead of leaving a permanently inflated counter. The previous day is recomputed too
 * when the run happens early in a UTC day, because the final minutes of a day are still
 * inside the 5-second soft-commit window when that day's last run executes. A failed rollup
 * is a reporting gap, not a data loss: the sessions behind it are already indexed and the
 * next run rebuilds the same day from scratch.
 *
 * @package Loghound
 * @license MIT
 */

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

require __DIR__ . '/../src/autoload.php';

/**
 * Maximum provisional documents one run publishes.
 *
 * This is the cost bound on the whole feature. Combined with the dirty tracking in
 * State::listDirtyOpenSessions() — a session is republished only after it has logged a new hit —
 * it means the provisional half of a run costs at most one extra 500-document POST and a couple
 * of extra fingerprint facet chunks, whatever the open-session population happens to be.
 *
 * Five hundred, matching the closed-session batch, so the worst case for a run is symmetric and
 * one number describes both halves. A site producing more than 500 newly-active sessions per
 * minute will see its provisional documents lag; those sessions still get their final document
 * the moment they close, which is the number that has to be right.
 */
const PROVISIONAL_BATCH = 500;

/**
 * The filter that restricts a query to sessions that have ENDED.
 *
 * Expressed as a NEGATION rather than `provisional_b:false`, and that is load-bearing: the field
 * is written only as true and is absent on every settled document, including every session
 * indexed before it existed. `provisional_b:false` would match nothing and quietly empty the
 * rollups. Panel\Query carries the same constant for the dashboard side of the contract.
 */
const SETTLED_SESSIONS = '-provisional_b:true';

use Loghound\Config;
use Loghound\Score\Rules;
use Loghound\Score\Signals;
use Loghound\Sessionizer;
use Loghound\Solr;

$root       = dirname(__DIR__);
$configPath = getenv('LOGHOUND_CONFIG') ?: $root . '/config/loghound.php';
$verbose    = in_array('-v', $argv, true) || in_array('--verbose', $argv, true);

/**
 * Write a line to stderr.
 *
 * stderr rather than stdout so systemd's journal keeps it separate from anything a future
 * --json mode might print, and so a cron wrapper can redirect the two differently.
 */
$log = static function (string $msg) use ($verbose): void {
    if ($verbose) {
        fwrite(STDERR, '[' . gmdate('Y-m-d H:i:s') . '] ' . $msg . "\n");
    }
};

$cfg = Config::load($configPath);
$errors = $cfg->validate();
if ($errors !== []) {
    fwrite(STDERR, "Loghound: configuration is not usable:\n  - " . implode("\n  - ", $errors) . "\n");
    exit(1);
}

$all         = $cfg->all();
$hitsCore    = (string) $cfg->get('solr.hits_core');
$sessionCore = (string) $cfg->get('solr.sessions_core');

try {
    $solr = new Solr((array) $cfg->get('solr', []));
    $rules = new Rules((array) $cfg->get('scoring', []));
} catch (\Throwable $e) {
    fwrite(STDERR, 'Loghound: ' . $e->getMessage() . "\n");
    exit(1);
}

$statePath = $root . '/var/state.db';

if (!class_exists('\\Loghound\\State')) {
    fwrite(STDERR, "Loghound: src/State.php is not available; cannot read open sessions.\n");
    exit(2);
}

try {
    $state = new \Loghound\State($statePath);
} catch (\Throwable $e) {
    fwrite(STDERR, 'Loghound: cannot open state database: ' . $e->getMessage() . "\n");
    exit(2);
}

$beaconMerger = null;
if ((bool) $cfg->get('beacon.enabled') && class_exists('\\Loghound\\Beacon')) {
    try {
        $beaconMerger = new \Loghound\Beacon($cfg);
    } catch (\Throwable $e) {
        $log('beacon merge unavailable: ' . $e->getMessage());
    }
}

$sessionizer = new Sessionizer($state, $all);
$now = time();

try {
    $closed = $sessionizer->closeIdle($now * 1000);
} catch (\Throwable $e) {
    fwrite(STDERR, 'Loghound: closing idle sessions failed: ' . $e->getMessage() . "\n");
    exit(2);
}

try {
    $open = $sessionizer->listOpen(PROVISIONAL_BATCH);
} catch (\Throwable $e) {
    $log('listing open sessions failed: ' . $e->getMessage());
    $open = [];
}

if ($closed === [] && $open === []) {
    $log('nothing to score');
    exit(0);
}
$log('closed ' . count($closed) . ' session(s), ' . count($open) . ' still open');

/** @var array<string,bool> session id => true when the session is still open. */
$isProvisional = [];
foreach ($open as $session) {
    $isProvisional[(string) $session['session_id']] = true;
}

/** @var array<int,array<string,mixed>> Both batches, in one list, scored in one pass. */
$batch = array_merge($closed, $open);

$docs      = [];
$mergedIds = [];

foreach ($batch as $session) {
    $sid = (string) $session['session_id'];
    $provisional = isset($isProvisional[$sid]);

    $doc = buildSessionDoc($session, $provisional);

    if ($beaconMerger !== null) {
        try {
            $rows = $state->beaconsFor($sid, (string) ($session['client_key'] ?? ''));
            if (!$provisional || $rows !== []) {
                $doc = $beaconMerger->mergeIntoSession($doc, $rows);
            }
            if (!$provisional) {
                foreach ($rows as $row) {
                    if (isset($row['id'])) {
                        $mergedIds[] = (int) $row['id'];
                    }
                }
            }
        } catch (\Throwable $e) {
            $log('beacon merge failed for ' . $sid . ': ' . $e->getMessage());
        }
    }

    $docs[$sid] = $doc;
}

$beaconDeployed = false;
if ((bool) $cfg->get('beacon.enabled')) {
    foreach ($closed as $session) {
        if (!empty($docs[(string) $session['session_id']]['beacon_b'])) {
            $beaconDeployed = true;
            break;
        }
    }
}

$siteSends304 = false;
foreach ($closed as $session) {
    if (!empty($session['got_304'])) {
        $siteSends304 = true;
        break;
    }
}

/** @var array<string,int|null> fp_hash => distinct IP count, or null when unknown. */
$fpCounts = [];

/** @var array<int,array<string,bool>> hour bucket => set of fingerprints */
$buckets = [];
foreach ($batch as $session) {
    $fp = (string) (($session['first']['fp_hash_s'] ?? '') ?: '');
    if ($fp === '') {
        continue;
    }
    $bucket = (int) (floor(((int) $session['ts_end']) / 3600) * 3600);
    $buckets[$bucket][$fp] = true;
}

foreach ($buckets as $bucketStart => $fpSet) {
    $hashes = array_keys($fpSet);

    foreach (array_chunk($hashes, 200) as $chunk) {
        $from = gmdate('Y-m-d\TH:i:s\Z', $bucketStart - 12 * 3600);
        $to   = gmdate('Y-m-d\TH:i:s\Z', $bucketStart + 13 * 3600);

        try {
            $res = $solr->jsonFacet(
                $hitsCore,
                [
                    'q'  => '*:*',
                    'fq' => [
                        Solr::termsFilter('fp_hash_s', $chunk),
                        Solr::rangeFilter('ts', $from, $to),
                    ],
                ],
                [
                    'by_fp' => [
                        'type'     => 'terms',
                        'field'    => 'fp_hash_s',
                        'limit'    => count($chunk),
                        'mincount' => 1,
                        'facet'    => [
                            'ips' => 'unique(ip_s)',
                        ],
                    ],
                ]
            );

            foreach (($res['facets']['by_fp']['buckets'] ?? []) as $b) {
                $fpCounts[(string) $b['val']] = (int) ($b['ips'] ?? 0);
            }
        } catch (\Throwable $e) {
            $log('fingerprint facet failed: ' . $e->getMessage());
            foreach ($chunk as $fp) {
                $fpCounts[$fp] = null;
            }
        }
    }
}

$ready = [];
$days  = [];

/** @var array<int,array<string,mixed>> Open sessions whose document made it into the batch. */
$publishedOpen = [];

foreach ($batch as $session) {
    $sid = (string) $session['session_id'];
    $fp  = (string) ($session['first']['fp_hash_s'] ?? '');
    $provisional = isset($isProvisional[$sid]);
    $doc = $docs[$sid] ?? buildSessionDoc($session, $provisional);

    $fpIps = array_key_exists($fp, $fpCounts) ? $fpCounts[$fp] : null;
    if ($fpIps !== null) {
        $doc['fp_ips_24h_i'] = $fpIps;
    }

    $signals = Signals::fromSession($session, $doc, $fpIps);

    try {
        $verdict = $rules->score($signals, [
            'beacon_deployed' => $beaconDeployed,
            'site_sends_304'  => $siteSends304,
            'provisional'     => $provisional,
        ]);
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Loghound: scoring failed for session ' . $sid . ': ' . $e->getMessage() . "\n");
        continue;
    }

    $doc['bot_score_f']    = (float) $verdict['score'];
    $doc['bot_verdict_s']  = (string) $verdict['verdict'];
    $doc['bot_reasons_ss'] = array_values($verdict['reasons']);
    $doc['bot_class_s']    = (string) $verdict['class'];
    $doc['rule_version_i'] = (int) $verdict['rule_version'];

    $ready[] = $doc;

    if ($provisional) {
        $publishedOpen[] = $session;
    } else {
        $days[gmdate('Y-m-d', (int) $session['ts_start'])] = true;
    }
}

$docs = $ready;

if ($docs !== []) {
    try {
        foreach (array_chunk($docs, 500) as $chunk) {
            $solr->addDocs($sessionCore, $chunk, true);
        }
        $log('indexed ' . count($docs) . ' session document(s)');

        if ($mergedIds !== [] && method_exists($state, 'markBeaconsMerged')) {
            $state->markBeaconsMerged($mergedIds);
        }
        if ($publishedOpen !== []) {
            $sessionizer->markProvisional($publishedOpen);
        }
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Loghound: indexing sessions failed: ' . $e->getMessage() . "\n");
        exit(2);
    }
}

if ($closed !== [] && (int) gmdate('H', $now) < 2) {
    $days[gmdate('Y-m-d', $now - 86400)] = true;
}

foreach (array_keys($days) as $day) {
    try {
        $rollup = computeRollup($solr, $sessionCore, $day);
        $solr->addDocs($sessionCore, [$rollup], true);
        $log('rollup rebuilt for ' . $day);
    } catch (\Throwable $e) {
        $log('rollup for ' . $day . ' failed: ' . $e->getMessage());
    }
}

exit(0);


/**
 * Turn a session aggregate into the BASE Solr document.
 *
 * Base means: everything the log plane knows, and nothing else. The execution-plane fields
 * are added afterwards by Beacon::mergeIntoSession(), and the verdict fields after that by
 * the scoring loop. Keeping the three stages separate is what lets the beacon merge see a
 * document that already carries tz_s (which it needs to compute tz_match_b).
 *
 * The one rule that matters here: a field is written ONLY when it is known. SPEC §1 forbids
 * fabricating a metric, and the beacon timing fields in particular must be ABSENT rather
 * than zero when no beacon arrived — a zero would be averaged in as a measurement and would
 * drag every engagement number toward the floor.
 *
 * A handful of fields are present for every session, because they really are derived from
 * the log alone. beacon_b is one of them: it starts false and stays false unless a beacon
 * actually arrived, so a false here means "we looked and nothing came", which is exactly
 * what the no_js_on_html cross-check needs — and it is why the three timing fields stay
 * absent alongside it. The path list is already capped at 50 by Sessionizer, with
 * uniq_paths_i carrying the true count. Identity, network and client fields are lifted from
 * the first hit, and only those that actually exist: an enrichment that failed leaves its
 * field off the document. Internal parser metadata, `_logged` and friends, never goes to
 * Solr.
 *
 * THE ID IS THE SESSION ID, whether the session has ended or not, and that is the whole
 * mechanism behind provisional documents: a session published while open and republished when
 * it closes is one document at one id, so the final version REPLACES the partial one. Solr's
 * /update with a duplicate uniqueKey is a delete-and-add, not a merge, so the final document
 * is complete and carries nothing left over from the provisional one — which is why
 * provisional_b is written only as true and simply disappears on close. A session counted twice
 * would be worse than a session counted late, and this is the line that prevents it.
 *
 * @param array<string,mixed> $session     Aggregate from Sessionizer::closeIdle() or listOpen().
 * @param bool                $provisional True when the session is still open, so every count
 *                                         on the document is partial (SPEC §4.2).
 * @return array<string,mixed>
 */
function buildSessionDoc(array $session, bool $provisional = false): array
{
    $doc = [
        'id'         => (string) $session['session_id'],
        'doc_type_s' => 'session',

        'ts_start' => gmdate('Y-m-d\TH:i:s\Z', (int) $session['ts_start']),
        'ts_end'   => gmdate('Y-m-d\TH:i:s\Z', (int) $session['ts_end']),

        'hits_i'       => (int) $session['hits'],
        'pages_i'      => (int) $session['pages'],
        'assets_i'     => (int) $session['assets'],
        'uniq_paths_i' => (int) $session['uniq_paths'],
        'bytes_l'      => (int) $session['bytes'],

        'status_2xx_i' => (int) $session['st2'],
        'status_3xx_i' => (int) $session['st3'],
        'status_4xx_i' => (int) $session['st4'],
        'status_5xx_i' => (int) $session['st5'],
        'got_304_b'    => (bool) $session['got_304'],

        'log_span_ms_l'   => (int) $session['log_span_ms'],
        'gap_p50_ms_l'    => (int) $session['gap_p50_ms'],
        'gap_stddev_ms_l' => (int) $session['gap_stddev_ms'],
        'asset_ratio_f'   => (float) $session['asset_ratio'],

        'beacon_b' => false,
    ];

    if ($provisional) {
        $doc['provisional_b'] = true;
    }

    if (($session['entry_path'] ?? null) !== null) {
        $doc['entry_path_s'] = (string) $session['entry_path'];
    }
    if (($session['exit_path'] ?? null) !== null) {
        $doc['exit_path_s'] = (string) $session['exit_path'];
    }
    if (!empty($session['paths'])) {
        $doc['paths_ss'] = array_values($session['paths']);
    }

    foreach ((array) ($session['first'] ?? []) as $field => $value) {
        if (str_starts_with((string) $field, '_')) {
            continue;
        }
        $doc[$field] = $value;
    }

    return $doc;
}

/**
 * Rebuild the daily rollup document for one UTC day.
 *
 * Every number here is an aggregate. Nothing in a rollup identifies a visitor, which is
 * what makes privacy.rollup_forever compatible with a 90-day retention policy: the
 * sessions behind it can be deleted while the shape of the traffic survives.
 *
 * SETTLED SESSIONS ONLY — SETTLED_SESSIONS is on the query and is not optional. An open
 * session has doc_type_s:session and a ts_start inside the day, so without that clause its
 * PARTIAL hit, page and byte counts and its FLOORED verdict would be folded into the day's
 * totals. Recomputing rather than incrementing means the same session is never counted twice
 * (it is one document at one id, open or closed), but it does not save the numbers from being
 * wrong while it is open: r_unknown_i would carry every live visitor and r_human_i would be
 * short by the same amount, on every rebuild, and the rollup is the one set of numbers in the
 * product that is meant to outlive the sessions behind it. The cost of the clause is that
 * TODAY's rollup lags by up to the idle timeout — which is what a settled daily aggregate IS.
 * The live picture comes from the session documents themselves.
 *
 * Nothing else is needed to keep the day correct: when a session that started on day D finally
 * closes, D goes back into the run's day set and the whole day is rebuilt from scratch, so the
 * session is counted exactly once, at its final values, on the day it started.
 *
 * r_beacon_sessions_i is written alongside the timing sums on purpose. A sum of engaged
 * milliseconds without the population it covers is uninterpretable, and presenting one
 * without the other is the exact mistake SPEC §10 forbids ("an unlabelled number is a lie").
 * For the same reason the timing sums are scoped to the population that actually has
 * timings.
 *
 * The id is deterministic, so a rebuild overwrites rather than duplicating, and ts_start is
 * set so that a rollup can be range-filtered with the same field as a session — which keeps
 * the dashboard's date handling to one code path.
 *
 * @return array<string,mixed>
 */
function computeRollup(Solr $solr, string $core, string $day): array
{
    $from = $day . 'T00:00:00Z';
    $to   = $day . 'T23:59:59.999Z';

    $res = $solr->jsonFacet(
        $core,
        [
            'q'  => '*:*',
            'fq' => [
                Solr::termFilter('doc_type_s', 'session'),
                SETTLED_SESSIONS,
                Solr::rangeFilter('ts_start', $from, $to),
            ],
        ],
        [
            'verdicts' => ['type' => 'terms', 'field' => 'bot_verdict_s', 'limit' => 10],
            'classes'  => ['type' => 'terms', 'field' => 'bot_class_s',   'limit' => 20],
            'hits'     => 'sum(hits_i)',
            'pages'    => 'sum(pages_i)',
            'bytes'    => 'sum(bytes_l)',
            'span'     => 'sum(log_span_ms_l)',
            'withbeacon' => [
                'type'  => 'query',
                'q'     => 'beacon_b:true',
                'facet' => [
                    'wall'    => 'sum(wall_ms_l)',
                    'visible' => 'sum(visible_ms_l)',
                    'engaged' => 'sum(engaged_ms_l)',
                ],
            ],
        ]
    );

    $facets = $res['facets'] ?? [];

    /** @var array<string,int> $verdicts */
    $verdicts = [];
    foreach (($facets['verdicts']['buckets'] ?? []) as $b) {
        $verdicts[(string) $b['val']] = (int) $b['count'];
    }
    /** @var array<string,int> $classes */
    $classes = [];
    foreach (($facets['classes']['buckets'] ?? []) as $b) {
        $classes[(string) $b['val']] = (int) $b['count'];
    }

    return [
        'id'         => 'rollup_daily:' . $day,
        'doc_type_s' => 'rollup_daily',
        'day_s'      => $day,
        'ts_start'   => $from,
        'ts_end'     => $to,

        'r_sessions_i' => (int) ($facets['count'] ?? 0),
        'r_hits_i'     => (int) ($facets['hits'] ?? 0),
        'r_pages_i'    => (int) ($facets['pages'] ?? 0),
        'r_bytes_l'    => (int) ($facets['bytes'] ?? 0),

        'r_human_i'        => $verdicts['human'] ?? 0,
        'r_likely_human_i' => $verdicts['likely_human'] ?? 0,
        'r_unknown_i'      => $verdicts['unknown'] ?? 0,
        'r_likely_bot_i'   => $verdicts['likely_bot'] ?? 0,
        'r_bot_i'          => $verdicts['bot'] ?? 0,

        'r_declared_crawler_i' => $classes['declared_crawler'] ?? 0,
        'r_ai_crawler_i'       => $classes['ai_crawler'] ?? 0,
        'r_headless_i'         => $classes['headless'] ?? 0,
        'r_scripted_i'         => $classes['scripted'] ?? 0,
        'r_proxy_fleet_i'      => $classes['proxy_fleet'] ?? 0,
        'r_spoofed_ua_i'       => $classes['spoofed_ua'] ?? 0,
        'r_monitor_i'          => $classes['monitor'] ?? 0,

        'r_beacon_sessions_i' => (int) ($facets['withbeacon']['count'] ?? 0),
        'r_wall_ms_sum_l'     => (int) ($facets['withbeacon']['wall'] ?? 0),
        'r_visible_ms_sum_l'  => (int) ($facets['withbeacon']['visible'] ?? 0),
        'r_engaged_ms_sum_l'  => (int) ($facets['withbeacon']['engaged'] ?? 0),
        'r_log_span_ms_sum_l' => (int) ($facets['span'] ?? 0),
    ];
}
