#!/usr/bin/env php
<?php
/**
 * Loghound — ingest daemon (SPEC §5).
 *
 *   tail  ->  parse  ->  enrich  ->  sessionize  ->  batch index into Solr
 *
 * Runs under systemd as `loghound-tail.service`, as user `loghound` in group `adm`.
 * NOT cron: cron's floor is 60 seconds and this is meant to be live.
 *
 * Usage
 *   loghound-tail                     run in the foreground (systemd Type=simple)
 *   loghound-tail --status            print the current daemon status as JSON and exit
 *   loghound-tail --status --human    the same, formatted for a terminal
 *   loghound-tail --once              one poll of every source, then exit (testing)
 *   loghound-tail --dry-run           parse and report, never write to Solr
 *   loghound-tail --from-start        first sight of a file starts at byte 0, not EOF
 *   loghound-tail --config=PATH       use a config file other than config/loghound.php
 *   loghound-tail --verbose           log every batch
 *
 * Signals
 *   SIGTERM / SIGINT  flush the pending batch, checkpoint every cursor, exit 0.
 *   SIGHUP            re-read the config and rebuild the source list without losing
 *                     a single byte of position (cursors live in SQLite, not memory).
 *
 * systemd sends SIGTERM on stop and SIGHUP on `systemctl reload`. Without ext-pcntl a
 * SIGTERM kills the process outright: the pending batch is lost — those lines are simply
 * re-read on the next start, because cursors only advance on a successful drain — but there
 * is no clean shutdown, so the daemon warns rather than pretending otherwise. A SIGHUP
 * reload is cheap for the same reason the cursors survive: they live in SQLite, so
 * rebuilding every Tail costs nothing but a re-open, no position is lost and no line is read
 * twice.
 *
 * `--status` is a READ-ONLY CLIENT of the running daemon: it reads the status file the
 * daemon writes once a second. Deliberately not a signal and not a socket — a status query
 * must never be able to disturb ingestion.
 *
 * ---------------------------------------------------------------------------------
 * ONE STATE INSTANCE
 * ---------------------------------------------------------------------------------
 * A single \Loghound\State owns var/state.db: the tail offsets, the open sessions, the
 * enrichment caches and the beacon staging table. Sharing it means the sessionizer and the
 * enrichers see the same transactions the tailer does, and that there is exactly one SQLite
 * writer in this process rather than three fighting over a WAL. Failing to open it is a
 * deployment problem, not a bug, so it is reported as one clean line and exits EX_CONFIG
 * instead of dumping an uncaught-exception trace into the journal.
 *
 * ---------------------------------------------------------------------------------
 * THE MAIN LOOP
 * ---------------------------------------------------------------------------------
 * Every cycle re-evaluates the source globs, because a glob is a question about the
 * filesystem RIGHT NOW rather than at startup: a vhost enabled this afternoon, or a log file
 * recreated after the nightly `find -mtime +10 -delete`, must be picked up without anyone
 * restarting the daemon. It is done once a second at most, since a handful of glob() calls
 * is nothing next to the work of actually reading the files, and tailers for paths that have
 * been gone long enough to be gone for good are dropped.
 *
 * A line that fails to parse is COUNTED and SAMPLED, never silently dropped (SPEC §5.2): a
 * rising parse_errors with an empty sample file would leave an operator with nothing to
 * debug. One bad source must never take the daemon down, so the others keep ingesting.
 *
 * The batch is flushed on whichever comes first, batch_size documents or batch_ms elapsed,
 * with softCommit only — a hard commit per batch would wreck throughput and is never needed
 * for near-real-time visibility (SPEC §5.5). The rate window keeps 60 seconds of samples,
 * because anything older cannot inform a "lines per second now".
 *
 * A reload flushes first, so that documents built with the old settings are not mixed into a
 * batch built with the new ones, and refuses to adopt a broken config: the daemon keeps
 * running on the old one rather than stopping ingestion because someone fat-fingered a file.
 * Each cycle then sleeps for the REMAINDER of the poll interval, subtracting the work already
 * done, which keeps the effective poll rate at poll_ms rather than poll_ms plus processing
 * time.
 *
 * @package Loghound
 * @license MIT
 */

declare(strict_types=1);

namespace Loghound\Bin;

use Loghound\Config;
use Loghound\Exclusions;
use Loghound\Security;
use Loghound\Tail;

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

$ROOT = dirname(__DIR__);
require_once $ROOT . '/src/autoload.php';

$args = [
    'config'     => $ROOT . '/config/loghound.php',
    'status'     => false,
    'human'      => false,
    'once'       => false,
    'dry_run'    => false,
    'from_start' => false,
    'verbose'    => false,
];

foreach (array_slice($argv, 1) as $a) {
    if (str_starts_with($a, '--config=')) {
        $args['config'] = substr($a, 9);
    } elseif ($a === '--status') {
        $args['status'] = true;
    } elseif ($a === '--human') {
        $args['human'] = true;
    } elseif ($a === '--once') {
        $args['once'] = true;
    } elseif ($a === '--dry-run') {
        $args['dry_run'] = true;
    } elseif ($a === '--from-start') {
        $args['from_start'] = true;
    } elseif ($a === '--verbose' || $a === '-v') {
        $args['verbose'] = true;
    } elseif ($a === '--help' || $a === '-h') {
        fwrite(STDOUT, usage());
        exit(0);
    } else {
        fwrite(STDERR, "loghound-tail: unknown option '$a'\n" . usage());
        exit(2);
    }
}

/** One-screen usage text, kept next to the option parser so they cannot drift apart. */
function usage(): string
{
    return <<<TXT

    loghound-tail — Loghound ingest daemon

      --status [--human]   report lag, rate and parse errors from the running daemon
      --once               poll every source once and exit
      --dry-run            parse and count, never write to Solr
      --from-start         a newly seen log file is read from byte 0 (default: from EOF)
      --config=PATH        alternate config file
      --verbose            log every batch
      --help

    TXT;
}

$VAR         = $ROOT . '/var';
$STATUS_FILE = $VAR . '/tail-status.json';
$BADLINES    = $VAR . '/badlines.log';
$STATE_DB    = $VAR . '/state.db';

if ($args['status']) {
    exit(printStatus($STATUS_FILE, $args['human']));
}

if (!is_dir($VAR) && !@mkdir($VAR, 0750, true) && !is_dir($VAR)) {
    fwrite(STDERR, "loghound-tail: cannot create $VAR\n");
    exit(78);
}

$cfg = Config::load($args['config']);
$errors = $cfg->validate();
if ($errors !== []) {
    fwrite(STDERR, "loghound-tail: configuration is not usable:\n");
    foreach ($errors as $e) {
        fwrite(STDERR, "  - $e\n");
    }
    fwrite(STDERR, "Finish setting up, then start this service again.\n");
    recordRefusal($STATUS_FILE, $errors);
    exit(78);
}

/** Set by the signal handlers; the main loop checks it between polls. */
$RUNNING = true;
$RELOAD  = false;

/** @var array<string,Tail> Tail instance per resolved log path. */
$tails = [];

/** @var array<string,array<string,mixed>> Source descriptor per resolved log path. */
$sourceMeta = [];

/** @var array<int,array<string,mixed>> Documents waiting to be flushed to Solr. */
$batch = [];

/**
 * Bytes of log read into the pending batch.
 *
 * Accumulated as the lines arrive, because the length is in hand there for nothing. It
 * feeds \Loghound\Quota's local projection of the index size between control-plane
 * refreshes: weighing the encoded documents instead would mean serialising every batch
 * twice to improve an estimate the next refresh corrects anyway.
 */
$batchBytes = 0;

$counters = [
    'started_at'     => time(),
    'lines'          => 0,
    'docs_indexed'   => 0,
    'parse_errors'   => 0,
    'batches'        => 0,
    'solr_errors'    => 0,
    'enrich_skipped' => 0,
    'badlines_kept'  => 0,

    /* Lines this installation was TOLD to drop: an exclusion rule matched, or the client was a
       loopback or private address. Counted apart from parse_errors because they are the
       configuration working, not the parser failing, and lumping them together made a healthy
       ingest look broken. */
    'refused'        => 0,

    /* Sub-resource requests that were counted into their session and then not indexed, per
       Pipeline::indexes(). Reported rather than silent: a number that differs from `lines`
       minus `docs_indexed` by an unexplained amount is how an operator discovers that ingestion
       is dropping something they did not ask it to drop. */
    'assets_dropped' => 0,
];

/** Rolling window of (timestamp, lines) samples used to compute a lines/sec rate. */
$rateWindow = [];

$lastFlush  = microtime(true);
$lastStatus = 0.0;

$havePcntl = extension_loaded('pcntl');
if ($havePcntl) {
    pcntl_async_signals(true);
    pcntl_signal(SIGTERM, static function () use (&$RUNNING): void {
        $RUNNING = false;
    });
    pcntl_signal(SIGINT, static function () use (&$RUNNING): void {
        $RUNNING = false;
    });
    pcntl_signal(SIGHUP, static function () use (&$RELOAD): void {
        $RELOAD = true;
    });
} else {
    logLine('warn', 'ext-pcntl is not loaded: SIGTERM will not flush the pending batch cleanly.');
}

$state = null;
try {
    if (class_exists('\\Loghound\\State')) {
        $state = new \Loghound\State($STATE_DB);
    }
    $cursors = new CursorStore($STATE_DB, $state);
} catch (\Throwable $e) {
    fwrite(STDERR, 'loghound-tail: cannot open the state database: ' . $e->getMessage() . "\n");
    exit(78);
}

try {
    $pipeline = new Pipeline($cfg, $args['dry_run'], $args['verbose'], $state);
} catch (\Throwable $e) {
    fwrite(STDERR, 'loghound-tail: cannot build the ingest pipeline: ' . $e->getMessage() . "\n");
    exit(78);
}

/**
 * Plan-quota awareness, and the rolling window that keeps the index inside it.
 *
 * SELF-PRESERVATION, not a nicety. An Opensolr index that exceeds its disk quota is not
 * throttled: the platform denies every request to it, reads included, so an unbounded
 * Loghound eventually fills the plan and switches its own dashboard off. The guard below
 * runs BEFORE each flush and deletes the oldest data when the index is near the limit, so
 * ingestion never has to stop and the quota is never crossed.
 *
 * Optional by construction. A --dry-run has nothing to protect, a custom-Solr install has no
 * plan to protect it against, and a Quota that cannot be built must never be the reason a
 * tailer refuses to start — the daemon's job is to not lose log lines.
 */
$quota = null;
if (!$args['dry_run'] && class_exists('\\Loghound\\Quota')) {
    try {
        $quota = new \Loghound\Quota($cfg);
    } catch (\Throwable $e) {
        logLine('warn', 'plan-quota retention is unavailable: ' . $e->getMessage());
    }
}
$quotaCore = (string) $cfg->get('solr.hits_core', '');

$badSampleCap = (int) $cfg->get('ingest.badline_sample', 200);
$badSampler   = new BadLineSampler($BADLINES, $badSampleCap);

buildSources($cfg, $args['from_start'], $cursors, $badSampler, $tails, $sourceMeta, $counters);

if ($tails === []) {
    fwrite(STDERR, "loghound-tail: no readable log sources are configured.\n");
    fwrite(STDERR, "Run bin/loghound-setup to detect them.\n");
    exit(78);
}

logLine('info', sprintf(
    'watching %d log file(s); poll %d ms; batch %d docs / %d ms%s',
    count($tails),
    (int) $cfg->get('ingest.poll_ms', 1000),
    (int) $cfg->get('solr.batch_size', 500),
    (int) $cfg->get('solr.batch_ms', 2000),
    $args['dry_run'] ? ' [DRY RUN — nothing will be indexed]' : ''
));

$pollUs   = max(50, (int) $cfg->get('ingest.poll_ms', 1000)) * 1000;
$batchMax = max(1, (int) $cfg->get('solr.batch_size', 500));
$batchMs  = max(100, (int) $cfg->get('solr.batch_ms', 2000));

/**
 * How long a watched path may stay missing before we stop watching it.
 *
 * A file that has been deleted for an hour is not coming back under the same inode, and
 * on a box with dated log names (access.log-20260910) a glob would otherwise accumulate
 * one Tail per historical file forever. The cursor row stays in SQLite either way, so
 * re-adopting the path later costs nothing.
 */
const SOURCE_FORGET_AFTER_SEC = 3600;

$lastRescan = 0.0;

do {
    $loopStart = microtime(true);
    $linesThisPoll = 0;

    if ($loopStart - $lastRescan >= 1.0) {
        $lastRescan = $loopStart;
        buildSources($cfg, $args['from_start'], $cursors, $badSampler, $tails, $sourceMeta, $counters, true);

        foreach ($tails as $path => $t) {
            $s = $t->status();
            if (($s['missing_for_sec'] ?? null) !== null
                && (int) $s['missing_for_sec'] > SOURCE_FORGET_AFTER_SEC
            ) {
                logLine('info', 'no longer watching ' . $path . ' (absent for '
                    . $s['missing_for_sec'] . 's); it will be picked up again if it returns');
                $t->close();
                unset($tails[$path], $sourceMeta[$path]);
            }
        }
    }

    foreach ($tails as $path => $tail) {
        $meta = $sourceMeta[$path];

        try {
            $tail->poll(function (string $line, int $offset, string $src) use (
                $meta,
                $pipeline,
                $badSampler,
                $batchMax,
                $args,
                $quota,
                $quotaCore,
                &$batch,
                &$batchBytes,
                &$counters,
                &$linesThisPoll,
                &$lastFlush
            ): void {
                $counters['lines']++;
                $linesThisPoll++;

                $doc = $pipeline->process($line, $offset, $src, $meta);

                if ($doc === null) {
                    /* A REFUSAL IS NOT A PARSE ERROR. Both return null, and counting them
                       together made the operator's own exclusion rules and the loopback filter
                       read as a broken parser — and filled badlines.log with lines that parsed
                       perfectly and were then deliberately dropped, pushing the genuine
                       failures out past the sample cap. */
                    if ($pipeline->refusedLast()) {
                        $counters['refused']++;
                        return;
                    }

                    $counters['parse_errors']++;
                    if ($badSampler->record($src, $offset, $line)) {
                        $counters['badlines_kept']++;
                    }
                    return;
                }

                /* SESSIONISED, THEN DROPPED. The document has already been through
                   Pipeline::process(), so the session it belongs to has counted it: its bytes,
                   its status class, its contribution to `assets`, `sub_resources`,
                   `asset_ratio_f`, the repeated-URI set behind `no_304_on_repeat` and the
                   inter-request gaps. Only the INDEXING is refused. Dropping the line earlier
                   would have been the obvious implementation and would have silently disarmed
                   `no_assets` — a rule that accuses a client of fetching no sub-resources cannot
                   be fed by a pipeline that threw the sub-resources away. */
                if (!$pipeline->indexes($doc)) {
                    $counters['assets_dropped']++;
                    return;
                }

                $batch[] = $doc;
                $batchBytes += strlen($line);

                /* THE SIZE FLUSH LIVES WHERE THE BATCH GROWS, AND IT DID NOT. Tail::drain()
                   loops to EOF before poll() returns, so the check that used to sit after this
                   foreach was never consulted while a backlog was being read: one poll emitted
                   EVERY line in the file into $batch first. At roughly 1-3 KB a document a
                   million-line backlog is two to three gigabytes resident before the first
                   flush — and the paths that produce a backlog are the ones an operator hits
                   at the worst moment: --from-start, a restart after downtime, and the
                   rotation-recovery drain, which reads the ROTATED file while the live one is
                   still pending. ingest.batch_max was a setting the drain path ignored.

                   Only the SIZE half belongs here. The time half stays in the loop below,
                   because it exists to bound latency on a quiet source and asking the clock
                   once per line would put a syscall in front of every log line for nothing. */
                if (count($batch) >= $batchMax) {
                    flushBatch($pipeline, $batch, $batchBytes, $counters, $args['verbose'], $quota, $quotaCore);
                    $lastFlush = microtime(true);
                }
            });
        } catch (\Throwable $e) {
            logLine('error', 'source ' . $path . ': ' . $e->getMessage());
        }
    }

    $now = microtime(true);
    if (count($batch) >= $batchMax || ($batch !== [] && ($now - $lastFlush) * 1000 >= $batchMs)) {
        flushBatch($pipeline, $batch, $batchBytes, $counters, $args['verbose'], $quota, $quotaCore);
        $lastFlush = $now;
    }

    $rateWindow[] = [$now, $linesThisPoll];
    while ($rateWindow !== [] && $now - $rateWindow[0][0] > 60.0) {
        array_shift($rateWindow);
    }

    if ($now - $lastStatus >= 1.0) {
        writeStatus($STATUS_FILE, $tails, $sourceMeta, $counters, $rateWindow, $batch, $args);
        $lastStatus = $now;
    }

    if ($RELOAD) {
        $RELOAD = false;
        logLine('info', 'SIGHUP: reloading configuration');
        flushBatch($pipeline, $batch, $batchBytes, $counters, $args['verbose'], $quota, $quotaCore);

        $newCfg = Config::load($args['config']);
        $newErrors = $newCfg->validate();
        if ($newErrors !== []) {
            logLine('error', 'reload rejected, keeping previous config: ' . implode('; ', $newErrors));
        } else {
            $cfg      = $newCfg;
            $pipeline = new Pipeline($cfg, $args['dry_run'], $args['verbose'], $state);
            $pollUs   = max(50, (int) $cfg->get('ingest.poll_ms', 1000)) * 1000;
            $batchMax = max(1, (int) $cfg->get('solr.batch_size', 500));
            $batchMs  = max(100, (int) $cfg->get('solr.batch_ms', 2000));
            $badSampler = new BadLineSampler($BADLINES, (int) $cfg->get('ingest.badline_sample', 200));

            foreach ($tails as $t) {
                $t->close();
            }
            $tails = [];
            $sourceMeta = [];
            buildSources($cfg, $args['from_start'], $cursors, $badSampler, $tails, $sourceMeta, $counters);
            logLine('info', 'reload complete; watching ' . count($tails) . ' log file(s)');
        }
    }

    if ($args['once']) {
        break;
    }

    $spent = (int) ((microtime(true) - $loopStart) * 1000000);
    if ($spent < $pollUs) {
        usleep($pollUs - $spent);
    }
} while ($RUNNING);

logLine('info', 'shutting down');
flushBatch($pipeline, $batch, $batchBytes, $counters, $args['verbose'], $quota, $quotaCore);
foreach ($tails as $t) {
    $t->close();
}
writeStatus($STATUS_FILE, $tails, $sourceMeta, $counters, $rateWindow, $batch, $args);
$cursors->close();
if ($state !== null && method_exists($state, 'close')) {
    $state->close();
}
if ($quota !== null) {
    $quota->flush();
}
exit(0);

/**
 * Expand the configured sources into one Tail per real, readable file.
 *
 * A source `path` may be a glob (`/var/log/apache2/*access.log`), which is the normal
 * case on a box with many vhosts. Every expanded path is re-validated against
 * `allowed_log_roots` — the glob is expanded here, at read time, so validating only the
 * pattern at save time would leave a hole. A path is never followed out of the permitted
 * roots, not even via a symlink placed in the log directory by someone who can write there.
 *
 * Plain glob() is used rather than GLOB_BRACE, which is not portable and buys nothing for
 * the patterns setup produces. A file already being watched is skipped, whether because two
 * globs matched it or because a previous cycle picked it up.
 *
 * A source discovered on a later cycle rather than at startup is worth exactly one log line:
 * a new vhost coming online is something an operator wants to see in the journal.
 *
 * A SOURCE MAY SAY NO. `enabled => false` on the entry stops the file being read, and the
 * decision itself is Config::sourceEnabled() so the panel and the daemon cannot disagree about
 * it. The switch exists for the panel's own virtual host: it is a log source like any other on
 * the machine that serves it, so browsing Loghound creates sessions in the data Loghound
 * displays, and until now the only answer was prose in three documents advising against a setup
 * the software would happily run. Absent means enabled, so no existing configuration changes.
 *
 * It is tested before glob() and before any Tail is constructed, because a disabled source must
 * cost nothing and must not appear in $tails — one that were opened and only then ignored would
 * still advance its cursor and still be reported as ingesting. The skip is announced on a full
 * build but not on the once-a-second rescan, which is what $quiet distinguishes; a log file
 * nobody is reading is the most expensive misconfiguration this daemon can be handed.
 *
 * @param array<string,Tail>               $tails      out-param
 * @param array<string,array<string,mixed>> $sourceMeta out-param
 */
function buildSources(
    Config $cfg,
    bool $fromStart,
    CursorStore $cursors,
    BadLineSampler $badSampler,
    array &$tails,
    array &$sourceMeta,
    array &$counters,
    bool $quiet = false
): void {
    $roots = (array) $cfg->get('allowed_log_roots', ['/var/log']);
    $opts = [
        'start_at'       => $fromStart ? 'start' : 'end',
        'max_line_bytes' => (int) $cfg->get('ingest.max_line_bytes', 16384),
        'on_bad_line'    => static function (string $chunk, int $off, string $why) use ($badSampler, &$counters): void {
            $counters['parse_errors']++;
            if ($badSampler->record('(oversized)', $off, $why . ': ' . $chunk)) {
                $counters['badlines_kept']++;
            }
        },
    ];

    foreach ((array) $cfg->get('sources', []) as $src) {
        $pattern = (string) ($src['path'] ?? '');
        if ($pattern === '') {
            continue;
        }

        if (!Config::sourceEnabled((array) $src)) {
            if (!$quiet) {
                logLine('info', 'source disabled in configuration, not ingesting: ' . $pattern);
            }
            continue;
        }

        /* THE PATTERN IS BOUNDED BEFORE IT IS EXPANDED. glob() walks the filesystem doing the
           work the pattern asks for, and every result is only THEN checked against
           allowed_log_roots — so a pattern of `/*` or one with a deep run of wildcards costs its
           full stat() sweep before a single path is refused, and a pattern matching nothing at
           all costs the most. This is the same shape as the GLOB_BRACE bomb in LogDetect, with a
           smaller multiplier: sources come from the configuration rather than from a webserver
           config file, so the bound is cheap insurance rather than a live hole. Length and
           wildcard count only; the per-result Security::safePath() check below is untouched and
           is still what decides whether a path may be read. */
        if (strlen($pattern) > 512 || substr_count($pattern, '*') > 4 || str_contains($pattern, '{')) {
            logLine('warn', 'source pattern refused as too broad, skipping: ' . $pattern);
            continue;
        }

        $matches = glob($pattern) ?: [];
        if ($matches === [] && is_file($pattern)) {
            $matches = [$pattern];
        }

        foreach ($matches as $file) {
            if (isset($tails[$file])) {
                continue;
            }

            $real = Security::safePath($file, $roots);
            if ($real === null) {
                if (!$quiet) {
                    logLine('warn', 'refusing source outside allowed_log_roots: ' . $file);
                }
                continue;
            }
            if (!is_readable($real)) {
                if (!$quiet) {
                    logLine('warn', 'not readable (is loghound in group adm?): ' . $real);
                }
                continue;
            }
            if (isset($tails[$real])) {
                continue;
            }

            if ($quiet) {
                logLine('info', 'new log source discovered: ' . $real);
            }

            $tails[$real] = new Tail(
                $real,
                static fn(string $p): ?array => $cursors->load($p),
                static function (string $p, int $d, int $i, int $o) use ($cursors): void {
                    $cursors->save($p, $d, $i, $o);
                },
                $opts
            );

            $sourceMeta[$real] = [
                'src'    => $real,
                'format' => $src['format'] ?? 'combined',
                'host'   => $src['host'] ?? null,
            ];
        }
    }
}

/**
 * Send the pending documents to Solr and clear the batch.
 *
 * A Solr failure is logged and counted but the batch is dropped rather than retried
 * forever: an unavailable Solr must not turn into unbounded memory growth in a daemon
 * that reads a firehose. The cursors have already advanced, so those specific lines are
 * lost — which is why `solr_errors` is prominent in the status output, and why the
 * systemd unit restarts the daemon on repeated failure.
 *
 * THE QUOTA GUARD RUNS FIRST, BEFORE THE WRITE, and the ordering is the entire feature. An
 * Opensolr index that crosses its disk quota is denied wholesale by the platform — every
 * request answers 403, reads included — so making room afterwards would be making room
 * after the blackout. Above the high-water mark the guard deletes the oldest data by date,
 * in bounded steps, and ingestion continues into the space it freed.
 *
 * It is cheap in the common case and has to stay that way: a batch arrives every couple of
 * seconds and the control-plane call behind these figures is slow, so \Loghound\Quota
 * answers from its cache except once every few minutes, and the trim itself only happens
 * near the limit. A guard that failed is logged and ingestion carries on — losing log lines
 * because the bookkeeping had a bad day is the worse outcome of the two.
 *
 * @param int         $batchBytes Log bytes that produced this batch; feeds the local
 *                                projection of index size between refreshes.
 * @param object|null $quota      \Loghound\Quota, or null when there is no plan to respect.
 */
function flushBatch(
    Pipeline $pipeline,
    array &$batch,
    int &$batchBytes,
    array &$counters,
    bool $verbose,
    ?object $quota = null,
    string $quotaCore = ''
): void {
    if ($batch === []) {
        $batchBytes = 0;
        return;
    }
    $n = count($batch);
    $bytes = $batchBytes;

    if ($quota !== null && $quotaCore !== '') {
        guardQuota($quota, $pipeline, $quotaCore, $verbose);
    }

    try {
        $pipeline->index($batch);
        $counters['docs_indexed'] += $n;
        $counters['batches']++;
        if ($verbose) {
            logLine('info', "indexed $n document(s)");
        }
        if ($quota !== null && $quotaCore !== '') {
            $quota->noteWrite($quotaCore, $n, $bytes);
        }
    } catch (\Throwable $e) {
        $counters['solr_errors']++;
        logLine('error', "batch of $n document(s) failed: " . $e->getMessage());
    }
    $batch = [];
    $batchBytes = 0;
}

/**
 * Make room for the batch about to be written, if the plan says room is needed.
 *
 * Everything interesting is in \Loghound\Quota; this is the daemon-side wiring, and it
 * exists as its own function so that the failure handling — never let this stop ingestion —
 * is in one place rather than repeated at each of the three flush sites.
 *
 * A trim is worth a log line at info level even when it succeeds: deleting an operator's
 * oldest data is not something that should only ever be visible as a number on a dashboard.
 */
function guardQuota(object $quota, Pipeline $pipeline, string $core, bool $verbose): void
{
    $solr = $pipeline->solr();
    if ($solr === null) {
        return;
    }

    try {
        $result = $quota->guardBeforeWrite($solr, $core, 'ts', [
            'logger' => static function (string $m): void {
                logLine('info', $m);
            },
        ]);
    } catch (\Throwable $e) {
        logLine('warn', 'plan-quota check failed, ingesting anyway: ' . $e->getMessage());
        return;
    }

    if ($result['action'] === 'failed') {
        $reason = (string) ($result['reason'] ?? '');

        // Two different failures with two different next steps. Already blocked: the
        // message explains itself and there is nothing to add. Not yet blocked: say what
        // it leads to, because that is the part an operator would not otherwise know.
        logLine('error', str_contains($reason, 'blocked by Opensolr')
            ? $core . ': ' . $reason
            : 'could not free space in ' . $core . ': ' . $reason
              . ' — if the index reaches its quota, Opensolr will block it completely, reads included.');
    } elseif ($verbose && $result['action'] !== 'none') {
        logLine('info', 'plan window for ' . $core . ': ' . $result['action']
            . ' — ' . (string) ($result['reason'] ?? ''));
    }
}

/**
 * Leave a record that the daemon refused to start, and why.
 *
 * Without it the panel cannot tell "the daemon has never run here" from "the daemon ran,
 * refused a configuration it could not use, and stopped" — and it reported the first for
 * both, which sends the operator to look at setup when setup is finished, or at the service
 * when the service is doing exactly what it should.
 *
 * Deliberately its own state rather than a status document with zeroes in it: a refusal is
 * not an idle daemon, and anything reading this must not average it in as one.
 *
 * Best effort. A daemon that cannot write its own diagnostic still exits with the reason on
 * stderr, where systemd keeps it, and failing to record must never become a second failure
 * the operator has to understand.
 *
 * @param array<int,string> $errors
 */
function recordRefusal(string $path, array $errors): void
{
    $doc = [
        'state'     => 'refused',
        'at'        => time(),
        'pid'       => getmypid(),
        'errors'    => array_values(array_map('strval', $errors)),
    ];

    $tmp = $path . '.' . bin2hex(random_bytes(4)) . '.tmp';
    if (@file_put_contents($tmp, (string) json_encode($doc, JSON_PRETTY_PRINT)) === false) {
        return;
    }
    @chmod($tmp, 0640);
    if (!@rename($tmp, $path)) {
        @unlink($tmp);
    }
}

/**
 * Write the machine-readable status document.
 *
 * Written atomically (temp file + rename) so `--status` can never read a half-written
 * JSON document, and once a second at most so a 5000 req/s box does not spend its time
 * serialising status.
 *
 * The lines-per-second figure is computed over the rolling window and reported as null,
 * not 0, when there is not yet a window to average over: an invented zero is a lie.
 */
function writeStatus(
    string $file,
    array $tails,
    array $sourceMeta,
    array $counters,
    array $rateWindow,
    array $batch,
    array $args
): void {
    $rate = null;
    if (count($rateWindow) >= 2) {
        $span = $rateWindow[count($rateWindow) - 1][0] - $rateWindow[0][0];
        if ($span > 0.5) {
            $sum = 0;
            foreach ($rateWindow as [, $n]) {
                $sum += $n;
            }
            $rate = round($sum / $span, 2);
        }
    }

    $sources = [];
    $totalLag = 0;
    foreach ($tails as $path => $tail) {
        $s = $tail->status();
        $s['format'] = $sourceMeta[$path]['format'] ?? null;
        $sources[] = $s;
        if (is_int($s['lag_bytes'])) {
            $totalLag += $s['lag_bytes'];
        }
    }

    $doc = [
        'schema'         => 1,
        'pid'            => getmypid(),
        'generated_at'   => gmdate('Y-m-d\TH:i:s\Z'),
        'started_at'     => gmdate('Y-m-d\TH:i:s\Z', $counters['started_at']),
        'uptime_sec'     => time() - $counters['started_at'],
        'dry_run'        => $args['dry_run'],
        'lines_per_sec'  => $rate,
        'lag_bytes'      => $totalLag,
        'pending_docs'   => count($batch),
        'totals'         => [
            'lines'          => $counters['lines'],
            'docs_indexed'   => $counters['docs_indexed'],
            'assets_dropped' => $counters['assets_dropped'],
            'refused'        => $counters['refused'],
            'parse_errors'   => $counters['parse_errors'],
            'badlines_kept'  => $counters['badlines_kept'],
            'batches'        => $counters['batches'],
            'solr_errors'    => $counters['solr_errors'],
            'enrich_skipped' => $counters['enrich_skipped'],
        ],
        'sources'        => $sources,
    ];

    $json = json_encode($doc, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
    if ($json === false) {
        return;
    }
    $tmp = $file . '.tmp';
    if (@file_put_contents($tmp, $json . "\n", LOCK_EX) !== false) {
        @rename($tmp, $file);
    }
}

/**
 * Render the status file for `--status`, as JSON or as a small human table.
 *
 * A status file that has not been touched for a while means the daemon died without removing
 * it, and that is said plainly instead of reporting stale numbers as if they were live.
 *
 * @return int Process exit code: 0 healthy, 3 stale/absent.
 */
function printStatus(string $file, bool $human): int
{
    if (!is_file($file)) {
        fwrite(STDERR, "loghound-tail: no status file at $file — is the daemon running?\n");
        return 3;
    }
    $raw = (string) @file_get_contents($file);
    $doc = json_decode($raw, true);
    if (!is_array($doc)) {
        fwrite(STDERR, "loghound-tail: status file is unreadable\n");
        return 3;
    }

    $age = time() - (int) strtotime((string) ($doc['generated_at'] ?? ''));
    $stale = $age > 10;

    if (!$human) {
        $doc['stale'] = $stale;
        $doc['status_age_sec'] = $age;
        fwrite(STDOUT, json_encode($doc, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");
        return $stale ? 3 : 0;
    }

    $t = $doc['totals'] ?? [];
    fwrite(STDOUT, sprintf(
        "loghound-tail  pid %s  up %s  %s\n",
        $doc['pid'] ?? '?',
        formatDuration((int) ($doc['uptime_sec'] ?? 0)),
        $stale ? "STALE (status is {$age}s old — daemon probably dead)" : 'running'
    ));
    fwrite(STDOUT, sprintf(
        "  rate %s lines/s   lag %s   pending %d doc(s)\n",
        /* ?? RATHER THAN ===, because the key is absent and not null on a status file written
           before the first rate was computed — a freshly restarted daemon, which is exactly when
           somebody runs --status. The identity test emitted a PHP warning into the operator's
           own output, above the numbers they came to read. */
        ($doc['lines_per_sec'] ?? null) === null ? 'n/a' : (string) $doc['lines_per_sec'],
        formatBytes((int) ($doc['lag_bytes'] ?? 0)),
        (int) ($doc['pending_docs'] ?? 0)
    ));
    fwrite(STDOUT, sprintf(
        "  lines %d   indexed %d   sub-resources not stored %d   refused %d   parse errors %d"
            . "   solr errors %d\n",
        (int) ($t['lines'] ?? 0),
        (int) ($t['docs_indexed'] ?? 0),
        (int) ($t['assets_dropped'] ?? 0),
        (int) ($t['refused'] ?? 0),
        (int) ($t['parse_errors'] ?? 0),
        (int) ($t['solr_errors'] ?? 0)
    ));
    foreach (($doc['sources'] ?? []) as $s) {
        fwrite(STDOUT, sprintf(
            "  %-50s lag %-10s lines %-9d rot %d trunc %d%s\n",
            $s['path'] ?? '?',
            $s['lag_bytes'] === null ? 'n/a' : formatBytes((int) $s['lag_bytes']),
            (int) ($s['lines'] ?? 0),
            (int) ($s['rotations'] ?? 0),
            (int) ($s['truncations'] ?? 0),
            !empty($s['missed_rotations']) ? '  MISSED ROTATIONS: ' . $s['missed_rotations'] : ''
        ));
        if (!empty($s['note'])) {
            fwrite(STDOUT, '      note: ' . $s['note'] . "\n");
        }
    }
    return $stale ? 3 : 0;
}

/** Human-readable byte count for the status table. */
function formatBytes(int $n): string
{
    $units = ['B', 'KB', 'MB', 'GB', 'TB'];
    $i = 0;
    $v = (float) $n;
    while ($v >= 1024 && $i < count($units) - 1) {
        $v /= 1024;
        $i++;
    }
    return ($i === 0 ? (string) $n : sprintf('%.1f', $v)) . ' ' . $units[$i];
}

/** Human-readable duration for the status table. */
function formatDuration(int $sec): string
{
    if ($sec < 60) {
        return $sec . 's';
    }
    if ($sec < 3600) {
        return intdiv($sec, 60) . 'm ' . ($sec % 60) . 's';
    }
    if ($sec < 86400) {
        return intdiv($sec, 3600) . 'h ' . intdiv($sec % 3600, 60) . 'm';
    }
    return intdiv($sec, 86400) . 'd ' . intdiv($sec % 86400, 3600) . 'h';
}

/**
 * Emit one structured log line on stderr.
 *
 * stderr because systemd routes it into the journal with the right unit metadata; no
 * private log file to rotate, and `journalctl -u loghound-tail` just works.
 */
function logLine(string $level, string $message): void
{
    fwrite(STDERR, sprintf("[%s] %-5s loghound-tail: %s\n", gmdate('Y-m-d\TH:i:s\Z'), $level, $message));
}

/**
 * Persists (dev, inode, offset) per log file.
 *
 * Prefers \Loghound\State when it exposes tail-cursor methods (that class owns
 * var/state.db and is written by another agent). Falls back to its own table in the
 * same database file so the daemon is functional on its own; the table name is distinct
 * from anything State declares, so both can coexist.
 */
final class CursorStore
{
    private ?\SQLite3 $db = null;
    private ?object $state = null;

    /** Method names accepted on \Loghound\State, in preference order. */
    private ?string $getMethod = null;
    private ?string $setMethod = null;

    /**
     * \Loghound\State owns the offsets table, so it is used whenever one is available and
     * there is a single schema with a single writer. The self-contained fallback only runs in
     * a checkout where State does not exist, which is what keeps this daemon testable on its
     * own.
     *
     * The fallback opens the database in WAL mode, which keeps the scorer and the retention
     * job readable while the tailer writes, and chmods it to 0640: the state database holds no
     * secrets, but it does hold the shape of the operator's traffic, and that should stay off
     * other local users.
     *
     * @param string       $dbPath Path to var/state.db.
     * @param object|null  $state  The shared \Loghound\State, when it is available.
     */
    public function __construct(string $dbPath, ?object $state = null)
    {
        if ($state !== null && method_exists($state, 'getOffset') && method_exists($state, 'setOffset')) {
            $this->state = $state;
            $this->getMethod = 'getOffset';
            $this->setMethod = 'setOffset';
            return;
        }

        if (!class_exists('\\SQLite3')) {
            throw new \RuntimeException('ext-sqlite3 is required and is not loaded.');
        }

        $this->db = new \SQLite3($dbPath);
        $this->db->busyTimeout(5000);
        $this->db->exec('PRAGMA journal_mode = WAL');
        $this->db->exec('PRAGMA synchronous = NORMAL');
        $this->db->exec(
            'CREATE TABLE IF NOT EXISTS tail_offsets ('
            . ' path TEXT PRIMARY KEY,'
            . ' dev INTEGER NOT NULL,'
            . ' inode INTEGER NOT NULL,'
            . ' offset INTEGER NOT NULL,'
            . ' updated_at INTEGER NOT NULL'
            . ')'
        );
        @chmod($dbPath, 0640);
    }

    /**
     * Load the stored cursor for a path, or null when it has never been seen.
     *
     * @return array{dev:int,inode:int,offset:int}|null
     */
    public function load(string $path): ?array
    {
        if ($this->state !== null) {
            /** @var mixed $row */
            $row = $this->state->{$this->getMethod}($path);
            if (!is_array($row) || !isset($row['inode'], $row['offset'])) {
                return null;
            }
            return [
                'dev'    => (int) ($row['dev'] ?? 0),
                'inode'  => (int) $row['inode'],
                'offset' => (int) $row['offset'],
            ];
        }

        $stmt = $this->db->prepare('SELECT dev, inode, offset FROM tail_offsets WHERE path = :p');
        $stmt->bindValue(':p', $path, SQLITE3_TEXT);
        $res = $stmt->execute();
        $row = $res === false ? false : $res->fetchArray(SQLITE3_ASSOC);
        if (!is_array($row)) {
            return null;
        }
        return [
            'dev'    => (int) $row['dev'],
            'inode'  => (int) $row['inode'],
            'offset' => (int) $row['offset'],
        ];
    }

    /** Persist a cursor. Called after every drain. */
    public function save(string $path, int $dev, int $inode, int $offset): void
    {
        if ($this->state !== null) {
            $this->state->{$this->setMethod}($path, $dev, $inode, $offset);
            return;
        }
        $stmt = $this->db->prepare(
            'INSERT INTO tail_offsets (path, dev, inode, offset, updated_at)'
            . ' VALUES (:p, :d, :i, :o, :t)'
            . ' ON CONFLICT(path) DO UPDATE SET dev = :d, inode = :i, offset = :o, updated_at = :t'
        );
        $stmt->bindValue(':p', $path, SQLITE3_TEXT);
        $stmt->bindValue(':d', $dev, SQLITE3_INTEGER);
        $stmt->bindValue(':i', $inode, SQLITE3_INTEGER);
        $stmt->bindValue(':o', $offset, SQLITE3_INTEGER);
        $stmt->bindValue(':t', time(), SQLITE3_INTEGER);
        $stmt->execute();
    }

    /** Close the database handle. */
    public function close(): void
    {
        if ($this->db !== null) {
            $this->db->close();
            $this->db = null;
        }
    }
}

/**
 * Keeps a capped sample of lines that could not be parsed.
 *
 * SPEC §5.2: an unparseable line is counted and sampled, never silently dropped. The
 * cap matters as much as the sampling — a format that suddenly stops matching would
 * otherwise fill the disk with a copy of the access log within minutes.
 *
 * What is already in the file is counted on startup, so that a restart does not reset the cap
 * and let the file grow without limit across restarts.
 */
final class BadLineSampler
{
    private string $file;
    private int $cap;
    private int $written = 0;
    private bool $noticedCap = false;

    public function __construct(string $file, int $cap)
    {
        $this->file = $file;
        $this->cap  = max(0, $cap);

        if (is_file($file)) {
            $fh = @fopen($file, 'rb');
            if ($fh !== false) {
                while (fgets($fh) !== false) {
                    $this->written++;
                }
                fclose($fh);
            }
        }
    }

    /**
     * Record one unparseable line. Returns true when it was actually written.
     *
     * The line is stored with its source and offset so an operator can go straight to
     * the original bytes, and control characters are stripped: a log line is
     * attacker-controlled and this file WILL be read in a terminal. The C0 controls and DEL
     * are what go, so that a crafted User-Agent cannot emit escape sequences into the
     * operator's terminal when they cat the file.
     */
    public function record(string $src, int $offset, string $line): bool
    {
        if ($this->written >= $this->cap) {
            if (!$this->noticedCap) {
                $this->noticedCap = true;
                logLine('warn', 'badline sample cap (' . $this->cap . ') reached; further '
                    . 'unparseable lines are counted but not written to ' . $this->file);
            }
            return false;
        }

        /* EVERY C0 CONTROL, WHICH IS WHAT THE DOCBLOCK ABOVE SAYS AND WHAT THE CLASS USED TO
           EXCLUDE THREE OF. The old class kept \x09, \x0A and \x0D, and both of the survivors
           matter here. This record is a TAB-separated line, so a TAB inside an attacker's
           request path or User-Agent forges extra columns in a file something will later parse
           — the source field was already scrubbed for exactly that reason and the line was not.
           And a CR is the carriage-return overwrite the scrub exists to stop, in a file the
           docblock says WILL be read in a terminal. A newline cannot arrive today because
           Tail::drain splits on one, which is a property of the caller and not of this
           method. */
        $safe = preg_replace('/[\x00-\x1F\x7F]/', '?', $line) ?? '';
        $safe = substr($safe, 0, 4096);

        $record = sprintf(
            "%s\t%s\t%d\t%s\n",
            gmdate('Y-m-d\TH:i:s\Z'),
            str_replace(["\t", "\n"], ' ', $src),
            $offset,
            $safe
        );

        if (@file_put_contents($this->file, $record, FILE_APPEND | LOCK_EX) !== false) {
            @chmod($this->file, 0640);
            $this->written++;
            return true;
        }
        return false;
    }
}

/**
 * The parse -> enrich -> sessionize -> index pipeline (SPEC §5.2-§5.5).
 *
 * ---------------------------------------------------------------------------------
 * THE CONTRACT THIS DAEMON CALLS
 * ---------------------------------------------------------------------------------
 *   \Loghound\LogDetect   ::formatByName(string $name): ?LogFormat
 *                         ::formatFromRegex(string $pattern, string $name): ?LogFormat
 *   \Loghound\LogFormat   ::fromApache(string $fmt, string $name): self
 *                         ::isDelimitedRegex(string $candidate): bool
 *                         ->parse(string $line): ?array     RAW record (remote_addr, ...)
 *   \Loghound\Parser      ->parseLine(LogFormat $fmt, string $line, string $src,
 *                                      int $offset): ?array  NORMALISED hit, SPEC §4.1 names
 *                         ->errors(): int
 *   \Loghound\Enrich\Ua   ::parse(string $ua)->fields(): array
 *   \Loghound\Enrich\Geo  ->lookup(string $ip): array
 *   \Loghound\Enrich\Asn  ->lookup(string $ip): array   ->rdns(string $ip): array
 *   \Loghound\Sessionizer ->assign(array $hit): array
 *   \Loghound\Solr        ->addDocs(string $core, array $docs, bool $softCommit): array
 *
 * Degradation is deliberate and asymmetric:
 *   - Parser missing        -> fatal for real ingestion; LogFormat alone yields RAW field
 *                              names, which are not a `hits` document. Allowed under
 *                              --dry-run purely as a "does this format match?" check.
 *   - Enrichment failing    -> the field is simply ABSENT. SPEC §5.3 is explicit that
 *                              enrichment must never block indexing: a whois timeout is
 *                              not a reason to lose a request.
 *   - Sessionizer missing   -> session fields absent; loghound-score can assign later.
 *   - Solr missing          -> fatal unless --dry-run.
 */
final class Pipeline
{
    private Config $cfg;
    private bool $dryRun;
    private bool $verbose;

    /** Normalises a raw parsed record into a `hits` document. Required for real ingestion. */
    private ?object $parser = null;

    /** True when only LogFormat is available (--dry-run parseability check). */
    private bool $rawOnly = false;

    /** @var array<string,object> Compiled LogFormat per source format name. */
    private array $formats = [];

    private ?object $sessionizer = null;

    /** Set once the sessionizer has failed, so the warning is not repeated per line. */
    private bool $sessionizerWarned = false;

    private ?object $geo = null;
    private ?object $asn = null;
    private ?object $solr = null;

    /** The `hits` core to write into. */
    private string $hitsCore;

    /** Whether the Ua enricher class is present (Parser normally applies it already). */
    private bool $haveUa = false;

    /**
     * Write a document for a sub-resource request at all?
     *
     * Off by default, which is a deliberate change of default rather than a new option nobody
     * will find. See indexes() for the whole argument.
     */
    private bool $indexAssets = false;

    /** Traffic this installation refuses to record at all. Read once, applied per line. */
    private Exclusions $exclusions;

    public function __construct(Config $cfg, bool $dryRun, bool $verbose, ?object $state = null)
    {
        $this->cfg      = $cfg;
        $this->dryRun   = $dryRun;
        $this->verbose  = $verbose;
        $this->hitsCore = (string) $cfg->get('solr.hits_core', 'loghound_hits');
        $this->indexAssets = (bool) $cfg->get('ingest.index_assets', false);
        $this->exclusions = Exclusions::fromConfig($cfg);

        $this->initParser();
        $this->initEnrichers($state);
        $this->initSessionizer($state);
        $this->initSolr();
    }

    /**
     * Resolve the normaliser.
     *
     * Parser turns a RAW record (remote_addr, request, status, header_in.user-agent, ...)
     * into the Solr field names of SPEC §4.1. Without it there is no `hits` document to
     * write, so real ingestion refuses to start; --dry-run is allowed to continue with
     * LogFormat alone, because "does this format match my log?" is a useful question to
     * answer on its own.
     *
     * Parser is given the privacy mode, the salt and the raw-retention toggle, because those
     * decide what the document is allowed to contain and therefore belong at parse time rather
     * than being stripped out afterwards. The search-parameter whitelist is there for the same
     * reason and is the same list the beacon collector applies: a term that is not to be kept
     * must never be written, not written and filtered later.
     *
     * The installation id is there because a pair of indexes may be shared by several
     * installations: it goes into the hit id, where it stops two machines tailing identically
     * named log files from overwriting each other's documents, and onto the document as
     * `install_s`. Parser::normalize() carries the full reasoning.
     *
     * `own_host` and `own_paths` are this panel's own beacon script and collector, derived from
     * `base_url` by Config::selfEndpoints(). Without them the parser cannot tell Loghound's
     * instrumentation from the traffic it measures, and every request the beacon makes is
     * counted as a page the visitor asked for — which is what put `/collect.php` and `/b.js` at
     * the top of Overview's Top pages. They are handed over here, at construction, because they
     * are a property of the installation; the per-source vhost is not, and arrives through
     * setSourceHost() one line before each parse.
     */
    private function initParser(): void
    {
        if (class_exists('\\Loghound\\Parser')) {
            $own = \Loghound\Config::selfEndpoints((string) $this->cfg->get('base_url', ''));

            $this->parser = new \Loghound\Parser([
                'ip_mode'       => (string) $this->cfg->get('privacy.ip_mode', 'full'),
                'ip_salt'       => (string) $this->cfg->get('privacy.ip_salt', ''),
                'keep_raw'      => (bool) $this->cfg->get('ingest.keep_raw', true),
                'search_params' => (array) $this->cfg->get('beacon.query_params', []),
                'install_id'    => (string) $this->cfg->get('solr.install_id', ''),
                'own_host'      => (string) $own['host'],
                'own_paths'     => (array) $own['paths'],
            ]);
            return;
        }

        if (!class_exists('\\Loghound\\LogFormat')) {
            throw new \RuntimeException(
                'Neither \\Loghound\\Parser nor \\Loghound\\LogFormat is available; '
                . 'nothing can be ingested.'
            );
        }

        if (!$this->dryRun) {
            throw new \RuntimeException(
                '\\Loghound\\Parser is not available. LogFormat alone yields raw field names, '
                . 'not the normalised hit document the `hits` core expects. Use --dry-run to '
                . 'test log parsing without indexing.'
            );
        }

        $this->rawOnly = true;
        logLine('warn', '\Loghound\Parser is not available; --dry-run is checking '
            . 'parseability with LogFormat only, and the records are RAW fields.');
    }

    /**
     * Instantiate the enrichers that are present.
     *
     * All three are optional by design (SPEC §5.3): a geo endpoint that is down, a whois
     * server that rate-limits us, a DNS resolver that times out — none of those is a
     * reason to lose a request. The field is simply absent from the document.
     *
     * The UA flag is not one of the three: Parser already folds Ua::parse()->fields() into the
     * document, and the flag exists only so that the raw-only dry-run path can still classify
     * a User-Agent.
     */
    private function initEnrichers(?object $state): void
    {
        $enrichCfg = (array) $this->cfg->get('enrich', []);

        if (class_exists('\\Loghound\\Enrich\\Geo')) {
            try {
                $this->geo = new \Loghound\Enrich\Geo(
                    $enrichCfg,
                    $state,
                    (array) $this->cfg->get('opensolr', [])
                );
            } catch (\Throwable $e) {
                logLine('warn', 'Geo enrichment unavailable: ' . $e->getMessage());
            }
        }
        if (class_exists('\\Loghound\\Enrich\\Asn')) {
            try {
                $this->asn = new \Loghound\Enrich\Asn($enrichCfg, $state);
            } catch (\Throwable $e) {
                logLine('warn', 'ASN enrichment unavailable: ' . $e->getMessage());
            }
        }
        $this->haveUa = class_exists('\\Loghound\\Enrich\\Ua');
    }

    /** Instantiate the sessionizer when both it and the shared State are available. */
    private function initSessionizer(?object $state): void
    {
        if (!class_exists('\\Loghound\\Sessionizer') || $state === null) {
            return;
        }
        try {
            $this->sessionizer = new \Loghound\Sessionizer($state, (array) $this->cfg->all());
        } catch (\Throwable $e) {
            logLine('warn', 'Sessionizer unavailable: ' . $e->getMessage());
        }
    }

    /** Connect to Solr unless we are in --dry-run. */
    private function initSolr(): void
    {
        if ($this->dryRun) {
            return;
        }
        if (!class_exists('\\Loghound\\Solr')) {
            throw new \RuntimeException('\\Loghound\\Solr is not available; run with --dry-run to parse only.');
        }
        $this->solr = new \Loghound\Solr((array) $this->cfg->get('solr', []));
    }

    /**
     * Resolve a source's format string or library name to a compiled LogFormat.
     *
     * Cached per name: compiling a twenty-column Apache LogFormat into a regex is not
     * free, and every line of a busy log asks for the same one.
     *
     * A library name is tried first ('apache_combined', 'nginx_combined', ...). Otherwise the
     * value is the operator's own LogFormat string, copied out of their webserver config by
     * the setup wizard, and an nginx format is recognisable by its $variables.
     *
     * A delimited PCRE is recognised before either of those, because it is neither: it is
     * SPEC §8 step 4, the custom-pattern escape hatch, and setup stores the pattern itself as
     * the format. Compiled through LogDetect::formatFromRegex() so that it goes through the
     * same ReDoS vetting and the same group-name translation the review screen used — a
     * source that parsed during setup has to parse identically here, or the operator
     * confirmed one thing and got another.
     */
    private function format(string $name): ?object
    {
        if (array_key_exists($name, $this->formats)) {
            return $this->formats[$name];
        }

        $fmt = null;
        try {
            $fmt = \Loghound\LogDetect::formatByName($name);
            if ($fmt === null && \Loghound\LogFormat::isDelimitedRegex($name)) {
                $fmt = \Loghound\LogDetect::formatFromRegex($name, 'source');
                if ($fmt === null) {
                    logLine('error', 'custom pattern refused (no named groups, or it backtracks): '
                        . substr($name, 0, 80));
                }
            } elseif ($fmt === null) {
                $fmt = str_contains($name, '$')
                    ? \Loghound\LogFormat::fromNginx($name, 'source')
                    : \Loghound\LogFormat::fromApache($name, 'source');
            }
        } catch (\Throwable $e) {
            logLine('error', 'cannot compile format "' . substr($name, 0, 80) . '": ' . $e->getMessage());
        }

        $this->formats[$name] = $fmt;
        return $fmt;
    }

    /**
     * Turn one raw log line into a `hits` document, or null when it cannot be parsed.
     *
     * PARSE. Parser owns the id — sha1 of src plus offset, which is what makes a re-ingest
     * idempotent — the privacy transform, the kind/asset classification and the header-derived
     * fields. A parser that throws on a hostile line is a parse failure, not a crash. Under
     * --dry-run without Parser the step proves the format matches and nothing more. The vhost
     * is filled in here when the log format does not carry %v and the operator told setup which
     * site the file belongs to.
     *
     * THE VHOST IS HANDED OVER BEFORE THE PARSE, NOT AFTER IT. It used to be applied further
     * down, once the document already existed, which is too late for any decision that has to
     * know which site the request was made to — and the own-endpoint test is one, because
     * excluding Loghound's beacon on a path match alone would delete a measured site's real
     * `/collect.php` from its own analytics. The post-hoc fill below stays as the backstop for a
     * hit whose format yielded no host at all.
     *
     * ENRICH. SPEC §5.3: enrichment failure NEVER blocks indexing. Every lookup is wrapped,
     * every result is merged only where it adds a key, and a miss leaves the field ABSENT
     * rather than empty — "" and "not known" are different facts, and conflating them poisons
     * every facet built on the field.
     *
     * SESSIONIZE. Sessionizer::assign() requires `_ts_unix`, a private transport-only field
     * that Parser does not emit, since Parser gives `ts` as the ISO-8601 string Solr wants. It
     * is derived from that rather than from time(), and the difference matters: replaying a
     * historical log must produce the sessions it would have produced live, and time() would
     * collapse a week of traffic into one session in the present. A sessionisation failure is
     * never fatal — a hit without session_id_s is still a valid `hits` document and
     * loghound-score can group it later, whereas losing the request entirely would be much
     * worse. It is logged ONCE rather than per line: a systematic failure, a signature mismatch
     * or a missing table, applies to every line in the file, and repeating it a thousand times
     * a second would bury everything else in the journal and cost more than the ingestion.
     *
     * STRIP. Anything with a leading underscore is an internal handoff between pipeline stages
     * (`_ts_unix`, and whatever future stages add) and must never reach Solr: the schema does
     * not define these, so at best they are silently ignored and at worst a dynamic-field rule
     * catches them and quietly doubles the index. An absent header stays ABSENT and never
     * becomes an empty string (SPEC §4.1), for the same reason as above.
     *
     * @param array<string,mixed> $meta Source descriptor: src, format, host.
     * @return array<string,mixed>|null
     */
    /**
     * Does this document belong in the `hits` index at all?
     *
     * ------------------------------------------------------------------------------------
     * IMAGES, STYLESHEETS, SCRIPTS AND FONTS ARE NOT STORED
     * ------------------------------------------------------------------------------------
     * `/img/solr6.PNG` and a jQuery UI `animated-overlay.gif` were appearing in a list headed
     * "Top pages". That is the visible half. The invisible half is the cost: on an ordinary
     * site sub-resources are the large majority of all log lines, so the index was mostly
     * pictures — paid for in disk, in the quota Loghound has to keep itself inside, and in
     * every facet's term dictionary — to answer questions nobody asks about a font file.
     *
     * "THE REST" MEANS EVERY SUB-RESOURCE, which is `kind_s` of `asset` or `favicon`. Parser's
     * own table decides what that covers and it is the right place for it to be decided:
     * images, css, js, fonts, media, and source maps. A favicon is included because it is
     * fetched by the browser unprompted and is a sub-resource by every definition that matters
     * here. Deliberately NOT included: `api`, `robots`, `other` and `html`, all of which are
     * things a client asked this site for on purpose, and `beacon`, which is kept for the
     * reason Sessionizer::accumulateSelf() spells out — "is my beacon reaching the collector?"
     * is the first question every new installation has, and it becomes unanswerable the moment
     * those lines are thrown away.
     *
     * ------------------------------------------------------------------------------------
     * WHAT THIS MUST NOT BREAK, AND DOES NOT
     * ------------------------------------------------------------------------------------
     * The asset ratio is an INPUT TO THE SCORING RULES: a session that fetched no sub-resources
     * is the `no_assets` signal, and it is also one of the four ways a session proves it ran a
     * renderer at all (Score\Rules::hadTestableEvidence). Dropping these lines at PARSE time
     * would therefore have turned every visitor into a client that fetched nothing — inventing
     * a bot signal out of a storage decision, which is the worst class of defect this codebase
     * recognises.
     *
     * So the drop happens at the INDEX boundary and nowhere earlier. The caller runs the whole
     * pipeline first — parse, enrich, attack-match, sessionise — and consults this afterwards.
     * Every session counter is computed from the complete traffic; only the document is
     * refused. The one number that legitimately changes is what a hits-core path facet can see,
     * and that is the change being asked for.
     *
     * ------------------------------------------------------------------------------------
     * IT IS A SETTING, AND THE DEFAULT IS OFF
     * ------------------------------------------------------------------------------------
     * `ingest.index_assets`. An operator debugging a CDN, or one who genuinely wants per-image
     * latency on the Performance view, turns it on and pays for it knowingly. Nothing else in
     * the panel reads the flag: a card that would have shown assets simply has none, which is
     * the honest outcome, rather than a card that claims to be complete and is not.
     *
     * @param array<string,mixed> $doc A document as process() returned it.
     */
    public function indexes(array $doc): bool
    {
        if ($this->indexAssets) {
            return true;
        }
        $kind = (string) ($doc['kind_s'] ?? '');

        return $kind !== 'asset' && $kind !== 'favicon';
    }

    /**
     * Did the LAST process() call return null because the line was REFUSED rather than unparsed?
     *
     * A refusal and a parse failure both return null, and for a long time both were counted as
     * `parse_errors` and sampled into badlines.log. That made the exclusion rules and the
     * loopback filter look like a parsing fault: on this installation a third of all lines are
     * 127.0.0.1, so the counter read "677 parse errors" while the format was working perfectly
     * and the operator's own filters were doing exactly what they were told. A number that
     * indicts the parser for the operator's own configuration is worse than no number.
     */
    public function refusedLast(): bool
    {
        return $this->refused;
    }

    /** Set by process() when it refuses a line; read by refusedLast(). */
    private bool $refused = false;

    public function process(string $line, int $offset, string $src, array $meta): ?array
    {
        $this->refused = false;

        $fmt = $this->format((string) ($meta['format'] ?? 'apache_combined'));
        if ($fmt === null) {
            return null;
        }

        if ($this->rawOnly) {
            $raw = $fmt->parse($line);
            return is_array($raw) && $raw !== [] ? $raw : null;
        }

        $this->parser->setSourceHost(isset($meta['host']) ? (string) $meta['host'] : null);

        try {
            $hit = $this->parser->parseLine($fmt, $line, $src, $offset);
        } catch (\Throwable $e) {
            return null;
        }

        if (!is_array($hit) || $hit === []) {
            return null;
        }

        if (!isset($hit['host_s']) && !empty($meta['host'])) {
            $hit['host_s'] = $meta['host'];
        }

        /* AFTER THE PARSE, BEFORE THE ENRICHMENT, and both halves matter. The fields a rule
           tests only exist once the line is parsed; and refusing here means an excluded
           request never reaches geolocation, ASN, rDNS, the sessionizer or the batch, so it
           costs one preg_match and nothing else. Returning null is the same path a malformed
           line takes, which is exactly right: as far as everything downstream is concerned,
           this line was never read. */
        if (!$this->exclusions->isEmpty() && $this->exclusions->excludesHit($hit)) {
            $this->refused = true;
            return null;
        }

        if (Security::isPrivateAddress((string) ($hit['ip_net_s'] ?? ($hit['ip_s'] ?? '')))) {
            $this->refused = true;
            return null;
        }

        $ip = (string) ($hit['ip_s'] ?? '');
        if ($ip !== '') {
            if ($this->geo !== null) {
                $hit = $this->merge($hit, $this->safeLookup($this->geo, 'lookup', $ip, 'geo'));
            }
            if ($this->asn !== null) {
                $hit = $this->merge($hit, $this->safeLookup($this->asn, 'lookup', $ip, 'asn'));
                if ($this->cfg->get('enrich.rdns_enabled', true)) {
                    $hit = $this->merge($hit, $this->safeLookup($this->asn, 'rdns', $ip, 'rdns'));
                }
            }
        }

        /* AFTER ENRICHMENT AND BEFORE THE SESSIONIZER, and both halves of that are load-bearing.
           The crawler-impersonation rule reads `rdns_s`, which the ASN enricher has only just
           set, so running this inside Parser::normalize() would make that rule permanently
           silent. And Sessionizer::accumulate() folds `hit_flags_ss` up into the session, so it
           has to exist by the time the hit reaches it or the session half of the Attacks view
           would be empty on every document.

           Guarded by class_exists for the same reason the enrichers are: a partial deployment
           must degrade to "no attack flags" rather than to "no ingest at all". */
        if (class_exists('\\Loghound\\Score\\Attacks')) {
            $hit = \Loghound\Score\Attacks::apply($hit);
        }

        if ($this->sessionizer !== null) {
            try {
                /* MILLISECONDS, NOT strtotime(). This handed the sessionizer `_ts_unix`, which is
                   WHOLE SECONDS, and Sessionizer::hitMillis() prefers that key over the exact
                   conversion — so on the real ingest path every instant was truncated to the
                   second before it ever reached a session. `ts` carries milliseconds (Parser
                   formats it `.v`), and several supported formats really do log them: HAProxy's
                   `10/Sep/2026:09:57:08.123`, Apache's %{msec}t and %{usec}t, nginx's $msec, and
                   any ISO-8601 with a fraction.

                   The damage was not cosmetic. log_span_ms_l became a multiple of 1000 on every
                   session on every installation, so a visit of 400 ms measured 0 and read as
                   "they were here for no time at all"; and the inter-request GAPS feeding
                   Signals::isPeriodic() were quantised to whole seconds, which is the difference
                   between a burst of sub-second sub-resource fetches and a one-second schedule —
                   the exact distinction that rule's median-gap floor exists to make.

                   Parser::epochMs() is the conversion that keeps the fraction, and it is already
                   the fallback hitMillis() uses when no override is present. Setting `_ts_ms`
                   rather than removing the line keeps this stage explicit about the instant it
                   is handing over; `_ts_unix` stays supported for a replay tool that has only a
                   Unix time to give. */
                if (!isset($hit['_ts_ms'], $hit['_ts_unix']) && isset($hit['ts'])) {
                    $ms = \Loghound\Parser::epochMs((string) $hit['ts']);
                    if ($ms > 0) {
                        $hit['_ts_ms'] = $ms;
                    }
                }

                $out = $this->sessionizer->assign($hit);
                if (is_array($out) && $out !== []) {
                    $hit = $out;
                }
            } catch (\Throwable $e) {
                if (!$this->sessionizerWarned) {
                    $this->sessionizerWarned = true;
                    logLine('warn', 'Sessionizer failed and is being skipped for this run: '
                        . $e->getMessage() . ' — hits are still indexed, without session_id_s.');
                }
            }
        }

        foreach (array_keys($hit) as $k) {
            if (is_string($k) && $k !== '' && $k[0] === '_') {
                unset($hit[$k]);
            }
        }

        foreach ($hit as $k => $v) {
            if ($v === '' || $v === null) {
                unset($hit[$k]);
            }
        }

        return $hit;
    }

    /**
     * Run one enrichment lookup, swallowing any failure.
     *
     * The privacy mode matters here: in `hash` mode ip_s is not an address at all, so an
     * enricher would be looking up a hash. Parser keeps the routable address available
     * for enrichment under a separate key when it can; when it cannot, the lookup simply
     * returns nothing and the field is absent, which is the honest outcome.
     *
     * @return array<string,mixed>
     */
    private function safeLookup(object $obj, string $method, string $ip, string $what): array
    {
        try {
            $r = $obj->{$method}($ip);
            return is_array($r) ? $r : [];
        } catch (\Throwable $e) {
            if ($this->verbose) {
                logLine('warn', $what . ' lookup failed for ' . $ip . ': ' . $e->getMessage());
            }
            return [];
        }
    }

    /**
     * Merge enrichment output into a hit without ever overwriting what the log said.
     *
     * SPEC §6.4: where a log line and anything else disagree, the log wins on facts. An
     * enricher may only ADD fields, never correct one.
     *
     * @param array<string,mixed> $hit
     * @param array<string,mixed> $add
     * @return array<string,mixed>
     */
    private function merge(array $hit, array $add): array
    {
        foreach ($add as $k => $v) {
            if ($v === null || $v === '' || array_key_exists($k, $hit)) {
                continue;
            }
            $hit[$k] = $v;
        }
        return $hit;
    }

    /**
     * Push a batch of documents into the `hits` core.
     *
     * softCommit only. Hard commits are left to the core's autoCommit
     * (maxTime=60000, openSearcher=false) exactly as SPEC §5.5 requires: a hard commit
     * per batch would open a new searcher every two seconds and destroy throughput for
     * no benefit at all.
     *
     * Solr answers 200 with an error body more often than people expect, so a non-ok response
     * is treated as a failure and counted and logged rather than assumed to have worked.
     *
     * @param array<int,array<string,mixed>> $docs
     */
    /**
     * The Solr client, or null under --dry-run.
     *
     * Exposed for exactly one caller: the plan-quota guard, which has to run a bounds facet
     * and a delete-by-query against the same node this pipeline writes to. Handing out the
     * client rather than adding a trim method here keeps the deletion logic in
     * \Loghound\Quota, where it is unit-tested against a fake, instead of inside a daemon.
     */
    public function solr(): ?object
    {
        return $this->solr;
    }

    public function index(array $docs): void
    {
        if ($this->dryRun || $this->solr === null) {
            return;
        }
        $res = $this->solr->addDocs($this->hitsCore, $docs, true);
        if (is_array($res) && isset($res['ok']) && $res['ok'] === false) {
            throw new \RuntimeException((string) ($res['error'] ?? 'Solr rejected the batch'));
        }
    }
}
