# ===========================================================================
# SECRETS — never commit. This repository is public.
# ===========================================================================
# The live configuration holds the Opensolr API key, the beacon HMAC secret,
# the panel password hash and the IP-anonymisation salt. Only the example file,
# which contains placeholders, belongs in version control.
config/loghound.php
config/*.php
!config/loghound.example.php

# The installer's proof-of-filesystem-access token. Anyone holding this during
# the window before setup completes can point a fresh install at their own
# backend.
var/install-token
**/install-token
*install-token*

# TLS material: generated by install.sh for a self-signed setup, or dropped next
# to the config by an operator. A private key in a public repository is the
# fastest way to lose a domain.
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore

# Credential and environment files in every spelling people actually use.
.env
.env.*
*.env
.netrc
.pgpass
.htpasswd
credentials
credentials.*
secrets.json
secrets.yml
secrets.yaml
secrets.php
secrets.txt
*.secret
auth.json

# NOTE: deliberately NOT a broad "*secret*" glob. That matches source files whose
# names merely describe the subject — tests/test_secrets.php and
# tests/scan-secrets.php are the tooling that PREVENTS leaks, and excluding them
# would quietly remove the safety net from the repository. Match credential
# FILES by their conventional names, not by any appearance of the word.

# SSH and cloud provider material.
id_rsa*
id_ecdsa*
id_ed25519*
id_dsa*
*.ppk
.aws/
.ssh/
*.gpg
*.asc

# ===========================================================================
# RUNTIME STATE — machine-specific, and full of other people's personal data
# ===========================================================================
# var/ holds the SQLite state database (tail offsets, open sessions, staged
# beacon payloads, geo and ASN caches), PHP session files, and sampled
# unparseable log lines. Every one of those contains visitor data.
var/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs of any kind. badlines.log in particular holds raw captured requests.
*.log
logs/
!tests/fixtures/*.log

# Database dumps and archives, which is how visitor data usually escapes.
*.sql
*.sql.gz
*.dump
*.bak
*.old
*.orig
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
backup/
backups/

# ===========================================================================
# Local development artefacts
# ===========================================================================
tools/panel-preview-config.php
/tmp/
tmp/
scratch/
scratchpad/
.phpunit.result.cache

# ===========================================================================
# Editor and OS noise
# ===========================================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.rej
.idea/
.vscode/
.fleet/
nbproject/
.project
.settings/

# ===========================================================================
# Dependencies this project deliberately does not use
# ===========================================================================
# Loghound has no Composer or npm dependencies on purpose: `git clone` plus
# install.sh must work on a bare box with no toolchain. These entries exist so
# a stray local experiment cannot be committed and imply otherwise.
vendor/
node_modules/
composer.lock
package-lock.json
yarn.lock

# ===========================================================================
# NOTE ON tests/fixtures/*.log
# ===========================================================================
# Those two files are deliberately tracked and are re-allowed above. They hold
# real captured production requests and were sanitised before being committed:
# visitor IP addresses in the human fixture are pseudonymised, and every
# credential-bearing query parameter (api_key, email, session identifiers) was
# redacted. The bot fixture keeps its real addresses on purpose — those hosts
# are scrapers and the netblock is the evidence.
#
# If you add a new fixture, sanitise it the same way BEFORE committing, and
# check it with: php tests/scan-secrets.php
